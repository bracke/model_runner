with "config/model_runner_config.gpr";

project Model_Runner is
   --  One body per host for the parts that exist only because operating
   --  systems differ, selected the way hostkit selects its own. Everything
   --  else is portable Ada and lives in src/library.
   case Model_Runner_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use
           ("src/library", "src/main", "src/platform/windows", "config");
      when "linux" | "macos" =>
         for Source_Dirs use
           ("src/library", "src/main", "src/platform/posix", "config");
      when others =>
         for Source_Dirs use
           ("src/library", "src/main", "src/platform/unsupported", "config");
   end case;
   for Object_Dir use "obj/" & Model_Runner_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("model_runner_main.adb");
   for Languages use ("Ada");

   --  The root library package is named Model_Runner, so the main subprogram
   --  cannot be. It is renamed to the published executable name here.
   package Builder is
      for Executable ("model_runner_main.adb") use "model_runner";
   end Builder;

   package Compiler is
      --  The build profile's switches come first, then this project's own.
      --  Leaving them out, as this did, silently discards the optimization
      --  level: every profile compiled at -O0, so measurements comparing
      --  profiles compared nothing.
      for Default_Switches ("Ada") use
        Model_Runner_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-g",
           --  This project documents a 120 column limit; the
           --  generated profile would otherwise impose 79.
           "-gnatyM120");
   end Compiler;

   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- a Danish label, a pseudo-locale bracket,
   --  a token the model produced -- came out doubled. -Wb is the compiler
   --  default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts ("share/model_runner") use ("resources/messages");
   end Install;
end Model_Runner;
