# Any repository, whatever it is written in. Records what the files at
# its top say about it and asks nothing it can find out.
template = generic
name = Any Language
description = A project in any language, new or already there, checked by a command of its own.
version = 1
category = any
includes = standard-development

# Writing into a repository that is already there is confirmed first, the
# plan shown above the question.
scalar init.confirm = yes

input project_name
  type = text
  label = Project name
  description = what the project is called
  required = true
  default = ${directory_name}

discover .git fact vcs = git
discover alire.toml fact build_system = Alire
discover Makefile fact build_system = Make
discover CMakeLists.txt fact build_system = CMake
discover Cargo.toml fact build_system = Cargo
discover package.json fact build_system = npm
discover pyproject.toml fact build_system = Python
discover go.mod fact build_system = Go
discover pom.xml fact build_system = Maven

# How the repository is checked: found from its build system where there is
# one, asked for where there is not. Its program is the one checks may run.
input check_command
  type = text
  label = Check command
  description = the command that builds and tests it, as make test, pytest or npm test -- true where there is nothing to check yet
  required = true
  default = true

# The program checks may run: the one the command starts, unless named.
input check_program
  type = text
  label = Check program
  description = the program the check command runs, which checks may run
  required = true
  default = ${check_command.program}

discover *.gpr input check_command = gprbuild
discover alire.toml input check_command = alr build
discover Makefile input check_command = make test
discover CMakeLists.txt input check_command = ctest --test-dir build
discover Cargo.toml input check_command = cargo test
discover package.json input check_command = npm test
discover pyproject.toml input check_command = python3 -m pytest
discover setup.py input check_command = python3 -m pytest
discover requirements.txt input check_command = python3 -m pytest
discover go.mod input check_command = go test ./...
discover pom.xml input check_command = mvn test

profile checks = check: ${check_command}
scalar profile_capability.checks = run_tests
scalar verification.default = checks
set execution.allowed = ${check_program}
