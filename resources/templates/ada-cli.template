# An Ada program run from the command line.
template = ada-cli
name = Ada CLI Application
description = A command-line program in Ada, built with Alire and tested with AUnit.
version = 1
category = application
language = Ada
tags = ada, cli
includes = ada, alire, aunit, standard-development

input project_name
  type = crate
  label = Project name
  description = the program's name, which is its main procedure's too
  required = true
  default = ${directory_name}

scalar project.kind = executable
file alire.toml = name = "${project_name}"\ndescription = ""\nversion = "0.1.0-dev"\n\nexecutables = ["${project_name}"]\n
file src/${project_name}.adb = procedure ${project_name.ada} is\nbegin\n   null;\nend ${project_name.ada};\n
file ${project_name}.gpr = project ${project_name} is\n   for Source_Dirs use ("src/");\n   for Object_Dir use "obj/";\n   for Exec_Dir use "bin";\n   for Main use ("${project_name}.adb");\n   for Create_Missing_Dirs use "True";\nend ${project_name};\n
