# The kinds of task every project here works with, for a template to
# include. Each lists the fields it requires; a ? marks one it allows.
template = standard-development
name = Standard Development
description = Implementation, bugfix, test, documentation and analysis tasks.
version = 1
category = process

task_kind implementation = component, requirements?, notes?
task_kind bugfix = component?, requirements?, notes?, reproduction?
task_kind test = component?, requirements?, notes?
task_kind documentation = component?, notes?
task_kind analysis = component?, notes?, question?
scalar task.derived_kind = implementation

# Where the project's files are: what a scan leaves out, and what is a test
# or documentation. A name is a directory at any depth, a path is one place,
# and *text is part of a file's name.
set repository.skip = obj bin lib alire node_modules target build _build
set repository.tests = test tests testsuite *_test.
set repository.documentation = doc docs

# What bootstrap reads, what it may make of it, and whether an item a
# document gives its own identifier is accepted as the document says or
# only proposed.
set bootstrap.sources = *.md
set bootstrap.sources = docs/*.md
set bootstrap.propose = facts, imports, requirements, decisions, specifications, issues
scalar bootstrap.import = accepted

# What any work here is held to where nothing the project says speaks to it.
baseline project.tests = a change in behaviour comes with a test that shows it
baseline project.documentation = a change in what a user sees changes what the user reads
baseline project.scope = work changes only what its task is about

# Where agents write: in the project itself, or each in a workspace of its
# own taken in by integration -- which is what lets two work at once.
input work_isolation
  type = choice
  label = Work isolation
  description = project to write in the project itself; workspace for a workspace per task, taken in by task integrate
  choices = project, workspace
  default = project
scalar work.isolation = ${work_isolation}
