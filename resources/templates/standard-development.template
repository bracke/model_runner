# The kinds of task every project here works with, for a template to
# include. Each lists the fields it requires; a ? marks one it allows.
template = standard-development
name = Standard Development
description = Implementation, bugfix, test, documentation and analysis tasks.
version = 1
category = process
standalone = false

task_kind implementation = component, requirements?, notes?
task_kind bugfix = component?, requirements?, notes?, reproduction?
task_kind test = component?, requirements?, notes?
task_kind documentation = component?, notes?
task_kind analysis = component?, notes?, question?

# What completes a task of each kind: work that changes code or tests is
# complete only when it changed something.
set task.gates.implementation = verification
set task.gates.implementation = children
set task.gates.implementation = no_blocking_issue
set task.gates.implementation = integration
set task.gates.implementation = implementation_present
set task.gates.bugfix = verification
set task.gates.bugfix = children
set task.gates.bugfix = no_blocking_issue
set task.gates.bugfix = integration
set task.gates.bugfix = implementation_present
set task.gates.test = verification
set task.gates.test = children
set task.gates.test = no_blocking_issue
set task.gates.test = integration
set task.gates.test = implementation_present

# What an agent may do, by kind, within the project's least: analysis reads
# and checks, documentation writes documents, tests write tests.
map permission.kind.analysis.read_source =
map permission.kind.analysis.read_specs =
map permission.kind.analysis.run_build =
map permission.kind.analysis.run_tests =
map permission.kind.analysis.run_static_analysis =
map permission.kind.analysis.propose_tasks =
map permission.kind.documentation.read_source =
map permission.kind.documentation.read_specs =
map permission.kind.documentation.write_source = roots=docs/|doc/|README.md|README
map permission.kind.documentation.write_specs = roots=docs/|doc/
map permission.kind.documentation.propose_tasks =
map permission.kind.test.read_source =
map permission.kind.test.read_specs =
map permission.kind.test.write_source = roots=tests/|test/
map permission.kind.test.run_build =
map permission.kind.test.run_tests =
map permission.kind.test.propose_tasks =

# The fields of its own a kind lists, each with what it is: text, number,
# identifier, path, list, or choice A|B|C.
map task_field.reproduction = text
map task_field.question = text
scalar task.derived_kind = implementation

# Where the project's files are: what a scan leaves out, and what is a test
# or documentation, and what a tool generates. A name is a directory at any
# depth, a path is one place, and *text is part of a file's name.
set repository.skip = obj bin alire node_modules target build _build *.ali/ *.o/ *.a/ *.so/
set repository.tests = test tests testsuite *_test.
set repository.documentation = doc docs
set repository.generated = generated *.pb.go *_pb2.py *.pb.h *.pb.cc

# What bootstrap reads, what it may make of it, and whether an item a
# document gives its own identifier is accepted as the document says or
# only proposed.
set bootstrap.sources = *.md
set bootstrap.sources = docs/**/*.md
set bootstrap.sources = docs/**/*.txt
set bootstrap.sources = docs/**/*.rst
set bootstrap.sources = docs/**/*.adoc
set bootstrap.sources = *.rst
set bootstrap.sources = *.adoc
set bootstrap.propose = facts, imports, requirements, decisions, specifications, issues
scalar bootstrap.import = accepted

# What any work here is held to where nothing the project says speaks to it.
baseline project.tests = a change in behaviour comes with a test that shows it
baseline project.documentation = a change in what a user sees changes what the user reads
baseline project.scope = work changes only what its task is about

# Where agents write: in the project itself, or each in a workspace of its
# own taken in by integration -- which is what lets two work at once.
input work_isolation
  type = choice
  label = Work isolation
  description = project to write in the project itself; workspace for a workspace per task, taken in by /task integrate
  choices = project, workspace
  default = project
scalar work.isolation = ${work_isolation}
