# Building with Alire, for a template to include.
template = alire
name = Alire
description = Builds with the Alire package manager.
version = 1
category = build
standalone = false
tags = alire

fact build_system = Alire
adapter build = alire
scalar build.command = alr build
profile build = build: alr build
scalar profile_capability.build = run_build

# Static analysis, the harness's to run: the compiler's every warning, as an
# error. A formatter or a generator is a profile named by scalar
# stage.format or stage.generate, run after an agent's work and before it is
# verified -- none is assumed installed.
profile analysis = analysis: alr -n build -- -cargs -gnatwa -gnatwe
scalar profile_capability.analysis = run_static_analysis

# What any task is verified by, unless its kind names its own.
scalar verification.default = build
set execution.allowed = alr
discover alire.toml fact build_system = Alire
