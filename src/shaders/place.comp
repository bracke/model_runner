#version 450

//  A step's result, written into the cache the device holds.
//
//  The keys and the values a layer produced belong in the cache before
//  anything attends to them, and until now the host put them there: it read
//  them back, copied them into its own arrays, and copied them again into
//  the mapping the device reads. The copy is cheap -- a standing mapping and
//  no call to the driver -- and the round trip is not, because it is what
//  makes a layer two submissions instead of one.
//
//  Written here, the keys never leave the device between the projection that
//  made them and the attention that reads them. The host still gets its own
//  copy, because a session that later runs on the processor needs one; what
//  it no longer does is stand between two halves of a layer.
//
//  A workgroup a position, its lanes over the row.

const uint LANES = 256u;

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = LANES) in;

//  The cache again, read-only. It is bound here because a step's descriptor
//  set carries four and this kernel wanted two, so binding zero was the
//  cache and unread. Read
//  through this one rather than through the writable view below, because a
//  buffer that one declaration writes and another reads is a buffer two
//  declarations disagree about.
layout(std430, binding = 0) readonly  buffer Kept   { float kept[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) writeonly buffer Cache  { float kv[]; };

//  The cache's half-precision copy, which the matrix attention kernel
//  reads: a buffer of its own rather than the back of the cache, so that
//  neither it nor the cache proper is past what one storage buffer may
//  hold. The cache is kept twice, once as it has always been kept and
//  once in half precision beside it.
layout(std430, binding = 5) writeonly buffer Halves { float16_t kvh[]; };

layout(push_constant) uniform Shape {
    //  Elements a position holds.
    uint width;

    //  How far apart one position is from the next in the cache, which is
    //  every head's worth of keys or of values and not just this layer's.
    uint stride;

    //  Positions in this batch.
    uint count;

    //  Where the first of them goes, in elements.
    uint at_first;

    //  One where the cache's half-precision copy is there to write, and
    //  nought where it is not: a device with neither the matrix
    //  instruction nor the halved attention has no copy, nothing would
    //  ever read one, and the binding a copy would be at holds something
    //  else that a write here would put a hole in.
    uint halves;

    //  Where the half-precision copy begins, in halves of its own
    //  buffer, which is nought: a word the engine still pushes and this
    //  kernel still adds, so that a copy somewhere else is a change in
    //  one place.
    uint half_base;

    //  Bound but unread here: the products put a folded join in this word.
    uint unused_joins;

    //  Reserved, always zero: the products keep the word for layout.
    uint table_at;

    //  A cache in pages rather than in blocks, as attention.comp reads
    //  it: a page is page_shift's power of two positions of one layer,
    //  and a row goes into its position's page at the layer's offset --
    //  at_first is that offset inside a page, and pages_at is where a
    //  batch's page table for this layer begins, a word a page. A
    //  Zero for page_shift is a cache in blocks.
    uint pages_at;
    uint page_shift;

    //  A batch in pages: which position of its session the first row is,
    //  which in blocks the caller folded into at_first.
    uint first_position;
} shape;

void main() {
    uint slot = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (slot >= shape.count) {
        return;
    }

    uint from = slot * shape.width;

    //  The first row's place and one stride a row after it. In pages, the
    //  row's position names a word of the page table and that page holds it.
    uint into;

    if (shape.page_shift == 0u) {
        into = shape.at_first + slot * shape.stride;
    } else {
        uint table = shape.pages_at;
        uint pos = shape.first_position + slot;

        into = floatBitsToUint (kept[table + (pos >> shape.page_shift)])
               + shape.at_first
               + (pos & ((1u << shape.page_shift) - 1u)) * shape.stride;
    }

    for (uint c = lane; c < shape.width; c += LANES) {
        float value = x[from + c];

        //  The binary32 cache, except where halves is two: that says the
        //  device keeps only the half-precision copy (a sinkless model at a
        //  context whose binary32 cache would not fit one storage buffer),
        //  so the copy below is written and this is not.
        if (shape.halves != 2u) {
            kv[into + c] = value;
        }

        if (shape.halves != 0u) {
            kvh[shape.half_base + into + c] = float16_t (value);
        }
    }
}
