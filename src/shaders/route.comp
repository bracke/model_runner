#version 450

//  A mixture's router, decided on the device.
//
//  A position's router scores, one an expert, become a distribution and
//  the largest few of it are chosen: which experts, and with what share
//  of the answer. Every mixture this program runs chooses that way -- a
//  softmax over every expert, the highest Used of them, and the chosen
//  shares put back on a scale where they sum to one -- and the host did
//  it between two submissions, which is what put a wait and a copy
//  between a layer's attention and its experts. Here it is one dispatch
//  between two others, and nothing leaves the device.
//
//  What is written is what the gathered products and the weighted sum
//  after them read: for each position, Used expert numbers and then Used
//  shares, as words, the shares by their bits. The order is the order of
//  choosing, largest first, which is the order the shares are summed in
//  and the reason the answer is the same sum of the same terms as the
//  host's.
//
//  A bias the architecture adds before it chooses is added here when the
//  push block says so, from the weight bound at nought.
//
//  A workgroup a position, a lane an expert. It was one invocation a
//  position doing the whole of it -- a hundred and twenty-eight
//  exponentials and a few hundred compares, which read as nothing beside
//  the products either side -- and the device's own clock said it was a
//  fifth of a layer: the scores lived in a private array of five hundred
//  and twelve, which is scratch memory, and every compare of the choosing
//  was a load from it. The scores live in shared memory now, the largest
//  and each choice are found by the lanes together, and the sums that
//  decide a share are still taken in the order the host takes them, so
//  the answer is the same bits as before.

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer Weight { float g[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) writeonly buffer Target { uint  r[]; };

layout(push_constant) uniform Shape {
    uint experts;
    uint used;
    uint count;
    uint first;
    uint packing;

    //  Where the bias begins in the weight buffer, in elements.
    uint base;

    //  Whether a bias is added before the choosing.
    uint joins;
} shape;

//  More than any mixture this program has been shown routes over.
const uint MOST = 512u;
const uint MAX_ROUTE = 64u;
const uint LANES = 128u;

shared float score[MOST];

//  A choice: the largest score and, among equal ones, the lowest expert,
//  which is the one the host's scan lands on.
shared float best_score[LANES];
shared uint  best_at[LANES];

//  What the lanes are told between the steps lane nought takes alone.
shared float largest;
shared float sum;
shared uint  chosen[MAX_ROUTE];
shared float share[MAX_ROUTE];

void main() {
    uint pos  = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (pos >= shape.count) {
        return;
    }

    uint experts = min(shape.experts, MOST);
    uint at = pos * shape.experts;

    //  The scores, biased where the architecture says, and each lane's
    //  largest of its own.
    float mine = -1.0 / 0.0;

    for (uint e = lane; e < experts; e += LANES) {
        float s = x[at + e];
        if (shape.joins != 0u) {
            s += g[shape.base + e];
        }
        score[e] = s;
        mine = max(mine, s);
    }

    best_score[lane] = mine;
    barrier();

    for (uint step = LANES / 2u; step > 0u; step >>= 1u) {
        if (lane < step) {
            best_score[lane] = max(best_score[lane], best_score[lane + step]);
        }
        barrier();
    }

    if (lane == 0u) {
        largest = best_score[0];
    }
    barrier();

    //  The exponentials, one a lane; their sum in the host's order, since
    //  a tree would give another last bit.
    for (uint e = lane; e < experts; e += LANES) {
        score[e] = exp(score[e] - largest);
    }
    barrier();

    if (lane == 0u) {
        float s = 0.0;
        for (uint e = 0u; e < experts; ++e) {
            s += score[e];
        }
        sum = s;
    }
    barrier();

    for (uint e = lane; e < experts; e += LANES) {
        score[e] = score[e] / sum;
    }
    barrier();

    //  The choosing: Used rounds, each the largest that is left, found by
    //  every lane over its own experts and then across the lanes.
    for (uint k = 0u; k < shape.used; ++k) {
        float most = -1.0;
        uint  best = 0u;

        for (uint e = lane; e < experts; e += LANES) {
            if (score[e] > most) {
                most = score[e];
                best = e;
            }
        }

        best_score[lane] = most;
        best_at[lane] = best;
        barrier();

        for (uint step = LANES / 2u; step > 0u; step >>= 1u) {
            if (lane < step) {
                float other = best_score[lane + step];
                uint  where = best_at[lane + step];
                if (other > best_score[lane]
                    || (other == best_score[lane] && where < best_at[lane])) {
                    best_score[lane] = other;
                    best_at[lane] = where;
                }
            }
            barrier();
        }

        if (lane == 0u) {
            chosen[k] = best_at[0];
            share[k] = best_score[0];
            score[best_at[0]] = -1.0;
        }
        barrier();
    }

    if (lane == 0u) {
        float total = 0.0;
        for (uint k = 0u; k < shape.used; ++k) {
            total += share[k];
        }

        uint out_at = pos * 2u * shape.used;

        for (uint k = 0u; k < shape.used; ++k) {
            r[out_at + k] = chosen[k];
            r[out_at + shape.used + k] = floatBitsToUint(share[k] / total);
        }
    }
}
