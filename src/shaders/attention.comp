#version 450

//  This source is compiled three times. The second compilation defines
//  SUBGROUPS and the third defines SUBGROUPS and QUERY_TILE, which sets
//  QUERIES above one: a workgroup then answers a block of query positions
//  rather than one, and the key it reads for a cached position is
//  multiplied into every query of the block instead of being read again by
//  each of them. Confining the key and value reads to a cache-resident
//  window measured attention at 1.27 s against 2.06 on a 1419-token prompt,
//  so two fifths of it was that traffic and the traffic was almost all
//  re-reading.
//
//  QUERIES is one in the first two compilations, which makes them the same
//  kernel they were: the per-query arrays are of length one and the loops
//  over them have a single turn.
//
//  A block wants a reduction per query per tile, so the tiled compilation
//  requires the subgroup one. Without subgroup operations a block would
//  reduce by walking shared memory QUERIES times a tile, which is what the
//  block exists to avoid.
//
//  On SUBGROUPS. The two differ in one thing: how the sixty-four lanes of a
//  workgroup agree on the largest score in a tile and on the sum of the
//  weights. Without subgroup operations every lane walks all sixty-four
//  entries of the tile for each of those, twice, which is a hundred and
//  twenty-eight serial reads a lane a tile against the sixty-four the dot
//  product itself takes. With them each is one instruction and a partial
//  per subgroup.
//
//  Written as one source rather than two because everything else -- the
//  scores, the bound, the running softmax, the weighted values -- is the
//  same text and must stay so. The engine binds the subgroup pipeline where
//  the device says it offers arithmetic operations to a compute shader and
//  the wide one everywhere else, which is every device that speaks only
//  Vulkan 1.0.
//
//  The sum is the one thing that is not bit-identical between them: a
//  subgroup add associates as the hardware chooses and the serial loop
//  associates left to right. It is the denominator of a softmax and the
//  difference is in its last bits; the conformance sweep is what says that
//  is small enough, as it is for the matrix product.
#ifdef SUBGROUPS
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

#ifdef HALVED
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require
#extension GL_EXT_shader_16bit_storage : require
#endif

//  A batch of positions attending to everything the cache holds.
//
//  The scores against every cached key, the bound the architecture states on
//  them, the softmax across them, and the values weighted by what comes out:
//  the whole of attention for one position, which is the part of a layer that
//  stands between two matrix products and keeps them from being sent
//  together. Done here, a block's queries can go over, be attended with, and
//  come back as one thing.
//
//  Keys and values share a buffer. Attention wants four arrays and the
//  pipeline layout carries three, and rather than widen the layout for every
//  shader the cache is laid out as one region with the values at an offset --
//  which is the caller's choice to make and costs nothing, since the cache is
//  written by this program in the first place.
//
//  A workgroup a head of a position, and the cached positions dealt round its
//  invocations. A batch of one is what a run generating asks for; a batch of
//  many is what evaluating a prompt asks for, and the reason it is one call
//  rather than one a position is that a call costs 83 microseconds before it
//  computes anything. A 110-token prompt over twenty-two layers submitted a
//  position at a time spent 0.514 s in 2420 calls, around half of it in
//  submission and fences.
//
//  Every position of a batch reads the same cache and writes its own blend,
//  so they do not need each other and the only thing that differs between
//  two workgroups of the same batch is where their query is, where their
//  blend goes, and how far along the cache they may look.
//
//  A workgroup a head, and the cached positions dealt round its invocations.
//  Giving a head to a single invocation was measured first and is what this
//  replaces: thirty-two threads walking five hundred positions in series read
//  0.52 Gflop/s on a device good for thousands, and four times more positions
//  cost three and a quarter times more while thirty-two times more heads cost
//  one and a half. Positions were the serial axis, so positions are what is
//  divided here.
//
//  The softmax is still folded into the pass that reads the keys, so no score
//  outlives a tile. Storing one a position is storing a context length of
//  them, which is what a device cannot afford and the processor does not
//  mind.

//  How many invocations a workgroup has, which is how many cached
//  positions it takes at a time.
//
//  Sixty-four is one subgroup, which makes every barrier below free. What
//  it costs is that a workgroup is one wave: generating, where a workgroup
//  is a head of a single position, thirty-two heads are thirty-two waves
//  and this part has twenty-four of them to fill. A layer's attention then
//  reads eighty-seven gigaflops where its matrix products read four
//  thousand.
//
//  Two hundred and fifty-six is four subgroups, four times the waves, and
//  barriers that are no longer free. Which of those matters more depends on
//  how many workgroups there already are, and the two compilations that
//  attend are on opposite sides of it.
//
//  Generating, a workgroup is a head of one position and there are
//  thirty-two of them: sixty-four generated tokens read 1.603 s against
//  1.715, better in each of three rounds and with every wide run faster
//  than every narrow one. Reading a prompt, a workgroup is a head of a
//  block of eight positions and there are five hundred and twelve, which
//  fills the part already -- and there the same change costs six per cent,
//  1.740 s against 1.635. So the second compilation is wide and the third
//  is not.
//
//  The first is not either. It reduces by walking the tile rather than
//  through subgroup operations, and a walk over two hundred and fifty-six
//  entries where sixty-four would do is four times the serial reads this
//  kernel exists to avoid.
#ifdef WIDE
#define LANES 256u
layout(local_size_x = 256) in;
#else
#define LANES 64u
layout(local_size_x = 64) in;
#endif

//  The cache, in one of its two precisions.
//
//  place.comp writes every position twice -- once as it is and once as half
//  precision, in a copy that lies after the cache proper and is indexed the
//  same way -- and until now only attention_matrix.comp read the second.
//  A round could not: that kernel takes a batch of queries against one
//  cache and a round is one query against each of several.
//
//  So this source is compiled once more with HALVED, which reads the same
//  copy through this binding and is what a round binds. The bytes a
//  position costs are halved and the cache is what a long context spends
//  its time reading: a round of sixteen sequences at 1419 positions spent
//  thirty milliseconds of a sixty-three millisecond step here.
//
//  The per-row table is the one thing that is not in the copy. It lives at
//  the end of the cache proper, which is the same buffer, so under HALVED
//  it is read as two halves of the word it was written as -- the low half
//  first, which is how a little-endian device stores it and every device
//  this runs on is one.
#ifdef HALVED
layout(std430, binding = 0) readonly buffer Cache { float16_t kvh[]; };

float held_at (uint at) { return float (kvh[at]); }

uint word_at (uint at) {
    return uint (float16BitsToUint16 (kvh[at * 2u]))
         | (uint (float16BitsToUint16 (kvh[at * 2u + 1u])) << 16u);
}
#else
layout(std430, binding = 0) readonly  buffer Cache { float kv[]; };

float held_at (uint at) { return kv[at]; }

uint word_at (uint at) { return floatBitsToUint (kv[at]); }
#endif

layout(std430, binding = 1) readonly  buffer Query { float q[]; };
layout(std430, binding = 2) writeonly buffer Blend { float y[]; };

layout(push_constant, std430) uniform Shape {
    uint heads;
    uint head_size;
    uint value_size;

    //  How many heads share one group of keys and values. One for a model
    //  that gives every head its own; more where several heads read the same.
    uint group_size;

    //  The first and last cached positions the batch's first position may
    //  look at. A model with a sliding window states a first that is not
    //  zero. Position p of the batch looks to last + p where the model
    //  attends one way, and to last itself where it attends both.
    uint first;
    uint last;

    //  Where the keys begin in the shared buffer, where the values begin,
    //  and how far apart one position's keys and values are.
    uint k_base;
    uint v_base;
    uint kv_width;
    uint v_width;

    //  The scale on a score before the bound, and the bound itself, which is
    //  zero where the architecture states none.
    float scale;
    float cap;

    //  How many positions this call attends for. One while generating.
    uint positions;

    //  How wide this layer's sliding window is, or zero where it does not
    //  slide one. It cannot be read off first and last, because first is
    //  the batch's first position's and every later position has its own.
    uint window;

    //  Whether a position may see only what precedes it. Non-zero for every
    //  model that generates. Zero for one that reads a whole text at once,
    //  where every position of the batch sees every position of it -- the
    //  ones after it as well as the ones before -- so none of them derives
    //  its last from where it sits.
    uint causal;

    //  How steeply a head's attention falls off with distance, for a model
    //  that learned no positions at all and is told where a token is by the
    //  scores instead. Zero for every model that rotates or learns a row for
    //  the position. The per-head slope follows from this and the head
    //  count, and is worked out here rather than pushed, because a workgroup
    //  is one head of one position and a push constant is the same for all
    //  of them.
    float max_bias;

    //  A round rather than a batch: rows that are different sequences.
    //
    //  A batch is one session's own positions, so every row reads the same
    //  cache and derives its last from where it sits. A round's rows are
    //  different sessions, each with its own cache and its own position,
    //  and neither follows from anything the batch knows. Both are read out
    //  of a table at the end of the cache -- two words a row, this being
    //  where it begins, counted in elements. Zero for a batch, which is
    //  everything this kernel did before.
    //
    //  In the cache rather than in this block because a push block is a
    //  hundred and twenty-eight bytes on every device and a table of two
    //  words a row would cap a round at eight members. The cache is a
    //  buffer this kernel has bound already, so the table costs a read
    //  where it was going to cost a limit.
    uint table_at;
} shape;

//  The largest value width this kernel will take. A head wider than this is
//  refused by the caller and done on the processor, which is better than a
//  kernel that quietly writes past the end of what it kept.
const uint room = 128;

//  How many query positions a workgroup answers.
#ifdef QUERY_TILE
const uint QUERIES = 8u;
#else
const uint QUERIES = 1u;
#endif

//  And how many heads. A model with grouped queries gives several heads one
//  group of keys and values -- eight of them here, thirty-two heads against
//  four -- and a workgroup a head reads that group's slice of the cache once
//  for each head that wants it. Eight times over, for this model.
//
//  It is not eight times the traffic in memory, because the workgroups of a
//  group are neighbours in the dispatch and a cache serves them; how much
//  that is worth was measured by taking it away, dispatching the heads down
//  the second axis instead of the first, and a round of sixteen sequences
//  went from 1.75 s to 8.9. So the sharing is already happening and it is
//  happening in a cache that has to carry eight times what the answer needs.
//
//  A workgroup that answers four heads at once reads the slice once for the
//  four. Four rather than eight so that a model whose group is four is
//  served as well as one whose group is eight; the engine binds this only
//  where the group divides by it, and a model that gives every head its own
//  keys is left on the kernel it was on.
#ifdef GROUPED
const uint HEADS = 4u;
#else
const uint HEADS = 1u;
#endif

//  One tile of scores per query of the block and head of the bundle, one
//  entry per invocation.
shared float tile[QUERIES * HEADS * LANES];

#ifdef SUBGROUPS
//  One partial per subgroup. Sixty-four of them, because a device may make
//  its subgroups as narrow as it likes and sixty-four lanes could in
//  principle be sixty-four of them; it is two hundred and fifty-six bytes
//  and shared memory is what bounds occupancy here, so the room is worth
//  counting even when it is small.
shared float shared_max[HEADS * 64];
shared float shared_sum[HEADS * 64];

//  The largest of a value across the workgroup, and the sum of one. The
//  test on the subgroup count is workgroup-uniform, so the barriers inside
//  it are reached by every lane or by none -- which is what makes them
//  legal.
float whole_max (float mine) {
    float found = subgroupMax (mine);

    if (gl_NumSubgroups == 1u) {
        return found;
    }

    if (subgroupElect ()) {
        shared_max[gl_SubgroupID] = found;
    }
    barrier ();

    float whole = shared_max[0];
    for (uint i = 1u; i < gl_NumSubgroups; i++) {
        whole = max (whole, shared_max[i]);
    }
    barrier ();
    return whole;
}

//  The same two for a whole bundle of heads, which is what makes a bundle
//  worth having: the barriers are what a reduction costs and four heads
//  reduced one at a time pay for four pairs of them. Batched, they pay for
//  one pair and four subgroup operations, which are not barriers.
void whole_max_all (inout float mine[HEADS]) {
    float found[HEADS];

    for (uint h = 0u; h < HEADS; h++) {
        found[h] = subgroupMax (mine[h]);
    }

    if (gl_NumSubgroups == 1u) {
        for (uint h = 0u; h < HEADS; h++) {
            mine[h] = found[h];
        }
        return;
    }

    if (subgroupElect ()) {
        for (uint h = 0u; h < HEADS; h++) {
            shared_max[h * 64u + gl_SubgroupID] = found[h];
        }
    }
    barrier ();

    for (uint h = 0u; h < HEADS; h++) {
        float whole = shared_max[h * 64u];
        for (uint i = 1u; i < gl_NumSubgroups; i++) {
            whole = max (whole, shared_max[h * 64u + i]);
        }
        mine[h] = whole;
    }
    barrier ();
}

void whole_sum_all (inout float mine[HEADS]) {
    float found[HEADS];

    for (uint h = 0u; h < HEADS; h++) {
        found[h] = subgroupAdd (mine[h]);
    }

    if (gl_NumSubgroups == 1u) {
        for (uint h = 0u; h < HEADS; h++) {
            mine[h] = found[h];
        }
        return;
    }

    if (subgroupElect ()) {
        for (uint h = 0u; h < HEADS; h++) {
            shared_sum[h * 64u + gl_SubgroupID] = found[h];
        }
    }
    barrier ();

    for (uint h = 0u; h < HEADS; h++) {
        float whole = 0.0;
        for (uint i = 0u; i < gl_NumSubgroups; i++) {
            whole += shared_sum[h * 64u + i];
        }
        mine[h] = whole;
    }
    barrier ();
}

float whole_sum (float mine) {
    float found = subgroupAdd (mine);

    if (gl_NumSubgroups == 1u) {
        return found;
    }

    if (subgroupElect ()) {
        shared_sum[gl_SubgroupID] = found;
    }
    barrier ();

    float whole = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; i++) {
        whole += shared_sum[i];
    }
    barrier ();
    return whole;
}
#else
//  The same two, for a device that offers no subgroup operations. They
//  reduce through the score tile itself, which is free at the moment they
//  are called and is exactly sixty-four wide here -- QUERIES is one
//  whenever this half is compiled, because the tiled compilation requires
//  the subgroup one.
float whole_max (float mine) {
    barrier ();
    tile[gl_LocalInvocationID.x] = mine;
    barrier ();

    float whole = tile[0];
    for (uint i = 1u; i < LANES; i++) {
        whole = max (whole, tile[i]);
    }
    return whole;
}

float whole_sum (float mine) {
    barrier ();
    tile[gl_LocalInvocationID.x] = mine;
    barrier ();

    float whole = 0.0;
    for (uint i = 0u; i < LANES; i++) {
        whole += tile[i];
    }
    return whole;
}

//  And the bundled pair, which this half reaches only with HEADS at one:
//  a bundle needs the subgroup operations, and the engine binds it only
//  where the device offered them.
void whole_max_all (inout float mine[HEADS]) {
    for (uint h = 0u; h < HEADS; h++) {
        mine[h] = whole_max (mine[h]);
    }
}

void whole_sum_all (inout float mine[HEADS]) {
    for (uint h = 0u; h < HEADS; h++) {
        mine[h] = whole_sum (mine[h]);
    }
}
#endif

void main() {
    uint head  = gl_WorkGroupID.x * HEADS;
    uint block = gl_WorkGroupID.y;
    uint lane  = gl_LocalInvocationID.x;

    if (head >= shape.heads || block * QUERIES >= shape.positions) {
        return;
    }

    //  Every head of the bundle is in one group, which is what the engine
    //  checks before it binds this: the bundle's width divides the group's.
    uint group = head / shape.group_size;

    //  Each head's rung of the slope ladder. The heads below the largest
    //  power of two not above the head count take one ladder and the rest
    //  take another; a ladder written as the first alone is right for the
    //  first eight heads of twelve and wrong for the other four.
    float slope[HEADS];

    for (uint h = 0u; h < HEADS; h++) {
        slope[h] = 0.0;
    }

    if (shape.max_bias > 0.0) {
        uint rungs = 1u;
        while (rungs * 2u <= shape.heads) {
            rungs *= 2u;
        }

        float m0 = exp2(-(shape.max_bias / float(rungs)));
        float m1 = exp2(-(shape.max_bias / 2.0 / float(rungs)));

        for (uint h = 0u; h < HEADS; h++) {
            uint which = head + h;

            slope[h] = which < rungs
                       ? pow(m0, float(which + 1u))
                       : pow(m1, float(2u * (which - rungs) + 1u));
        }
    }

    //  Each query of the block: where it sits, how far back it may look and
    //  how far forward, and where its own query vector is.
    //
    //  A block at the end of the batch may be partly empty. Its dead slots
    //  are clamped onto the last real query rather than sent home -- they
    //  compute an answer that is already being computed and the write at
    //  the end drops it -- because every loop below has a constant trip
    //  count and a workgroup some of whose invocations left early is a
    //  workgroup whose barriers are undefined.
    uint slot_of[QUERIES];
    uint last_of[QUERIES];
    uint first_of[QUERIES];
    uint q_of[QUERIES];

    //  Where each row's own cache begins: nothing for a batch, and that
    //  row's own block for each row of a round. A block of more than one
    //  query reads a cached key once and dots it into every query of the
    //  block, which is the whole reason a block exists -- and rows of a
    //  round do not share a cache, so the caller gives a round the kernel
    //  whose block is one. That is why the reads below may take held_of[0]
    //  and be right for both.
    uint held_of[QUERIES];

    uint last_max  = 0u;
    uint first_min = 0xFFFFFFFFu;

    for (uint i = 0u; i < QUERIES; i++) {
        uint slot = min(block * QUERIES + i, shape.positions - 1u);
        slot_of[i] = slot;

        //  This position's last, and the first it may look back to. A
        //  window slides with the position; without one, first is what was
        //  pushed. Attending both ways, every position shares the one that
        //  was pushed: the end of the text is the end of the text for all
        //  of them.
        uint last = shape.table_at != 0u
                  ? word_at (shape.table_at + slot * 2u)
                  : shape.last + (shape.causal != 0u ? slot : 0u);
        uint first = shape.first;
        if (shape.window > 0u) {
            first = last + 1u > shape.window ? last + 1u - shape.window : 0u;
        }

        last_of[i]  = last;
        first_of[i] = first;

        //  Where this row's own cache begins, which is nothing at all for a
        //  batch and a member's worth for each row of a round.
        held_of[i] = shape.table_at != 0u
                   ? word_at (shape.table_at + slot * 2u + 1u)
                   : 0u;
        //  Without the head's own offset, which the bundle adds where it
        //  reads: every head of the bundle wants the same query position.
        q_of[i] = slot * shape.heads * shape.head_size;

        last_max  = max(last_max, last);
        first_min = min(first_min, first);
    }

    //  What this invocation carries out: every sixty-fourth component of
    //  each query's value, so the private store is four floats a query and
    //  not a head's width.
    //  Which component of the value this invocation carries, and which
    //  sixty-four of a tile's positions it weighs into it. With one
    //  subgroup there is one part and this is what it always was; with
    //  four, four invocations share a component and each takes a quarter
    //  of the positions, to be added up once at the end.
    uint comp = lane & 63u;
    uint part = lane >> 6u;

    float held[QUERIES][HEADS][room / 64];
    float top[QUERIES][HEADS];
    float sum[QUERIES][HEADS];

    for (uint i = 0u; i < QUERIES; i++) {
        for (uint h = 0u; h < HEADS; h++) {
            for (uint k = 0; k < room / 64; k++) {
                held[i][h][k] = 0.0;
            }
            top[i][h] = -1.0 / 0.0;
            sum[i][h] = 0.0;
        }
    }

    for (uint base = first_min; base <= last_max; base += LANES) {
        uint step = base + lane;

        //  The key at this lane's cached position, read once and multiplied
        //  into every query of the block and every head of the bundle. That
        //  reuse is the whole of what a block and a bundle are for: a key
        //  component crosses the bus once and does QUERIES times HEADS
        //  multiply-adds rather than one.
        float dot[QUERIES][HEADS];
        for (uint i = 0u; i < QUERIES; i++) {
            for (uint h = 0u; h < HEADS; h++) {
                dot[i][h] = 0.0;
            }
        }

        if (step <= last_max) {
            uint k_at = shape.k_base + held_of[0] + step * shape.kv_width
                        + group * shape.head_size;

            //  Eight components a turn, so that a query's components are
            //  fetched together.
            //
            //  A component at a time is one load an operation: the key is
            //  read once and multiplied into every query of the block, but
            //  each query's own component is read for its own multiply and
            //  the address is uniform across the workgroup, which makes it
            //  a scalar load and one of them a multiply-add. Eight at a
            //  time are eight consecutive words of one query, which is one
            //  fetch rather than eight.
            //
            //  Each dot product still accumulates over the components in
            //  increasing order, so nothing moves.
            uint whole = shape.head_size & ~7u;

            for (uint c = 0; c < whole; c += 8u) {
                float kc[8];

                for (uint e = 0u; e < 8u; e++) {
                    kc[e] = held_at (k_at + c + e);
                }

                for (uint i = 0u; i < QUERIES; i++) {
                    for (uint h = 0u; h < HEADS; h++) {
                        uint at = q_of[i] + (head + h) * shape.head_size + c;

                        for (uint e = 0u; e < 8u; e++) {
                            dot[i][h] += q[at + e] * kc[e];
                        }
                    }
                }
            }

            for (uint c = whole; c < shape.head_size; c++) {
                float kc = held_at (k_at + c);
                for (uint i = 0u; i < QUERIES; i++) {
                    for (uint h = 0u; h < HEADS; h++) {
                        dot[i][h] +=
                          q[q_of[i] + (head + h) * shape.head_size + c] * kc;
                    }
                }
            }
        }

        //  The weight of this lane's score for each query, worked out once
        //  and put back where every lane can read it.
        //
        //  It used to be worked out where it was wanted, which is once by
        //  every lane for every score of the tile and then again for every
        //  component of the value: eight thousand exponentials a tile where
        //  there are sixty-four distinct ones. The barriers below are what
        //  that costs, and a barrier is cheaper than a hundred and
        //  twenty-eight exponentials.
        float mine[QUERIES][HEADS];
        float carry[QUERIES][HEADS];

        for (uint i = 0u; i < QUERIES; i++) {
            float score[HEADS];

            for (uint h = 0u; h < HEADS; h++) {
                //  A step outside this query's own window scores minus
                //  infinity, so it takes no part in the largest and adds
                //  nothing to the sum. The loop is over the union of the
                //  block's windows and only this says where each one ends.
                score[h] = -1.0 / 0.0;

                if (step >= first_of[i] && step <= last_of[i]) {
                    score[h] = dot[i][h] * shape.scale;

                    //  The fall-off with distance, after the scale and
                    //  before the bound, which is the order the
                    //  architecture's own runtime takes them in. Unsigned:
                    //  a position is as far from what follows it as from
                    //  what came before, which is what makes this the
                    //  bidirectional form and not the one causal models
                    //  use.
                    if (slope[h] > 0.0) {
                        uint asking = shape.causal != 0u
                                      ? last_of[i]
                                      : shape.last - (shape.positions - 1u)
                                        + slot_of[i];
                        score[h] -=
                          slope[h] * float(abs(int(step) - int(asking)));
                    }

                    if (shape.cap > 0.0) {
                        score[h] = shape.cap * tanh(score[h] / shape.cap);
                    }
                }
            }

            //  One pair of barriers for the bundle rather than a pair
            //  each, which is what makes a bundle pay: the reduction is
            //  where a workgroup's heads would otherwise cost what they
            //  save.
            float raised[HEADS];

            for (uint h = 0u; h < HEADS; h++) {
                raised[h] = score[h];
            }

            whole_max_all (raised);

            for (uint h = 0u; h < HEADS; h++) {
                raised[h] = max (top[i][h], raised[h]);

                //  A tile in which this query sees nothing at all: every
                //  score minus infinity and no running maximum yet.
                //  Subtracting one infinity from another is what the guard
                //  is for.
                bool empty = isinf(raised[h]) && raised[h] < 0.0;

                carry[i][h] = empty ? 1.0 : exp(top[i][h] - raised[h]);
                mine[i][h]  = empty ? 0.0 : exp(score[h] - raised[h]);
            }

            float added[HEADS];

            for (uint h = 0u; h < HEADS; h++) {
                added[h] = mine[i][h];
            }

            whole_sum_all (added);

            for (uint h = 0u; h < HEADS; h++) {
                sum[i][h] = sum[i][h] * carry[i][h] + added[h];
                top[i][h] = raised[h];
            }
        }

        barrier();
        for (uint i = 0u; i < QUERIES; i++) {
            for (uint h = 0u; h < HEADS; h++) {
                tile[(i * HEADS + h) * LANES + lane] = mine[i][h];
            }
        }
        barrier();

        uint span = min(LANES, last_max - base + 1);

        uint lo = min (part * 64u, span);
        uint hi = min (lo + 64u, span);

        for (uint k = 0; k < room / 64; k++) {
            uint c = comp + k * 64;
            if (c >= shape.value_size) {
                break;
            }

            //  The value at this position and component, read once and
            //  multiplied into every query of the block.
            //
            //  Written the other way round -- a query outside a position,
            //  which is how this began -- the same address was loaded once
            //  for each query: four loads for four multiply-adds where one
            //  will do. The dot product above already had the shape; this
            //  did not.
            //
            //  Each query still accumulates over the positions in the same
            //  order, so the answers do not move.
            float got[QUERIES][HEADS];
            for (uint i = 0u; i < QUERIES; i++) {
                for (uint h = 0u; h < HEADS; h++) {
                    got[i][h] = 0.0;
                }
            }

            //  Eight cached positions a turn, for the same reason the
            //  dot product takes eight components a turn: a query's eight
            //  weights lie together in the tile and are read as one.
            uint run = lo + ((hi - lo) & ~7u);

            for (uint j = lo; j < run; j += 8u) {
                float v[8];

                for (uint e = 0u; e < 8u; e++) {
                    v[e] = held_at (shape.v_base + held_of[0]
                                    + (base + j + e) * shape.v_width
                                    + group * shape.value_size + c);
                }

                for (uint i = 0u; i < QUERIES; i++) {
                    for (uint h = 0u; h < HEADS; h++) {
                        uint at = (i * HEADS + h) * LANES + j;

                        for (uint e = 0u; e < 8u; e++) {
                            got[i][h] += tile[at + e] * v[e];
                        }
                    }
                }
            }

            for (uint j = run; j < hi; j++) {
                float v = held_at (shape.v_base + held_of[0]
                                   + (base + j) * shape.v_width
                                   + group * shape.value_size + c);

                for (uint i = 0u; i < QUERIES; i++) {
                    for (uint h = 0u; h < HEADS; h++) {
                        got[i][h] += tile[(i * HEADS + h) * LANES + j] * v;
                    }
                }
            }

            for (uint i = 0u; i < QUERIES; i++) {
                for (uint h = 0u; h < HEADS; h++) {
                    held[i][h][k] =
                      held[i][h][k] * carry[i][h] + got[i][h];
                }
            }
        }

        barrier();
    }

    for (uint i = 0u; i < QUERIES; i++) {
        //  The dead slots of a partly empty block computed a copy of the
        //  last real query and are dropped here.
        if (block * QUERIES + i >= shape.positions) {
            break;
        }

        //  The parts added up. One invocation of the four that share a
        //  component writes it, and the tile is free to gather them in --
        //  the scores it held are spent. The loop over k does not leave
        //  early: it has barriers in it and every invocation has to reach
        //  them, so the component it does not carry is written by nobody
        //  rather than escaped from.
        //
        //  A head of the bundle at a time, because the gathering uses the
        //  tile and the tile is one.
        for (uint h = 0u; h < HEADS; h++) {
            uint out_at = slot_of[i] * shape.heads * shape.value_size
                          + (head + h) * shape.value_size;

            for (uint k = 0; k < room / 64; k++) {
                barrier ();
                tile[lane] = held[i][h][k];
                barrier ();

                uint c = comp + k * 64;

                if (part == 0u && c < shape.value_size) {
                    float total = 0.0;

                    for (uint pp = 0u; pp < LANES / 64u; pp++) {
                        total += tile[pp * 64u + comp];
                    }

                    y[out_at + c] = total / sum[i][h];
                }
            }
        }
    }
}
