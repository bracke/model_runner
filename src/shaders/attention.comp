#version 450

//  A batch of positions attending to everything the cache holds.
//
//  The scores against every cached key, the bound the architecture states on
//  them, the softmax across them, and the values weighted by what comes out:
//  the whole of attention for one position, which is the part of a layer that
//  stands between two matrix products and keeps them from being sent
//  together. Done here, a block's queries can go over, be attended with, and
//  come back as one thing.
//
//  Keys and values share a buffer. Attention wants four arrays and the
//  pipeline layout carries three, and rather than widen the layout for every
//  shader the cache is laid out as one region with the values at an offset --
//  which is the caller's choice to make and costs nothing, since the cache is
//  written by this program in the first place.
//
//  A workgroup a head of a position, and the cached positions dealt round its
//  invocations. A batch of one is what a run generating asks for; a batch of
//  many is what evaluating a prompt asks for, and the reason it is one call
//  rather than one a position is that a call costs 83 microseconds before it
//  computes anything. A 110-token prompt over twenty-two layers submitted a
//  position at a time spent 0.514 s in 2420 calls, around half of it in
//  submission and fences.
//
//  Every position of a batch reads the same cache and writes its own blend,
//  so they do not need each other and the only thing that differs between
//  two workgroups of the same batch is where their query is, where their
//  blend goes, and how far along the cache they may look.
//
//  A workgroup a head, and the cached positions dealt round its invocations.
//  Giving a head to a single invocation was measured first and is what this
//  replaces: thirty-two threads walking five hundred positions in series read
//  0.52 Gflop/s on a device good for thousands, and four times more positions
//  cost three and a quarter times more while thirty-two times more heads cost
//  one and a half. Positions were the serial axis, so positions are what is
//  divided here.
//
//  The softmax is still folded into the pass that reads the keys, so no score
//  outlives a tile. Storing one a position is storing a context length of
//  them, which is what a device cannot afford and the processor does not
//  mind.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Cache { float kv[]; };
layout(std430, binding = 1) readonly  buffer Query { float q[]; };
layout(std430, binding = 2) writeonly buffer Blend { float y[]; };

layout(push_constant) uniform Shape {
    uint heads;
    uint head_size;
    uint value_size;

    //  How many heads share one group of keys and values. One for a model
    //  that gives every head its own; more where several heads read the same.
    uint group_size;

    //  The first and last cached positions the batch's first position may
    //  look at. A model with a sliding window states a first that is not
    //  zero. Position p of the batch looks to last + p where the model
    //  attends one way, and to last itself where it attends both.
    uint first;
    uint last;

    //  Where the keys begin in the shared buffer, where the values begin,
    //  and how far apart one position's keys and values are.
    uint k_base;
    uint v_base;
    uint kv_width;
    uint v_width;

    //  The scale on a score before the bound, and the bound itself, which is
    //  zero where the architecture states none.
    float scale;
    float cap;

    //  How many positions this call attends for. One while generating.
    uint positions;

    //  How wide this layer's sliding window is, or zero where it does not
    //  slide one. It cannot be read off first and last, because first is
    //  the batch's first position's and every later position has its own.
    uint window;

    //  Whether a position may see only what precedes it. Non-zero for every
    //  model that generates. Zero for one that reads a whole text at once,
    //  where every position of the batch sees every position of it -- the
    //  ones after it as well as the ones before -- so none of them derives
    //  its last from where it sits.
    uint causal;
} shape;

//  The largest value width this kernel will take. A head wider than this is
//  refused by the caller and done on the processor, which is better than a
//  kernel that quietly writes past the end of what it kept.
const uint room = 256;

//  One tile of scores, one per invocation.
shared float tile[64];

void main() {
    uint head = gl_WorkGroupID.x;
    uint slot = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    if (head >= shape.heads || slot >= shape.positions) {
        return;
    }

    //  This position's last, and the first it may look back to. A window
    //  slides with the position; without one, first is what was pushed.
    //  Attending both ways, every position shares the one that was pushed:
    //  the end of the text is the end of the text for all of them.
    uint last = shape.last + (shape.causal != 0u ? slot : 0u);
    uint first = shape.first;
    if (shape.window > 0u) {
        first = last + 1u > shape.window ? last + 1u - shape.window : 0u;
    }

    uint group = head / shape.group_size;
    uint q_at = slot * shape.heads * shape.head_size + head * shape.head_size;

    //  What this invocation carries out: every sixty-fourth component of
    //  this head's value, so the private store is four floats and not a
    //  head's width.
    float held[room / 64];
    for (uint k = 0; k < room / 64; k++) {
        held[k] = 0.0;
    }

    float top = -1.0 / 0.0;
    float sum = 0.0;

    for (uint base = first; base <= last; base += 64) {
        uint step = base + lane;

        float score = -1.0 / 0.0;
        if (step <= last) {
            uint k_at = shape.k_base + step * shape.kv_width
                        + group * shape.head_size;

            float dot = 0.0;
            for (uint c = 0; c < shape.head_size; c++) {
                dot += q[q_at + c] * kv[k_at + c];
            }
            score = dot * shape.scale;

            if (shape.cap > 0.0) {
                score = shape.cap * tanh(score / shape.cap);
            }
        }

        tile[lane] = score;
        barrier();

        uint span = min(64u, last - base + 1);

        float highest = tile[0];
        for (uint j = 1; j < span; j++) {
            highest = max(highest, tile[j]);
        }

        float raised = max(top, highest);
        float carry = exp(top - raised);

        float added = 0.0;
        for (uint j = 0; j < span; j++) {
            added += exp(tile[j] - raised);
        }
        sum = sum * carry + added;

        for (uint k = 0; k < room / 64; k++) {
            uint c = lane + k * 64;
            if (c >= shape.value_size) {
                break;
            }

            float gathered = 0.0;
            for (uint j = 0; j < span; j++) {
                uint v_at = shape.v_base + (base + j) * shape.v_width
                            + group * shape.value_size + c;
                gathered += exp(tile[j] - raised) * kv[v_at];
            }

            held[k] = held[k] * carry + gathered;
        }

        top = raised;
        barrier();
    }

    uint out_at = slot * shape.heads * shape.value_size
                  + head * shape.value_size;
    for (uint k = 0; k < room / 64; k++) {
        uint c = lane + k * 64;
        if (c >= shape.value_size) {
            break;
        }
        y[out_at + c] = held[k] / sum;
    }
}
