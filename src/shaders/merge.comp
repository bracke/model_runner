#version 450
#extension GL_EXT_control_flow_attributes : require

//  The slices of a split attention put together.
//
//  attention.comp cuts a long cache into slices when the engine dispatches
//  several workgroups down its third axis, and each slice leaves its
//  unnormalized blend, its largest score and its sum after the answers.
//  A softmax over the whole is the softmax over the slices rescaled to a
//  common largest: the blend of slice s is worth exp(top_s - M) of itself,
//  and so is its sum, where M is the largest of the tops. This is one
//  workgroup a head of a position, a lane a component of the value.
//
//  A slice that saw nothing left minus infinity as its largest and zero as
//  its sum; exp of minus infinity is zero and it takes no part.
//
//  The order the slices are added in is the order they lie in, so the
//  answer is the same however the workgroups ran; it is not the order the
//  unsplit kernel adds positions in, and the last bits differ from it.

layout(local_size_x = 64) in;

layout(std430, binding = 2) buffer Blend { float y[]; };

layout(push_constant, std430) uniform Shape {
    uint heads;
    uint value_size;
    uint positions;
    uint slices;
} shape;

//  A chunk of slices' largest scores, their sums and their weights
//  against the largest of all, read by a lane a slice. Read in turn by a lane -- three
//  loops over the slices, each read waited out before the next was made --
//  a round's check of four positions in twelve slices merged in about as
//  long as it attended a tile. The adding is still a slice at a time, in
//  the order they lie in.
const uint CHUNK = 64u;
shared float tops[CHUNK];
shared float sums[CHUNK];
shared float worth[CHUNK];

//  Components a lane carries a pass: eight, five hundred and twelve a
//  workgroup, every one of a slice's read before any is added.
const uint CARRIED = 8u;

void main() {
    uint head = gl_WorkGroupID.x;
    uint slot = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    if (head >= shape.heads || slot >= shape.positions) {
        return;
    }

    uint stride = shape.value_size + 2u;
    uint records = shape.positions * shape.heads * shape.value_size;
    uint first   = records + (slot * shape.heads + head) * stride;
    uint apart   = shape.positions * shape.heads * stride;

    float largest = -1.0 / 0.0;

    for (uint s0 = 0u; s0 < shape.slices; s0 += CHUNK) {
        uint many = min (CHUNK, shape.slices - s0);

        barrier();
        if (lane < many) {
            tops[lane] = y[first + (s0 + lane) * apart + shape.value_size];
        }
        barrier();

        for (uint s = 0u; s < many; ++s) {
            largest = max (largest, tops[s]);
        }
    }

    uint out_at = slot * shape.heads * shape.value_size
                  + head * shape.value_size;

    for (uint c0 = 0u; c0 < shape.value_size; c0 += 64u * CARRIED) {
        float total = 0.0;
        float blend[CARRIED];

        [[unroll]] for (uint k = 0u; k < CARRIED; k++) {
            blend[k] = 0.0;
        }

        for (uint s0 = 0u; s0 < shape.slices; s0 += CHUNK) {
            uint many = min (CHUNK, shape.slices - s0);

            barrier();
            if (lane < many) {
                uint at = first + (s0 + lane) * apart;

                sums[lane]  = y[at + shape.value_size + 1u];
                worth[lane] = exp (y[at + shape.value_size] - largest);
            }
            barrier();

            for (uint s = 0u; s < many; ++s) {
                uint  at = first + (s0 + s) * apart;
                float w  = worth[s];
                float got[CARRIED];

                total += sums[s] * w;

                [[unroll]] for (uint k = 0u; k < CARRIED; k++) {
                    uint c = c0 + k * 64u + lane;
                    got[k] = c < shape.value_size ? y[at + c] : 0.0;
                }
                [[unroll]] for (uint k = 0u; k < CARRIED; k++) {
                    blend[k] += got[k] * w;
                }
            }
        }

        [[unroll]] for (uint k = 0u; k < CARRIED; k++) {
            uint c = c0 + k * 64u + lane;

            if (c < shape.value_size) {
                y[out_at + c] = blend[k] / total;
            }
        }
    }
}
