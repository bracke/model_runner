#version 450

//  Four bytes of a word turned into four numbers at once, which is what
//  unpack8 is for. A nibble taken out one at a time is a shift, a mask and
//  a convert each; taken four at a time it is one mask on the word and one
//  unpack. llama.cpp's own k-quant kernels read their quants this way and
//  it is the one thing from them this program did not already do.
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

//  Rows of a matrix against a batch of vectors, one row per invocation.
//
//  y[v][row] = sum over col of w[row][col] * x[v][col]
//
//  Two things are folded into one shader on purpose, because both are the
//  same loop with a different way of reading w:
//
//  A batch. An invocation carries GROUP accumulators and reads each weight
//  once for all of them, which is the saving a batch exists to make: the
//  weights are what a product spends its time on, and reading them once for
//  eight vectors is eight times less of it. A batch longer than GROUP is
//  several dispatches, each told which vector it starts at -- and each of
//  those dispatches reads the whole model again, which is why GROUP is the
//  count a round of several sequences runs into first.
//
//  A format. A weight is either a floating-point value or a block of packed
//  bits with a scale, and unpacking is a handful of arithmetic where reading
//  the matrix again is a pass over the whole model. So the weights are bound
//  as plain words and decoded here, which is what lets a quantized model
//  reach a device without four bytes a weight being made for it first.
//
//  Every format this program reads is decoded here -- all fifteen, the same
//  set Model_Runner.GGUF.Is_Supported names. It used to be three, and the
//  other twelve reached a device only by being repacked into one of them
//  first: a pass over the whole model at load, and four bytes a weight
//  afterwards for anything repacked to binary32. A format the shader cannot
//  read is a format the loader must refuse or convert, so the list here and
//  the list in Backend.Device.Describe are the same list, and the test that
//  compares them fails when they are not.
//
//  The accumulation is in binary32, which is what a device offers without
//  asking for an extension. The processor's own kernels accumulate a row in
//  binary64 and round once at the end, so the two do not agree bit for bit
//  and are not meant to; what they have to agree on is the answer to within
//  the tolerance the conformance sweep states.
//
//  Rows are contiguous, which is the layout every weight in this program
//  already has: a row is what a matrix-vector product reads in one run.

//  Invocations to a workgroup.
//
//  This was one number for every format and the best one is not: Q4_K
//  generates in 0.941 s at a hundred and twenty-eight against 0.992 at two
//  hundred and fifty-six, Q5_K in 1.036 against 1.046 -- and Q8_0 reads
//  1.320 against 1.258 the other way, while Q2_K reads 1.053 against 0.894,
//  which is sixteen per cent the wrong way. A wide group gives a row's lanes
//  more neighbours to hide behind and a narrow one leaves more groups to
//  schedule, and which of those a format wants depends on how long its
//  decode is.
//
//  llama.cpp builds its own matrix-vector pipelines at two widths for this
//  reason and picks per case. So does this now: the source is compiled once
//  more with HALF_GROUP, and the engine binds it for the two formats that
//  measured better on it.
//  A specialization constant rather than a second compilation of the
//  source. The words are the same either way and this repository will not
//  hold another copy of them -- the generated package is a megabyte and
//  that is the limit -- so the width is set when the pipeline is made.
//  llama.cpp declares its own the same way, as local_size_x_id.
layout(local_size_x_id = 0, local_size_x = 256) in;

layout(constant_id = 1) const uint GROUP = 8u;

layout(std430, binding = 0) readonly  buffer Weights { uint  w[]; };
layout(std430, binding = 1) readonly  buffer Vectors { float x[]; };

//  The same vectors four at a time, for a decode that takes four weights
//  out of a word and wants their activations in one load rather than
//  four. The same binding under a second name is how combine.comp reads
//  its arms two ways, and a run of eight columns starts on a multiple of
//  four wherever it is read this way.
layout(std430, binding = 1) readonly  buffer Vectors4 { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer Result  { float y[]; };

//  The residual, where this product is one a join followed: the sum is
//  stored rather than the product, and the join's own dispatch and the
//  buffer between it and the normalization after it both stop existing.
layout(std430, binding = 4) readonly buffer Residual { float rj[]; };

//  A gather routed on the device: the expert numbers come out of what the
//  routing step wrote rather than out of the push block, so that nothing
//  between the router and the experts has to leave the device. Bound at
//  three, which the tile kernel uses for its half-precision copy and this
//  kernel never read.
layout(std430, binding = 3) readonly buffer Routing { uint route[]; };

layout(push_constant) uniform Shape {
    uint rows;
    uint columns;

    //  How many vectors there are altogether, and which of them this
    //  dispatch starts at. Both are needed: the first says where to read
    //  and where to write, the count says which of this invocation's
    //  accumulators are real.
    uint count;
    uint first;

    //  Which format the weights are in. The numbering is
    //  Weight_Packing'Pos, so the Ada enumeration is the definition and
    //  the constants below are the copy -- they are in its order for that
    //  reason. The host refuses anything outside the range before it gets
    //  here, so the last branch needs no test of its own.
    uint format;

    //  Where the matrix begins within the weight buffer. Zero when the host
    //  copied the weights in, and the distance from a page boundary when it
    //  handed the device its own memory instead: a pointer imported that way
    //  has to be aligned to something larger than a tensor is, so the buffer
    //  starts before the matrix does.
    uint base;

    //  Whether the residual above is added before the answer is stored.
    uint joins;

    //  A round's table, which this kernel never reads: the word is here so
    //  that what follows lies where the host's push block puts it.
    uint table;

    //  A mixture's chosen experts, gathered into one dispatch.
    //
    //  An expert's matrices are one slice of a stack the file stores
    //  whole, and a token reads a few of the stack's many. Bound as one
    //  buffer, the stack is uploaded once and kept once, and which slice a
    //  workgroup reads is the third dispatch dimension: members names the
    //  expert for each, stride is the bytes one expert's slice takes, and
    //  apart is how far into the activation each member's own vector
    //  begins -- zero where they all read the same one, as a gate and an
    //  up projection do, and the expert's width where each reads its own,
    //  as a projection down does. A member's answer lands rows * count
    //  values after the one before it, which is where the host reads it.
    //
    //  A plain product is a gather of one: members[0] is zero, stride is
    //  zero, and the third dimension is one, so nothing here moves.
    uint members[16];
    uint stride;
    uint apart;

    //  Whether the member numbers are read from the routing buffer
    //  instead: the first Used words of what a routing step wrote for the
    //  one position a token is.
    //
    //  Two and three are a batch's experts, listed. The third dimension
    //  is then the expert itself and the routing buffer holds what
    //  invert.comp wrote from a batch's routing: how many positions chose
    //  each expert, where each expert's run of them begins, the run of
    //  positions, and the run of shares. A workgroup takes its expert's
    //  whole run, a group of vectors at a time, and writes each answer at
    //  the position's slot in the run rather than at the position -- so
    //  a hundred and twenty-eight experts go over as one dispatch a
    //  matrix rather than one sequence an expert, which is what a
    //  prompt's mixture cost. Two reads its vectors by position, from the
    //  list; three reads them by slot, which is what the product before
    //  it wrote. members[0] is the expert count, which says where the
    //  runs begin in the buffer.
    uint routed;
} shape;

const uint LISTED_BY_POSITION = 2u;
const uint LISTED_BY_SLOT     = 3u;

const uint FMT_F32    = 0u;
const uint FMT_F16    = 1u;
const uint FMT_BF16   = 2u;
const uint FMT_Q4_0   = 3u;
const uint FMT_Q4_1   = 4u;
const uint FMT_Q5_0   = 5u;
const uint FMT_Q5_1   = 6u;
const uint FMT_Q8_0   = 7u;
const uint FMT_IQ4_NL = 8u;
const uint FMT_Q2_K   = 9u;
const uint FMT_Q3_K   = 10u;
const uint FMT_Q4_K   = 11u;
const uint FMT_Q5_K   = 12u;
const uint FMT_Q6_K   = 13u;
const uint FMT_IQ4_XS = 14u;

//  Vectors carried at once by one invocation. A constant, so that the loops
//  over it unroll and the accumulators stay in registers; making it the
//  batch length instead would put them in memory and give back what the
//  batching just bought.
//  This source is compiled three times, and two of those compilations
//  define a width. A generated token is one vector against every matrix in
//  the model, and with GROUP at eight it carries eight accumulators, reads
//  eight offsets and reserves eight kilobytes of shared memory for a
//  reduction seven eighths of which is thrown away. The engine binds the
//  narrow pipeline when the batch is one and the wide one otherwise, so
//  neither pays for the other -- the same trade matrix_product.comp makes
//  between its two compilations, and for the same measured reason.
//
//  WIDER carries sixteen, for the case the other two leave badly served: a
//  round of nine to thirty-one sequences, which is two dispatches at eight
//  and therefore two passes over every weight in the model, and which the
//  matrix product does not take either because a tile is a hundred and
//  twenty-eight vectors wide and would be mostly the zeros the rounding
//  invented. Sixteen accumulators and sixteen kilobytes of shared memory
//  buy one pass instead of two. That is a trade of occupancy against
//  bandwidth and the measurement is what settles it, not the arithmetic.
//  How many vectors an invocation carries, as a specialization constant
//  rather than four compiled copies of this file.
//
//  It was four modules -- one, four, eight and sixteen -- and each of them
//  is ninety-six kilobytes of SPIR-V in the generated Ada, which put that
//  file over the size this repository accepts. A specialization constant is
//  fixed when the pipeline is made, so the loops below still unroll and the
//  arrays below still have a constant size; what it costs is nothing and
//  what it saves is three copies of every format's decoder.
//
//  llama.cpp compiles one of these for every count from one to eight and
//  indexes them by it. One module that takes the count is the same idea
//  without the four hundred kilobytes.

//  Invocations that share one row.
//
//  One invocation a row is the shape this began with, and it reads memory
//  the worst way a device can be asked to: at any step the lanes of a wave
//  want one byte each from addresses a whole row apart, so sixty-four lanes
//  make sixty-four transactions to fetch what would fit in one. The part is
//  not short of bandwidth -- 7.8 gigabytes a second of about ninety -- it is
//  short of transactions, which is what that arrangement spends.
//
//  Eight lanes to a row, each taking every eighth block, is what this does.
//
//  Every eighth block rather than every eighth element, and the difference
//  is the whole of what a block costs besides its quants: a scale to decode
//  and an offset to work out, once per block. Divide inside a block and all
//  eight lanes do that work for the same block -- eight times the scale
//  decodes for an eighth of the multiplies each, which measured 0.603 s
//  against 0.520 for the shape it replaced. Divide by block and it stays
//  done once. Eight lanes then read from addresses a block apart rather
//  than a row apart, which for eight-bit blocks is two hundred and seventy
//  bytes rather than two thousand: a handful of cache lines instead of
//  eight separate transactions.
//
//  What it costs is a reduction, and where that reduction goes is the whole
//  difference between this and the attempt that failed. That one divided a
//  row's blocks across lanes and reduced them at every block, through a
//  barrier each time: 4.300 s at sixty-four lanes against 1.937 for the
//  shape it replaced. This reduces once, at the end of the row, through one
//  barrier for the whole workgroup -- sixty-four blocks of arithmetic per
//  barrier rather than one.
//
//  Shared memory rather than a subgroup add, which would be fewer
//  instructions and needs SPIR-V 1.3 and so a Vulkan 1.1 instance. This
//  program asks for 1.0 and a device that offers only 1.0 runs everything
//  else here; trading that away for one reduction a row is not a trade
//  worth making.
const uint LANES = 8u;

//  Each invocation's share of its row, for the reduction below. Sized by
//  the workgroup width declared above, which the two have to agree about.
//  Room for the widest the constant above may be set to. A workgroup
//  narrower than that leaves the tail of this unread, which is a kilobyte
//  at a batch of one and worth less than a second set of words.
shared float shares[256u * GROUP];
//  The sixteen levels a non-linear four-bit quant may take. A nibble in
//  IQ4_NL and IQ4_XS is not a number but an index into this, and the table
//  belongs to the format rather than to any file.
const int LEVELS[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10,
                                  1,   13,  25,  38,  53,  69,  89, 113);

//  Where each of this invocation's vectors begins, and what it has
//  accumulated. Both are at file scope so that the accumulation below can be
//  a function rather than fifteen copies of the same three lines: a GLSL
//  parameter of array type is copied at every call, and copying eight
//  offsets per element would cost more than the decoding does.
uint from[GROUP];
float sum[GROUP];

//  One weight against every vector in the batch.
void accumulate(uint col, float weight) {
    for (uint k = 0u; k < GROUP; ++k) {
        sum[k] += weight * x[from[k] + col];
    }
}

//  One byte of the weights. Blocks are 18 to 210 bytes long, so a block
//  boundary is not a word boundary and reading a word at a time would need
//  every offset to be a special case.
uint byte_at(uint at) {
    return (w[at >> 2u] >> ((at & 3u) * 8u)) & 255u;
}

//  Four bytes of the weights as one word, from a run that need not begin on
//  a word boundary.
//
//  byte_at above is a word load, a shift and a mask for every byte, so a
//  format whose quants are read one byte at a time pays four loads where one
//  would do. Q8_0's own branch has read words since it was written; the
//  k-quants did not, and a device generating with a four-bit k-quant was
//  slower than one generating with the eight-bit format that moves twice the
//  bytes -- 1.870 s against 1.281 for sixty-four tokens, which is what said
//  the loads and not the bytes were the cost.
//
//  The shift is the run's offset within its first word and is the same for
//  every block of a row, so a caller works it out once and passes it in.
//  Zero is its own case because a shift of thirty-two is undefined.
uint word_of(uint at_word, uint shift) {
    uint first = w[at_word];

    return shift == 0u
         ? first
         : (first >> shift) | (w[at_word + 1u] << (32u - shift));
}

//  One byte read as a signed number, which is how Q8_0 keeps a quant and
//  Q6_K keeps a sub-block scale.
int signed_at(uint at) {
    int value = int(byte_at(at));
    return value > 127 ? value - 256 : value;
}

//  Four signed bytes out of one word, in the order they lie.
//
//  The same four values signed_at would give for four consecutive addresses,
//  and about a quarter of the work: one load and two shifts an element,
//  against a load, a shift, a mask, a compare and a subtract each. Shifting
//  a byte to the top of a signed integer and back down is what sign-extends
//  it, and it is exact where the unpacking built into the language is not --
//  unpackSnorm4x8 clamps, and would turn a quant of -128 into -127 without
//  saying so.
//
//  The decode is worth measuring rather than assuming: building this shader
//  with the eight-bit branch's decode replaced by a constant takes the
//  device prompt from 0.573 s to 0.427, so unpacking is about a quarter of
//  what this spends.
//  Kept as four expressions at the point of use rather than a vector
//  returned from here: a vector of four returned across a call is a vector
//  the compiler put in memory, and doing that measured sixteen per cent
//  worse than the byte-at-a-time decode it was meant to replace.

//  A half-precision number, which is how every packed format writes a scale
//  and how F16 writes a weight.
float half_at(uint at) {
    return unpackHalf2x16(byte_at(at) | (byte_at(at + 1u) << 8u)).x;
}

//  Bytes one row takes, which is what says where the next row starts.
uint row_bytes() {
    switch (shape.format) {
        case FMT_F32:  return shape.columns * 4u;
        case FMT_F16:
        case FMT_BF16: return shape.columns * 2u;

        case FMT_Q4_0:
        case FMT_IQ4_NL: return (shape.columns / 32u) * 18u;
        case FMT_Q4_1:   return (shape.columns / 32u) * 20u;
        case FMT_Q5_0:   return (shape.columns / 32u) * 22u;
        case FMT_Q5_1:   return (shape.columns / 32u) * 24u;
        case FMT_Q8_0:   return (shape.columns / 32u) * 34u;

        case FMT_Q2_K:   return (shape.columns / 256u) * 84u;
        case FMT_Q3_K:   return (shape.columns / 256u) * 110u;
        case FMT_Q4_K:   return (shape.columns / 256u) * 144u;
        case FMT_Q5_K:   return (shape.columns / 256u) * 176u;
        case FMT_Q6_K:   return (shape.columns / 256u) * 210u;
        default:         return (shape.columns / 256u) * 136u;
    }
}

//  The six-bit scale and minimum a Q4_K or Q5_K sub-block carries. Twelve
//  bytes hold sixteen six-bit numbers: the first four pairs whole in a byte
//  each, the last four split, four bits in one byte and two in the top of
//  another that a lower sub-block is already using.
void sub_block_scale(uint at, uint index, out uint factor, out uint lowest) {
    if (index < 4u) {
        factor = byte_at(at + index) & 63u;
        lowest = byte_at(at + index + 4u) & 63u;
    } else {
        factor = (byte_at(at + index + 4u) & 15u)
                 | ((byte_at(at + index - 4u) >> 6u) << 4u);
        lowest = (byte_at(at + index + 4u) >> 4u)
                 | ((byte_at(at + index) >> 6u) << 4u);
    }
}

void main() {
    //  Every lane of a cluster takes the same row, so what follows is
    //  uniform across a cluster.
    //
    //  The lanes past the last row are clamped onto it rather than sent
    //  home, and that is not tidiness: there is a barrier at the end of this
    //  and a workgroup some of whose invocations returned before reaching it
    //  is undefined. They compute a row that is already being computed and
    //  the write below drops it.
    uint wanted = gl_GlobalInvocationID.x / LANES;
    uint row = min(wanted, shape.rows - 1u);
    uint part = gl_GlobalInvocationID.x % LANES;

    //  The ones past the end of the batch read the last real vector rather
    //  than reading nothing: the loops below have to have a constant trip
    //  count to unroll, and a result nobody writes out is cheaper than a
    //  branch every element.
    //  Which member of a gather this workgroup computes, and the slice
    //  and the vector that member reads. Zero, and nothing, for a plain
    //  product.
    uint member = gl_WorkGroupID.z;
    bool listed = shape.routed >= LISTED_BY_POSITION;
    uint which = listed ? member
               : shape.routed != 0u ? route[member] : shape.members[member];
    uint slice = which * shape.stride;

    //  A listed expert's run: how many positions and where they begin.
    //  An expert nobody chose has nothing to do, and every lane of its
    //  workgroup leaves together, which keeps the barrier below legal.
    uint experts = shape.members[0];
    uint run_count = listed ? route[member]
                            : min(GROUP, shape.count - shape.first);
    uint run_at = listed ? route[experts + member] : 0u;
    uint list_at = 2u * experts;

    if (run_count == 0u) {
        return;
    }

    uint base = shape.base + slice + row * row_bytes();

    //  A plain product is one group of vectors; a listed run is as many
    //  groups as it takes, the row read again for each. The body of this
    //  loop is the whole of the kernel below and is not indented for it.
    for (uint chunk = 0u; chunk < run_count; chunk += GROUP) {

    for (uint k = 0u; k < GROUP; ++k) {
        if (listed) {
            uint slot = run_at + min(chunk + k, run_count - 1u);
            from[k] = (shape.routed == LISTED_BY_POSITION
                       ? route[list_at + slot] : slot) * shape.columns;
        } else {
            from[k] = min(shape.first + k, shape.count - 1u) * shape.columns
                      + member * shape.apart;
        }
        sum[k] = 0.0;
    }

    if (shape.format == FMT_F32) {
        //  Words rather than bytes, which the base allows because both the
        //  alignment a device asks of a host pointer and the alignment this
        //  backend asks of a tensor are multiples of four.
        uint at = base >> 2u;

        for (uint col = part; col < shape.columns; col += LANES) {
            accumulate(col, uintBitsToFloat(w[at + col]));
        }
    } else if (shape.format == FMT_F16) {
        for (uint col = part; col < shape.columns; col += LANES) {
            accumulate(col, half_at(base + col * 2u));
        }
    } else if (shape.format == FMT_BF16) {
        //  The top half of a binary32: the same sign and the same eight
        //  exponent bits, with the mantissa cut to seven. Widening it is a
        //  shift and nothing else -- no exponent to rebias, and no case for
        //  infinity or not-a-number, because those patterns are already
        //  where binary32 keeps them.
        for (uint col = part; col < shape.columns; col += LANES) {
            uint at = base + col * 2u;
            uint bits = (byte_at(at) | (byte_at(at + 1u) << 8u)) << 16u;
            accumulate(col, uintBitsToFloat(bits));
        }
    } else if (shape.format == FMT_Q8_0) {
        //  Thirty-two signed bytes behind one scale.
        uint blocks = shape.columns / 32u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * 34u;
            float scale = half_at(at);
            uint col = b * 32u;

            //  Where this block's quants begin, as a word and an offset
            //  into it. A block is thirty-four bytes, so consecutive blocks
            //  alternate between starting on a word and starting two bytes
            //  into one; that is the only case there is, and it is decided
            //  once a block rather than once an element.
            uint q = at + 2u;
            uint at_word = q >> 2u;

            //  Two bytes in or none, chosen once and applied by shifting
            //  rather than by branching in the loop.
            uint low = (q & 3u) * 8u;

            for (uint g = 0u; g < 8u; ++g) {
                uint first = w[at_word + g];
                uint word = low == 0u
                          ? first
                          : (first >> low)
                            | (w[at_word + g + 1u] << (32u - low));

                accumulate(col + g * 4u,      scale * float(int(word << 24) >> 24));
                accumulate(col + g * 4u + 1u, scale * float(int(word << 16) >> 24));
                accumulate(col + g * 4u + 2u, scale * float(int(word <<  8) >> 24));
                accumulate(col + g * 4u + 3u, scale * float(int(word) >> 24));
            }
        }
    } else if (shape.format == FMT_Q4_0) {
        //  Thirty-two nibbles behind one scale, the low half of each byte
        //  belonging to element j and the high half to element j + 16, and
        //  centred by taking eight away.
        uint blocks = shape.columns / 32u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * 18u;
            float scale = half_at(at);
            uint col = b * 32u;

            for (uint j = 0u; j < 16u; ++j) {
                uint packed = byte_at(at + 2u + j);
                accumulate(col + j, scale * (float(packed & 15u) - 8.0));
                accumulate(col + j + 16u, scale * (float(packed >> 4u) - 8.0));
            }
        }
    } else if (shape.format == FMT_Q4_1) {
        //  As Q4_0, with a minimum of its own instead of a fixed bias of
        //  eight: a nibble is scaled and then lifted rather than centred.
        uint blocks = shape.columns / 32u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * 20u;
            float scale = half_at(at);
            float lowest = half_at(at + 2u);
            uint col = b * 32u;

            for (uint j = 0u; j < 16u; ++j) {
                uint packed = byte_at(at + 4u + j);
                accumulate(col + j, scale * float(packed & 15u) + lowest);
                accumulate(col + j + 16u,
                           scale * float(packed >> 4u) + lowest);
            }
        }
    } else if (shape.format == FMT_Q5_0 || shape.format == FMT_Q5_1) {
        //  A fifth bit for each element, held apart from the nibbles in four
        //  bytes read as one number: bit j belongs to element j and bit
        //  j + 16 to element j + 16. The two formats differ only in what
        //  happens once it is restored -- Q5_0 centres the result by taking
        //  sixteen away, as Q4_0 takes eight, and Q5_1 carries a minimum
        //  instead, as Q4_1 does.
        bool centred = shape.format == FMT_Q5_0;
        uint stride = centred ? 22u : 24u;
        uint fifths_at = centred ? 2u : 4u;
        uint quants_at = centred ? 6u : 8u;
        float bias = centred ? 16.0 : 0.0;

        uint blocks = shape.columns / 32u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * stride;
            float scale = half_at(at);
            float lowest = centred ? 0.0 : half_at(at + 2u);
            uint col = b * 32u;

            uint fifths = byte_at(at + fifths_at)
                          | (byte_at(at + fifths_at + 1u) << 8u)
                          | (byte_at(at + fifths_at + 2u) << 16u)
                          | (byte_at(at + fifths_at + 3u) << 24u);

            for (uint j = 0u; j < 16u; ++j) {
                uint packed = byte_at(at + quants_at + j);
                float low = float((packed & 15u) + ((fifths >> j) & 1u) * 16u);
                float high = float((packed >> 4u)
                                   + ((fifths >> (j + 16u)) & 1u) * 16u);

                accumulate(col + j, scale * (low - bias) + lowest);
                accumulate(col + j + 16u, scale * (high - bias) + lowest);
            }
        }
    } else if (shape.format == FMT_IQ4_NL) {
        //  Laid out exactly as Q4_0 lays its nibbles. What differs is what a
        //  nibble means: an index into the level table rather than a number
        //  to centre on eight.
        uint blocks = shape.columns / 32u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * 18u;
            float scale = half_at(at);
            uint col = b * 32u;

            for (uint j = 0u; j < 16u; ++j) {
                uint packed = byte_at(at + 2u + j);
                accumulate(col + j, scale * float(LEVELS[packed & 15u]));
                accumulate(col + j + 16u, scale * float(LEVELS[packed >> 4u]));
            }
        }
    } else if (shape.format == FMT_Q2_K) {
        //  Sixteen bytes of packed scales, then sixty-four bytes of quants at
        //  two bits each, then the two half-precision factors. Every element
        //  is one of four levels, so the format leans harder on its scales
        //  than any other: sixteen sub-blocks of sixteen elements, each with
        //  a four-bit scale and a four-bit minimum sharing one byte.
        uint blocks = shape.columns / 256u;

        //  A slice of the same super-block to every lane, and the quant
        //  bytes read once for the four groups that share them.
        //
        //  at_byte does not depend on the group -- the four groups are four
        //  two-bit fields of the same sixteen bytes -- so reading inside the
        //  group loop read them four times over. Eight lanes divide the four
        //  side-and-half pairs in two, so a lane holds two words and takes
        //  four groups out of them.
        uint pair = part >> 1u;
        uint side = pair >> 1u;
        uint upper = pair & 1u;
        uint whole = part & 1u;

        for (uint b = 0u; b < blocks; ++b) {
            uint at = base + b * 84u;
            uint quants = at + 16u;
            uint col0 = b * 256u;

            //  Five loads a block where there were ten. The two factors
            //  are one word, unpacked as the pair of halves they are; the
            //  four scale bytes this lane reads lie within eight bytes,
            //  two words; the quants were two words already. Reading a
            //  byte through byte_at is a word load each, and on this part
            //  the eight-bit and the two-bit format both ran at about the
            //  same loads a second -- which for the eight-bit one was the
            //  memory's rate and for this one was half of it.
            uint dm_at = at + 80u;
            vec2 dm = unpackHalf2x16(word_of(dm_at >> 2u, (dm_at & 3u) * 8u));
            float d = dm.x;
            float dmin = dm.y;

            uint scales_at = at + side * 8u + upper;
            uint scales_shift = (scales_at & 3u) * 8u;
            uint s0 = word_of(scales_at >> 2u, scales_shift);
            uint s1 = word_of((scales_at >> 2u) + 1u, scales_shift);

            uint at_byte = quants + side * 32u + upper * 16u + whole * 8u;
            uint shift_at = (at_byte & 3u) * 8u;

            uint w0 = word_of((at_byte >> 2u), shift_at);
            uint w1 = word_of((at_byte >> 2u) + 1u, shift_at);

            for (uint group = 0u; group < 4u; ++group) {
                //  The scales are consumed in the order the sub-blocks are
                //  written: this lane's four are two bytes apart, at
                //  side * 8 + upper and after.
                uint packed = group < 2u
                              ? (s0 >> (16u * group)) & 255u
                              : (s1 >> (16u * (group - 2u))) & 255u;

                float factor = d * float(packed & 15u);
                float lowest = dmin * float(packed >> 4u);

                uint into = col0 + side * 128u + group * 32u + upper * 16u
                            + whole * 8u;
                uint shift = 2u * group;

                //  The minimum factored out of the sum, and four quants
                //  taken out of a word at once.
                //
                //  Every weight of a sub-block is factor * q - lowest, so
                //  its eight terms against the activation are
                //  factor * (sum of q * x) - lowest * (sum of x): one
                //  multiply-add a weight for the first sum and one add for
                //  the second, and the two factors applied once for the
                //  eight. Applied a weight at a time it was a multiply, a
                //  subtract and a multiply-add each, and the quant itself
                //  was two shifts, a mask and a convert; unpack8 turns the
                //  four bytes of a masked word into four numbers in one
                //  step. This format decodes a byte into four weights, so
                //  the decode is what a two-bit product spends its time on
                //  -- it streamed at half the eight-bit format's rate on
                //  this part -- and llama.cpp's own kernel factors the same
                //  way for the same reason.
                //
                //  The association differs from a weight at a time, so the
                //  last bits differ; nothing holds this kernel to the bit
                //  against anything but itself.
                vec4 q0 = vec4(unpack8((w0 >> shift) & 0x03030303u));
                vec4 q1 = vec4(unpack8((w1 >> shift) & 0x03030303u));

                for (uint k = 0u; k < GROUP; ++k) {
                    uint at_x = (from[k] + into) >> 2u;
                    vec4 x0 = x4[at_x];
                    vec4 x1 = x4[at_x + 1u];

                    float quants_x = dot(q0, x0) + dot(q1, x1);
                    float all_x = dot(x0, vec4(1.0)) + dot(x1, vec4(1.0));

                    sum[k] += factor * quants_x - lowest * all_x;
                }
            }
        }
    } else if (shape.format == FMT_Q3_K) {
        //  Three bits an element, in two pieces. The low two are packed four
        //  to a byte as in the two-bit format; the third lives in a mask of
        //  thirty-two bytes shared by the whole block, and it is the bit's
        //  absence that lowers the value: set leaves the two low bits alone,
        //  clear takes four away, which is what makes the range minus four
        //  to three rather than zero to seven.
        //
        //  The lanes are dealt as the two-bit format deals them: a lane
        //  holds two words of quants and the two words of the mask that
        //  go with them -- eight bytes each, bytes side * 32 + upper * 16
        //  + whole * 8 of the quants and upper * 16 + whole * 8 of the
        //  mask -- and takes four groups out of them, four loads a block
        //  where a byte at a time was eighty. It was dealt a half and a
        //  group a lane before that, eight words of quants and eight of
        //  mask a lane, the four lanes of a half reading the same words:
        //  twenty word loads a block a lane for what four hold, and the
        //  device's clock read this format at 45-52 GB/s where the
        //  two-bit format reads 58-70. The scales are three words a
        //  block, read once.
        //
        //  The weight is factor * (q + 4 * lifted - 4), formed four at a
        //  time out of a quant word and a mask word by unpack8; the
        //  association differs from a weight at a time, and nothing holds
        //  this kernel to the bit against anything but itself.
        uint blocks = shape.columns / 256u;

        uint pair = part >> 1u;
        uint side = pair >> 1u;
        uint upper = pair & 1u;
        uint whole = part & 1u;

        for (uint b = 0u; b < blocks; ++b) {
            uint at = base + b * 110u;
            uint col0 = b * 256u;

            //  A hundred and ten bytes is not a whole number of words, so
            //  every other block begins half way into one; word_of takes
            //  the shift once a run.
            uint d_at = at + 108u;
            float d = unpackHalf2x16(word_of(d_at >> 2u, (d_at & 3u) * 8u)).x;

            uint scales_at = at + 96u;
            uint scales_shift = (scales_at & 3u) * 8u;
            uint sw0 = word_of(scales_at >> 2u, scales_shift);
            uint sw1 = word_of((scales_at >> 2u) + 1u, scales_shift);
            uint sw2 = word_of((scales_at >> 2u) + 2u, scales_shift);

            uint q_byte = at + 32u + side * 32u + upper * 16u + whole * 8u;
            uint q_shift = (q_byte & 3u) * 8u;
            uint w0 = word_of(q_byte >> 2u, q_shift);
            uint w1 = word_of((q_byte >> 2u) + 1u, q_shift);

            uint m_byte = at + upper * 16u + whole * 8u;
            uint m_shift = (m_byte & 3u) * 8u;
            uint m0 = word_of(m_byte >> 2u, m_shift);
            uint m1 = word_of((m_byte >> 2u) + 1u, m_shift);

            for (uint group = 0u; group < 4u; ++group) {
                //  This sub-block's scale: four low bits in one of the
                //  first eight bytes and two high bits in one of the last
                //  four, made signed by subtracting thirty-two, out of
                //  the three words above.
                uint sub = side * 8u + group * 2u + upper;
                uint s_group = sub >> 2u;
                uint place = sub & 3u;
                uint low_index = (s_group & 1u) == 0u ? place : place + 4u;
                uint low_byte = low_index < 4u
                                ? (sw0 >> (8u * low_index)) & 255u
                                : (sw1 >> (8u * (low_index - 4u))) & 255u;
                uint low = s_group < 2u ? (low_byte & 15u) : (low_byte >> 4u);
                uint top = ((sw2 >> (8u * place)) >> (2u * s_group)) & 3u;
                float factor = d * float(int(low) + 16 * int(top) - 32);

                uint into = col0 + side * 128u + group * 32u + upper * 16u
                            + whole * 8u;
                uint shift = 2u * group;
                uint bit = side * 4u + group;

                vec4 q0 = vec4(unpack8((w0 >> shift) & 0x03030303u))
                          + 4.0 * vec4(unpack8((m0 >> bit) & 0x01010101u))
                          - 4.0;
                vec4 q1 = vec4(unpack8((w1 >> shift) & 0x03030303u))
                          + 4.0 * vec4(unpack8((m1 >> bit) & 0x01010101u))
                          - 4.0;

                for (uint k = 0u; k < GROUP; ++k) {
                    uint at_x = (from[k] + into) >> 2u;
                    sum[k] += factor * (dot(q0, x4[at_x])
                                        + dot(q1, x4[at_x + 1u]));
                }
            }
        }
    } else if (shape.format == FMT_Q4_K) {
        //  Eight sub-blocks of thirty-two elements, processed in pairs that
        //  share the same thirty-two packed bytes: the low nibbles form the
        //  first sub-block and the high nibbles the second.
        uint blocks = shape.columns / 256u;

        //  Every lane of the row takes a slice of the same super-block
        //  rather than a super-block of its own.
        //
        //  A super-block is a hundred and forty-four bytes, so a lane a
        //  block meant that the eight lanes sharing a row fetched from
        //  eight addresses a hundred and forty-four bytes apart -- eight
        //  cache lines to read thirty-two bytes, and again for the next
        //  word. Sharing the block, the eight lanes read thirty-two
        //  consecutive words. An ablation put the weight loads at
        //  twenty-seven per cent of this format's generating time, which is
        //  what made the arrangement worth changing rather than the
        //  arithmetic inside it.
        //
        //  Eight lanes divide a super-block as four groups of two halves,
        //  which needs LANES to be eight; it is, and the reduction at the
        //  end of this shader is written for the same eight.
        uint group = part >> 1u;
        uint upper = part & 1u;

        for (uint b = 0u; b < blocks; ++b) {
            uint at = base + b * 144u;
            float d = half_at(at);
            float dmin = half_at(at + 2u);
            uint scales = at + 4u;
            uint quants = at + 16u;
            uint col0 = b * 256u;

            //  A hundred and forty-four bytes is a whole number of words,
            //  so every run of quants in this row begins the same distance
            //  into a word and the shift is worked out once.
            uint shift = (quants & 3u) * 8u;

            uint sub = group * 2u;

            uint f1, m1, f2, m2;
            sub_block_scale(scales, sub, f1, m1);
            sub_block_scale(scales, sub + 1u, f2, m2);

            //  A sub-block's scale and offset are the same for all
            //  thirty-two of its elements, so they are formed once here
            //  rather than in the loop.
            float scale_1 = d * float(f1);
            float scale_2 = d * float(f2);
            float offset_1 = dmin * float(m1);
            float offset_2 = dmin * float(m2);

            uint at_word = (quants + group * 32u + upper * 16u) >> 2u;
            uint into = col0 + group * 64u;

            for (uint g = 0u; g < 4u; ++g) {
                uint word = word_of(at_word + g, shift);

                //  The word's four low nibbles and its four high ones,
                //  each set turned into four numbers in one go.
                vec4 low_4 = vec4 (unpack8 (word & 0x0F0F0F0Fu));
                vec4 high_4 = vec4 (unpack8 ((word >> 4u) & 0x0F0F0F0Fu));

                uint at_low = into + upper * 16u + g * 4u;

                for (uint n = 0u; n < 4u; ++n) {
                    accumulate (at_low + n, scale_1 * low_4[n] - offset_1);
                    accumulate (at_low + 32u + n,
                                scale_2 * high_4[n] - offset_2);
                }
            }
        }
    } else if (shape.format == FMT_Q5_K) {
        //  As Q4_K plus thirty-two bytes carrying the fifth bit of each
        //  quant, two bits of each byte serving one pair of sub-blocks.
        uint blocks = shape.columns / 256u;

        //  A slice of the same super-block to every lane, as Q4_K above
        //  and for the same reason: a lane a block put the eight lanes of a
        //  row a hundred and seventy-six bytes apart.
        uint group = part >> 1u;
        uint upper = part & 1u;

        uint mask_low = 1u << (2u * group);
        uint mask_high = 2u << (2u * group);

        for (uint b = 0u; b < blocks; ++b) {
            uint at = base + b * 176u;
            float d = half_at(at);
            float dmin = half_at(at + 2u);
            uint scales = at + 4u;
            uint high = at + 16u;
            uint quants = at + 48u;
            uint col0 = b * 256u;

            //  A hundred and seventy-six bytes is a whole number of words,
            //  so the offset within a word is the row's, and the fifth-bit
            //  run begins a whole number of words from the quants.
            uint shift = (quants & 3u) * 8u;

            uint sub = group * 2u;

            uint f1, m1, f2, m2;
            sub_block_scale(scales, sub, f1, m1);
            sub_block_scale(scales, sub + 1u, f2, m2);

            float scale_1 = d * float(f1);
            float scale_2 = d * float(f2);
            float offset_1 = dmin * float(m1);
            float offset_2 = dmin * float(m2);

            uint at_word = (quants + group * 32u + upper * 16u) >> 2u;
            uint high_word = (high + upper * 16u) >> 2u;
            uint into = col0 + group * 64u;

            //  Two runs of four words: the quants and the bytes carrying
            //  their fifth bit. A lane reads only the sixteen of each that
            //  its own sixteen elements need, so what was read four times
            //  over for four groups is read once.
            for (uint g = 0u; g < 4u; ++g) {
                uint word  = word_of(at_word + g, shift);
                uint fifth = word_of(high_word + g, shift);

                for (uint n = 0u; n < 4u; ++n) {
                    uint packed = (word >> (n * 8u)) & 255u;
                    uint bits = (fifth >> (n * 8u)) & 255u;
                    uint L = upper * 16u + g * 4u + n;

                    float low = float((packed & 15u)
                                      + ((bits & mask_low) != 0u
                                         ? 16u : 0u));
                    float up = float((packed >> 4u)
                                     + ((bits & mask_high) != 0u
                                        ? 16u : 0u));

                    accumulate(into + L, scale_1 * low - offset_1);
                    accumulate(into + 32u + L, scale_2 * up - offset_2);
                }
            }
        }
    } else if (shape.format == FMT_Q6_K) {
        //  Two halves of 128 elements. Within a half, each of the thirty-two
        //  positions contributes four elements whose two high bits come from
        //  one byte of the high-bit array, and each of the four has a signed
        //  sub-block scale of its own.
        uint blocks = shape.columns / 256u;

        //  A slice of the same super-block to every lane, as the two
        //  k-quants above. Two hundred and ten bytes a block put the eight
        //  lanes of a row that far apart when each took a block of its own.
        //
        //  The eight divide as four units -- two sides of two sub-runs --
        //  and each unit's sixteen positions in half.
        uint unit = part >> 1u;
        uint upper = part & 1u;
        uint side = unit >> 1u;
        uint sub = unit & 1u;

        for (uint b = 0u; b < blocks; ++b) {
            uint at = base + b * 210u;
            float d = half_at(at + 208u);
            uint col0 = b * 256u;

            uint low_half = at + side * 64u;
            uint high_half = at + 128u + side * 32u;
            uint scale_half = at + 192u + side * 8u;
            uint out_half = col0 + side * 128u;

            uint low_run = low_half + sub * 16u;
            uint high_run = high_half + sub * 16u;
            uint out_run = out_half + sub * 16u;

            float scale_1 = d * float(signed_at(scale_half + sub));
            float scale_2 = d * float(signed_at(scale_half + sub + 2u));
            float scale_3 = d * float(signed_at(scale_half + sub + 4u));
            float scale_4 = d * float(signed_at(scale_half + sub + 6u));

            //  Three runs of two words: the low nibbles of two sub-runs and
            //  the byte carrying the pairs of high bits. Two hundred and
            //  ten is not a multiple of four, so consecutive blocks begin
            //  at different offsets within a word and each run's shift is
            //  worked out here rather than once for the row.
            uint at_first = low_run + upper * 8u;
            uint at_second = low_run + 32u + upper * 8u;
            uint at_top = high_run + upper * 8u;

            uint shift_first = (at_first & 3u) * 8u;
            uint shift_second = (at_second & 3u) * 8u;
            uint shift_top = (at_top & 3u) * 8u;

            for (uint g = 0u; g < 2u; ++g) {
                uint w_first = word_of((at_first >> 2u) + g, shift_first);
                uint w_second = word_of((at_second >> 2u) + g, shift_second);
                uint w_top = word_of((at_top >> 2u) + g, shift_top);

                //  Four at a time, as the two above: three runs of bytes
                //  become three sets of four numbers in three unpacks.
                uvec4 first_4 = uvec4 (unpack8 (w_first));
                uvec4 second_4 = uvec4 (unpack8 (w_second));
                uvec4 top_4 = uvec4 (unpack8 (w_top));

                uint at_run = out_run + upper * 8u + g * 4u;

                for (uint n = 0u; n < 4u; ++n) {
                    uint first = first_4[n];
                    uint second = second_4[n];
                    uint top = top_4[n];

                    accumulate(at_run + n,
                               scale_1 * (float((first & 15u)
                                                + 16u * (top & 3u))
                                          - 32.0));
                    accumulate(at_run + 32u + n,
                               scale_2 * (float((second & 15u)
                                                + 16u * ((top >> 2u) & 3u))
                                          - 32.0));
                    accumulate(at_run + 64u + n,
                               scale_3 * (float((first >> 4u)
                                                + 16u * ((top >> 4u) & 3u))
                                          - 32.0));
                    accumulate(at_run + 96u + n,
                               scale_4 * (float((second >> 4u)
                                                + 16u * ((top >> 6u) & 3u))
                                          - 32.0));
                }
            }
        }
    } else {
        //  IQ4_XS: the non-linear levels over a super-block. Eight
        //  sub-blocks of thirty-two, one half-precision scale for the whole
        //  block and a six-bit scale for each sub-block -- four bits in a
        //  nibble of the scale bytes and two in the shared word, signed by
        //  taking thirty-two away.
        uint blocks = shape.columns / 256u;

        for (uint b = part; b < blocks; b += LANES) {
            uint at = base + b * 136u;
            float d = half_at(at);
            uint high = byte_at(at + 2u) | (byte_at(at + 3u) << 8u);
            uint low = at + 4u;
            uint quants = at + 8u;
            uint col0 = b * 256u;

            for (uint sub = 0u; sub < 8u; ++sub) {
                uint nibble = sub % 2u == 0u
                              ? (byte_at(low + sub / 2u) & 15u)
                              : (byte_at(low + sub / 2u) >> 4u);
                uint upper = (high >> (2u * sub)) & 3u;
                float step = d * (float(nibble + 16u * upper) - 32.0);

                uint at_byte = quants + sub * 16u;
                uint into = col0 + sub * 32u;

                for (uint j = 0u; j < 16u; ++j) {
                    uint packed = byte_at(at_byte + j);
                    accumulate(into + j, step * float(LEVELS[packed & 15u]));
                    accumulate(into + j + 16u,
                               step * float(LEVELS[packed >> 4u]));
                }
            }
        }
    }

    //  Only the vectors this dispatch was given. The rest are the padding
    //  above and belong to nobody.
    //  What this lane holds is its eighth of the row. The add is outside
    //  the test below because every lane of the cluster has to reach it.
    uint taken = min(GROUP, run_count - chunk);

    for (uint k = 0u; k < GROUP; ++k) {
        shares[gl_LocalInvocationID.x * GROUP + k] = sum[k];
    }

    barrier();

    //  One lane of each cluster adds its row up and writes it. The others
    //  have nothing left to do for this group, and reached the barrier
    //  before the one below, which keeps the next group's shares from
    //  landing on what this one is still reading.
    if (part == 0u && wanted < shape.rows) {
        for (uint k = 0u; k < GROUP; ++k) {
            if (k < taken) {
                float whole = 0.0;
                for (uint lane = 0u; lane < LANES; ++lane) {
                    whole += shares[(gl_LocalInvocationID.x + lane) * GROUP
                                    + k];
                }
                uint out_at = listed
                              ? (run_at + chunk + k) * shape.rows + row
                              : member * shape.rows * shape.count
                                + (shape.first + k) * shape.rows + row;

                y[out_at] = shape.joins != 0u ? whole + rj[out_at] : whole;
            }
        }
    }

    barrier();

    }
}
