//  Byte j of a grid entry of eight.
uint grid_byte(uvec2 entry, uint j) {
    return ((j < 4u ? entry.x : entry.y) >> (8u * (j & 3u))) & 255u;
}

//  The same byte read signed, which is what an IQ1 grid holds.
float grid_signed(uvec2 entry, uint j) {
    int value = int(grid_byte(entry, j));
    return float(value > 127 ? value - 256 : value);
}

//  The sign pattern a seven-bit index names: the seven bits, and an eighth
//  that makes the count of set bits even. ggml keeps it as a table of 128;
//  this is what the table holds.
uint ksign(uint index) {
    return index | ((bitCount(index) & 1u) << 7u);
}

//  Minus one when bit j of a sign pattern is set.
float sign_of(uint signs, uint j) {
    return ((signs >> j) & 1u) != 0u ? -1.0 : 1.0;
}

//  A little-endian sixteen- and thirty-two-bit field of the weights.
uint half_word_at(uint at) {
    return byte_at(at) | (byte_at(at + 1u) << 8u);
}

uint word_at(uint at) {
    return half_word_at(at) | (half_word_at(at + 2u) << 16u);
}

//  An NVFP4 scale: an unsigned E4M3 float, the top bit unread, nought and
//  16#7F# zero, halved -- which takes the doubling of FOURS back out.
float e4m3_at(uint at) {
    uint code = byte_at(at);
    uint exponent = (code >> 3u) & 15u;
    float mantissa = float(code & 7u);

    if (code == 0u || code == 0x7Fu) {
        return 0.0;
    }
    return exponent == 0u
           ? mantissa * exp2(-10.0)
           : (1.0 + mantissa / 8.0) * exp2(float(exponent) - 8.0);
}

//  Bytes one row takes, which is what says where the next row starts.
uint row_bytes() {
    switch (shape.format) {
        case FMT_IQ3_S:   return (shape.columns / 256u) * 110u;
        case FMT_IQ2_XXS: return (shape.columns / 256u) * 66u;
        case FMT_IQ2_XS:  return (shape.columns / 256u) * 74u;
        case FMT_IQ2_S:   return (shape.columns / 256u) * 82u;
        case FMT_IQ3_XXS: return (shape.columns / 256u) * 98u;
        case FMT_IQ1_S:   return (shape.columns / 256u) * 50u;
        case FMT_IQ1_M:   return (shape.columns / 256u) * 56u;
        case FMT_TQ1_0:   return (shape.columns / 256u) * 54u;
        case FMT_TQ2_0:   return (shape.columns / 256u) * 66u;
        case FMT_Q1_0:    return (shape.columns / 128u) * 18u;
        case FMT_Q2_0:    return (shape.columns / 64u) * 18u;
        default:          return (shape.columns / 64u) * 36u;
    }
}
