#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_arithmetic : require

//  The generating row product for the twelve low-bit formats, on a subgroup
//  of thirty-two: compiled once a format, the format named by a define, so
//  each pipeline carries its own decode and codebook and nothing else.
//
//  Sixteen lanes share a group of 256 elements and a workgroup has two groups
//  in flight; a lane takes sixteen elements one after another, which for
//  every format here lies in one block and one run of its fields, and dots
//  them with four vec4s of the activation. Where a format's value is a grid
//  magnitude and a sign, the sign is a select with a negated operand and the
//  product a fused multiply-add -- three operations an element; where it adds
//  a constant to every element of a run (the ternary formats, IQ1's shift),
//  the constant multiplies the run's activation sum once. The subgroup adds
//  the partials, and a workgroup answers NUM_ROWS rows.
//
//  A lane finds its block from its column, so the formats of sixty-four and
//  a hundred and twenty-eight elements need no width a multiple of 256: a
//  group past the end of a row is skipped lane by lane.

#ifndef NUM_ROWS
#define NUM_ROWS 2u
#endif

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Weights  { uint  w[]; };
layout(std430, binding = 1) readonly  buffer Vectors4 { vec4  x4[]; };
layout(std430, binding = 2) writeonly buffer Result   { float y[]; };
layout(std430, binding = 3) readonly  buffer Routing  { uint  route[]; };
layout(std430, binding = 4) readonly  buffer Residual { float rj[]; };

const uint LISTED_BY_POSITION = 2u;

layout(push_constant) uniform Shape {
    uint rows;
    uint columns;
    uint count;
    uint first;
    uint format;
    uint base;
    uint joins;
    uint table;
    uint members[16];
    uint stride;
    uint apart;
    uint routed;
} shape;

//  One byte, a sixteen-bit field at an even position, and a half there.
uint byte_at(uint at) {
    return (w[at >> 2u] >> ((at & 3u) * 8u)) & 255u;
}

uint u16_at(uint at) {
    return (w[at >> 2u] >> ((at & 2u) * 8u)) & 0xFFFFu;
}

uint u32_at(uint at) {
    return u16_at(at) | (u16_at(at + 2u) << 16u);
}

//  Four bytes from any position, as one word: two loads and a funnel where
//  the run is not on a word, one where it is.
uint quad_at(uint at) {
    uint shift = (at & 3u) * 8u;
    uint first = w[at >> 2u];
    return shift == 0u ? first
                       : (first >> shift) | (w[(at >> 2u) + 1u] << (32u - shift));
}

float half_at(uint at) {
    return unpackHalf2x16(u16_at(at)).x;
}

//  The sign pattern a seven-bit index names: the index and its parity.
uint ksign(uint index) {
    return index | ((bitCount(index) & 1u) << 7u);
}

//  Eight unsigned magnitudes -- the four bytes of lo, then of hi -- against
//  eight activations, each negated where its bit of signs is set.
float signed_dot(uint lo, uint hi, uint signs, vec4 a, vec4 b) {
    vec4 g0 = vec4(unpack8(lo));
    vec4 g1 = vec4(unpack8(hi));
    float sum = 0.0;
    sum = fma(a.x, (signs & 1u)   != 0u ? -g0.x : g0.x, sum);
    sum = fma(a.y, (signs & 2u)   != 0u ? -g0.y : g0.y, sum);
    sum = fma(a.z, (signs & 4u)   != 0u ? -g0.z : g0.z, sum);
    sum = fma(a.w, (signs & 8u)   != 0u ? -g0.w : g0.w, sum);
    sum = fma(b.x, (signs & 16u)  != 0u ? -g1.x : g1.x, sum);
    sum = fma(b.y, (signs & 32u)  != 0u ? -g1.y : g1.y, sum);
    sum = fma(b.z, (signs & 64u)  != 0u ? -g1.z : g1.z, sum);
    sum = fma(b.w, (signs & 128u) != 0u ? -g1.w : g1.w, sum);
    return sum;
}

//  Eight signed bytes -- IQ1's grid -- against eight activations.
float plain_dot(uint lo, uint hi, vec4 a, vec4 b) {
    return dot(a, vec4(unpack8(int(lo)))) + dot(b, vec4(unpack8(int(hi))));
}

//  Four two-bit fields of a byte, the lowest first, as numbers.
vec4 fields4(uint byte) {
    return vec4(float(byte & 3u), float((byte >> 2u) & 3u),
                float((byte >> 4u) & 3u), float(byte >> 6u));
}

