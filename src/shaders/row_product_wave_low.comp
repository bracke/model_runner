//  An IQ1 grid entry packed as ggml's own GPU table packs it: eight values of
//  minus one to one, each lifted by one into two bits, sixteen bits an entry
//  and two entries a word -- a quarter of the room eight signed bytes take,
//  and one load where they took two.
uint iq1_entry(uint index) {
    return (IQ1S_PACKED[index >> 1u] >> ((index & 1u) * 16u)) & 0xFFFFu;
}

//  The eight lifted values of an entry against eight activations.
float lifted_dot(uint entry, vec4 a, vec4 b) {
    vec4 lo = vec4(float(bitfieldExtract(entry, 0, 2)),
                   float(bitfieldExtract(entry, 2, 2)),
                   float(bitfieldExtract(entry, 4, 2)),
                   float(bitfieldExtract(entry, 6, 2)));
    vec4 hi = vec4(float(bitfieldExtract(entry, 8, 2)),
                   float(bitfieldExtract(entry, 10, 2)),
                   float(bitfieldExtract(entry, 12, 2)),
                   float(bitfieldExtract(entry, 14, 2)));
    return dot(a, lo) + dot(b, hi);
}

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint sub = within / 32u;
    uint l = (within % 32u) / 8u;
    uint s0 = u16_at(at + 48u);
    uint s1 = u16_at(at + 50u);
    uint s2 = u16_at(at + 52u);
    uint s3 = u16_at(at + 54u);
    float d = unpackHalf2x16((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u)
                             | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u)).x;
    //  The sub-block's scale word is one of the four already read.
    uint pair = sub / 2u;
    uint word = pair == 0u ? s0 : pair == 1u ? s1 : pair == 2u ? s2 : s3;
    uint scale = (word >> (6u * (sub % 2u) + 3u * (l / 2u))) & 7u;
    float dl = d * float(2u * scale + 1u);
    uint nibbles = byte_at(at + 32u + 2u * sub + l / 2u);
    uint n0 = nibbles & 15u;
    uint n1 = nibbles >> 4u;
    uint q = at + 4u * sub + l;
    uint e0 = iq1_entry(byte_at(q)      | ((n0 & 7u) << 8u));
    uint e1 = iq1_entry(byte_at(q + 1u) | ((n1 & 7u) << 8u));
    float shift0 = (n0 & 8u) != 0u ? -0.125 : 0.125;
    float shift1 = (n1 & 8u) != 0u ? -0.125 : 0.125;
    return dl * (lifted_dot(e0, a0, a1) + lifted_dot(e1, a2, a3)
                 + (shift0 - 1.0) * dot(a0 + a1, vec4(1.0))
                 + (shift1 - 1.0) * dot(a2 + a3, vec4(1.0)));
}
