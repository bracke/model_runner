float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint sub = within / 32u;
    uint l = (within % 32u) / 8u;
    uint q = at + 2u + 8u * sub;
    uint aux0 = u32_at(q);
    uint aux1 = u32_at(q + 4u);
    float db = half_at(at) * (0.5 + float(aux1 >> 28u)) * 0.25;
    uvec2 g0 = uvec2(IQ2XXS_GRID[2u * ((aux0 >> (8u * l)) & 255u)], IQ2XXS_GRID[2u * ((aux0 >> (8u * l)) & 255u) + 1u]);
    uvec2 g1 = uvec2(IQ2XXS_GRID[2u * ((aux0 >> (8u * l + 8u)) & 255u)], IQ2XXS_GRID[2u * ((aux0 >> (8u * l + 8u)) & 255u) + 1u]);
    return db * (signed_dot(g0.x, g0.y, ksign((aux1 >> (7u * l)) & 127u), a0, a1)
               + signed_dot(g1.x, g1.y, ksign((aux1 >> (7u * l + 7u)) & 127u), a2, a3));
}
