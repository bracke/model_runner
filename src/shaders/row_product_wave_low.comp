float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint sub = within / 32u;
    uint l = (within % 32u) / 8u;
    uint s0 = u16_at(at + 48u);
    uint s1 = u16_at(at + 50u);
    uint s2 = u16_at(at + 52u);
    uint s3 = u16_at(at + 54u);
    float d = unpackHalf2x16((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u)
                             | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u)).x;
    uint word = u16_at(at + 48u + 2u * (sub / 2u));
    uint scale = (word >> (6u * (sub % 2u) + 3u * (l / 2u))) & 7u;
    float dl = d * float(2u * scale + 1u);
    uint nibbles = byte_at(at + 32u + 2u * sub + l / 2u);
    uint n0 = nibbles & 15u;
    uint n1 = nibbles >> 4u;
    uint q = at + 4u * sub + l;
    uvec2 g0 = uvec2(IQ1S_GRID[2u * (byte_at(q)      | ((n0 & 7u) << 8u))], IQ1S_GRID[2u * (byte_at(q)      | ((n0 & 7u) << 8u)) + 1u]);
    uvec2 g1 = uvec2(IQ1S_GRID[2u * (byte_at(q + 1u) | ((n1 & 7u) << 8u))], IQ1S_GRID[2u * (byte_at(q + 1u) | ((n1 & 7u) << 8u)) + 1u]);
    float shift0 = (n0 & 8u) != 0u ? -0.125 : 0.125;
    float shift1 = (n1 & 8u) != 0u ? -0.125 : 0.125;
    return dl * (plain_dot(g0.x, g0.y, a0, a1) + plain_dot(g1.x, g1.y, a2, a3)
                 + shift0 * dot(a0 + a1, vec4(1.0))
                 + shift1 * dot(a2 + a3, vec4(1.0)));
}
#endif

#ifdef TQ2_0
const uint BLOCK_ELEMS = 256u;
const uint BLOCK_BYTES = 66u;

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    //  Sixteen elements one after another share a run and a field: element
    //  e is byte 32 (e / 128) + e % 32, field (e % 128) / 32 -- so sixteen
    //  bytes in a row, read four at a time.
    uint byte0 = at + 32u * (within / 128u) + within % 32u;
    uint shift = 2u * ((within % 128u) / 32u);
    float sum = dot(a0, vec4((unpack8(quad_at(byte0))       >> shift) & 3u))
              + dot(a1, vec4((unpack8(quad_at(byte0 + 4u))  >> shift) & 3u))
              + dot(a2, vec4((unpack8(quad_at(byte0 + 8u))  >> shift) & 3u))
              + dot(a3, vec4((unpack8(quad_at(byte0 + 12u)) >> shift) & 3u));
    float total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    return half_at(at + 64u) * (sum - total);
}
#endif

#ifdef TQ1_0
const uint BLOCK_ELEMS = 256u;
const uint BLOCK_BYTES = 54u;

const uint POW3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

//  Digit place of four packed bytes, as numbers nought to two: the byte
//  times three to the place, wrapped at the byte, times three, its top.
vec4 trits4(uint bytes, uint pow3) {
    uvec4 b = uvec4(unpack8(bytes));
    return vec4((((b * pow3) & 255u) * 3u) >> 8u);
}

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    float sum;

    if (within < 240u) {
        //  Sixteen bytes in a row at one digit place: the first hundred and
        //  sixty elements are digit e / 32 of byte e % 32, the next eighty
        //  digit (e - 160) / 16 of byte 32 + (e - 160) % 16.
        uint byte0 = within < 160u ? at + within % 32u : at + 32u;
        uint pow3 = POW3[within < 160u ? within / 32u : (within - 160u) / 16u];
        sum = dot(a0, trits4(quad_at(byte0), pow3))
            + dot(a1, trits4(quad_at(byte0 + 4u), pow3))
            + dot(a2, trits4(quad_at(byte0 + 8u), pow3))
            + dot(a3, trits4(quad_at(byte0 + 12u), pow3));
    } else {
        //  The last sixteen: four bytes, digit (e - 240) / 4 of byte
        //  48 + (e - 240) % 4 -- each run of four one place across the four.
        uint bytes = quad_at(at + 48u);
        sum = dot(a0, trits4(bytes, 1u)) + dot(a1, trits4(bytes, 3u))
            + dot(a2, trits4(bytes, 9u)) + dot(a3, trits4(bytes, 27u));
    }

    float total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    return half_at(at + 52u) * (sum - total);
}
#endif

#ifdef Q1_0
const uint BLOCK_ELEMS = 128u;
const uint BLOCK_BYTES = 18u;


float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint bits = byte_at(at + 2u + within / 8u)
              | (byte_at(at + 3u + within / 8u) << 8u);
    vec4 a[4] = vec4[4](a0, a1, a2, a3);
    float sum = 0.0;
    for (uint e = 0u; e < 16u; ++e) {
        float v = a[e / 4u][e % 4u];
        sum += ((bits >> e) & 1u) != 0u ? v : -v;
    }
    return half_at(at) * sum;
}
#endif

#ifdef Q2_0
const uint BLOCK_ELEMS = 64u;
const uint BLOCK_BYTES = 18u;


float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint q = at + 2u + within / 4u;
    float sum = dot(a0, fields4(byte_at(q)))
              + dot(a1, fields4(byte_at(q + 1u)))
              + dot(a2, fields4(byte_at(q + 2u)))
              + dot(a3, fields4(byte_at(q + 3u)));
    float total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    return half_at(at) * (sum - total);
}
