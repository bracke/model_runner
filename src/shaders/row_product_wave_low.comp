#ifdef NVFP4
const uint BLOCK_ELEMS = 64u;
const uint BLOCK_BYTES = 36u;


const float FOURS[16] = float[16](0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0,
                                  0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0);

//  An unsigned E4M3 scale, halved as ggml reads it.
float e4m3(uint code) {
    uint exponent = (code >> 3u) & 15u;
    float mantissa = float(code & 7u);
    if (code == 0u || code == 0x7Fu) {
        return 0.0;
    }
    return exponent == 0u ? mantissa * exp2(-10.0)
                          : (1.0 + mantissa / 8.0) * exp2(float(exponent) - 8.0);
}

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    //  Sixteen elements are one run: its scale, and eight bytes whose low
    //  nibbles are elements 0 to 7 and high nibbles 8 to 15.
    uint run = within / 16u;
    uint q = at + 4u + 8u * run;
    vec4 lo0, lo1, hi0, hi1;
    for (uint j = 0u; j < 4u; ++j) {
        uint b0 = byte_at(q + j);
        uint b1 = byte_at(q + 4u + j);
        lo0[j] = FOURS[b0 & 15u];
        hi0[j] = FOURS[b0 >> 4u];
        lo1[j] = FOURS[b1 & 15u];
        hi1[j] = FOURS[b1 >> 4u];
    }
    return e4m3(byte_at(at + run))
           * (dot(a0, lo0) + dot(a1, lo1) + dot(a2, hi0) + dot(a3, hi1));
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;

    uint member = gl_WorkGroupID.z;
    bool listed = shape.routed >= LISTED_BY_POSITION;
    uint which = listed ? member
               : shape.routed != 0u ? route[member] : shape.members[member];
    uint slice = which * shape.stride;
    uint experts = shape.members[0];
    uint run_at = listed ? route[experts + member] : 0u;
    uint run_count = listed ? route[member]
                            : min(1u, shape.count - shape.first);
    uint list_at = 2u * experts;

    if (run_count == 0u) {
        return;
    }

    uint from_base = listed
          ? (shape.routed == LISTED_BY_POSITION
               ? route[list_at + run_at] : run_at) * shape.columns
          : min(shape.first, shape.count - 1u) * shape.columns
            + member * shape.apart;

    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    uint groups = (shape.columns + 255u) / 256u;
    uint span = (shape.columns / BLOCK_ELEMS) * BLOCK_BYTES;

    float temp[NUM_ROWS];
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        temp[r] = 0.0;
    }

    for (uint i = ix; i < groups; i += 2u) {
        uint col = i * 256u + itid * 16u;

        if (col < shape.columns) {
            uint xb = (from_base + col) >> 2u;
            vec4 a0 = x4[xb];
            vec4 a1 = x4[xb + 1u];
            vec4 a2 = x4[xb + 2u];
            vec4 a3 = x4[xb + 3u];
            uint block = col / BLOCK_ELEMS;
            uint within = col % BLOCK_ELEMS;

            for (uint r = 0u; r < NUM_ROWS; ++r) {
                uint row = min(first_row + r, shape.rows - 1u);
                uint at = shape.base + slice + row * span + block * BLOCK_BYTES;
                temp[r] += lane_dot(at, within, a0, a1, a2, a3);
            }
        }
    }

    for (uint r = 0u; r < NUM_ROWS; ++r) {
        float whole = subgroupAdd(temp[r]);
        uint row = first_row + r;

        if (tid == 0u && row < shape.rows) {
            uint out_at = listed
                          ? run_at * shape.rows + row
                          : member * shape.rows * shape.count
                            + shape.first * shape.rows + row;
            y[out_at] = shape.joins != 0u ? whole + rj[out_at] : whole;
        }
    }
}
