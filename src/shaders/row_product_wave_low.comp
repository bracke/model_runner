#ifdef TQ2_0
const uint BLOCK_ELEMS = 256u;
const uint BLOCK_BYTES = 66u;

//  TQ2_0 reads its activations itself, as llama.cpp's kernel does: a lane
//  takes four bytes of a run and all four fields of each -- sixteen weights
//  in one word, a mask and an unpack for every four -- so its sixteen
//  activations are four runs of four, thirty-two apart.
#define OWN_ACTIVATIONS

float lane_dot_own(uint at, uint lane, uint xg, out float total) {
    uint run = lane / 8u;
    uint m = (lane % 8u) * 4u;
    uint q = u32_at(at + run * 32u + m);
    uint xb = xg + (run * 128u + m) / 4u;
    vec4 a0 = x4[xb];
    vec4 a1 = x4[xb + 8u];
    vec4 a2 = x4[xb + 16u];
    vec4 a3 = x4[xb + 24u];
    total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    float sum = dot(a0, vec4(unpack8(q & 0x03030303u)))
              + dot(a1, vec4(unpack8((q >> 2u) & 0x03030303u)))
              + dot(a2, vec4(unpack8((q >> 4u) & 0x03030303u)))
              + dot(a3, vec4(unpack8((q >> 6u) & 0x03030303u)));
    return half_at(at + 64u) * (sum - total);
}
#endif

#ifdef TQ1_0
const uint BLOCK_ELEMS = 256u;
const uint BLOCK_BYTES = 54u;

const uint POW3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

//  Digit place of four packed bytes, as numbers nought to two: the byte
//  times three to the place, wrapped at the byte, times three, its top.
vec4 trits4(uint bytes, uint pow3) {
    uvec4 b = uvec4(unpack8(bytes));
    return vec4((((b * pow3) & 255u) * 3u) >> 8u);
}

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    float sum;

    if (within < 240u) {
        //  Sixteen bytes in a row at one digit place: the first hundred and
        //  sixty elements are digit e / 32 of byte e % 32, the next eighty
        //  digit (e - 160) / 16 of byte 32 + (e - 160) % 16.
        uint byte0 = within < 160u ? at + within % 32u : at + 32u;
        uint pow3 = POW3[within < 160u ? within / 32u : (within - 160u) / 16u];
        sum = dot(a0, trits4(quad_at(byte0), pow3))
            + dot(a1, trits4(quad_at(byte0 + 4u), pow3))
            + dot(a2, trits4(quad_at(byte0 + 8u), pow3))
            + dot(a3, trits4(quad_at(byte0 + 12u), pow3));
    } else {
        //  The last sixteen: four bytes, digit (e - 240) / 4 of byte
        //  48 + (e - 240) % 4 -- each run of four one place across the four.
        uint bytes = quad_at(at + 48u);
        sum = dot(a0, trits4(bytes, 1u)) + dot(a1, trits4(bytes, 3u))
            + dot(a2, trits4(bytes, 9u)) + dot(a3, trits4(bytes, 27u));
    }

    float total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    return half_at(at + 52u) * (sum - total);
}
#endif

#ifdef Q1_0
const uint BLOCK_ELEMS = 128u;
const uint BLOCK_BYTES = 18u;


float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    uint bits = byte_at(at + 2u + within / 8u)
              | (byte_at(at + 3u + within / 8u) << 8u);
    vec4 a[4] = vec4[4](a0, a1, a2, a3);
    float sum = 0.0;
    for (uint e = 0u; e < 16u; ++e) {
        float v = a[e / 4u][e % 4u];
        sum += ((bits >> e) & 1u) != 0u ? v : -v;
    }
    return half_at(at) * sum;
}
#endif

#ifdef Q2_0
const uint BLOCK_ELEMS = 64u;
const uint BLOCK_BYTES = 18u;

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    //  Sixteen elements in one word: byte k holds elements 4k to 4k + 3, the
    //  lowest field first, so field f of the four bytes is elements f, f + 4,
    //  f + 8 and f + 12 -- component f of each of the four activation vectors.
    uint q = u32_at(at + 2u + within / 4u);
    float sum = dot(vec4(a0.x, a1.x, a2.x, a3.x), vec4(unpack8(q & 0x03030303u)))
              + dot(vec4(a0.y, a1.y, a2.y, a3.y), vec4(unpack8((q >> 2u) & 0x03030303u)))
              + dot(vec4(a0.z, a1.z, a2.z, a3.z), vec4(unpack8((q >> 4u) & 0x03030303u)))
              + dot(vec4(a0.w, a1.w, a2.w, a3.w), vec4(unpack8((q >> 6u) & 0x03030303u)));
    float total = dot(a0 + a1 + a2 + a3, vec4(1.0));
    return half_at(at) * (sum - total);
}
#endif

#ifdef NVFP4
const uint BLOCK_ELEMS = 64u;
const uint BLOCK_BYTES = 36u;


const float FOURS[16] = float[16](0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0,
                                  0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0);

//  An unsigned E4M3 scale, halved as ggml reads it.
float e4m3(uint code) {
    uint exponent = (code >> 3u) & 15u;
    float mantissa = float(code & 7u);
    if (code == 0u || code == 0x7Fu) {
        return 0.0;
    }
    return exponent == 0u ? mantissa * exp2(-10.0)
                          : (1.0 + mantissa / 8.0) * exp2(float(exponent) - 8.0);
}

float lane_dot(uint at, uint within, vec4 a0, vec4 a1, vec4 a2, vec4 a3) {
    //  Sixteen elements are one run: its scale, and eight bytes -- two words
    //  whose low nibbles are elements 0 to 7 and high nibbles 8 to 15.
    uint run = within / 16u;
    uint w0 = quad_at(at + 4u + 8u * run);
    uint w1 = quad_at(at + 8u + 8u * run);
    uvec4 b0 = uvec4(unpack8(w0));
    uvec4 b1 = uvec4(unpack8(w1));
    vec4 lo0 = vec4(FOURS[b0.x & 15u], FOURS[b0.y & 15u], FOURS[b0.z & 15u], FOURS[b0.w & 15u]);
    vec4 lo1 = vec4(FOURS[b1.x & 15u], FOURS[b1.y & 15u], FOURS[b1.z & 15u], FOURS[b1.w & 15u]);
    vec4 hi0 = vec4(FOURS[b0.x >> 4u], FOURS[b0.y >> 4u], FOURS[b0.z >> 4u], FOURS[b0.w >> 4u]);
    vec4 hi1 = vec4(FOURS[b1.x >> 4u], FOURS[b1.y >> 4u], FOURS[b1.z >> 4u], FOURS[b1.w >> 4u]);
    return e4m3(byte_at(at + run))
           * (dot(a0, lo0) + dot(a1, lo1) + dot(a2, hi0) + dot(a3, hi1));
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;            // which of the four groups in flight

    uint member = gl_WorkGroupID.z;
    bool listed = shape.routed >= LISTED_BY_POSITION;
    uint which = listed ? member
               : shape.routed != 0u ? route[member] : shape.members[member];
    uint slice = which * shape.stride;
    uint experts = shape.members[0];
    uint run_at = listed ? route[experts + member] : 0u;
    uint run_count = listed ? route[member]
                            : min(1u, shape.count - shape.first);
    uint list_at = 2u * experts;

    if (run_count == 0u) {
        return;
    }

    uint from_base = listed
          ? (shape.routed == LISTED_BY_POSITION
               ? route[list_at + run_at] : run_at) * shape.columns
          : min(shape.first, shape.count - 1u) * shape.columns
            + member * shape.apart;

    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    uint groups = (shape.columns + 255u) / 256u;
    uint span = (shape.columns / BLOCK_ELEMS) * BLOCK_BYTES;

    float temp[NUM_ROWS];
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        temp[r] = 0.0;
    }

    for (uint i = ix; i < groups; i += 4u) {
        uint col = i * 256u + itid * 16u;

#ifdef OWN_ACTIVATIONS
        if (i * 256u < shape.columns) {
            uint xg = (from_base + i * 256u) >> 2u;

            for (uint r = 0u; r < NUM_ROWS; ++r) {
                uint row = min(first_row + r, shape.rows - 1u);
                uint at = shape.base + slice + row * span + i * BLOCK_BYTES;
                float unused;
                temp[r] += lane_dot_own(at, itid, xg, unused);
            }
        }
#else
        if (col < shape.columns) {
            uint xb = (from_base + col) >> 2u;
            vec4 a0 = x4[xb];
            vec4 a1 = x4[xb + 1u];
            vec4 a2 = x4[xb + 2u];
            vec4 a3 = x4[xb + 3u];
            uint block = col / BLOCK_ELEMS;
            uint within = col % BLOCK_ELEMS;

            for (uint r = 0u; r < NUM_ROWS; ++r) {
                uint row = min(first_row + r, shape.rows - 1u);
                uint at = shape.base + slice + row * span + block * BLOCK_BYTES;
                temp[r] += lane_dot(at, within, a0, a1, a2, a3);
            }
        }
#endif
    }

    for (uint r = 0u; r < NUM_ROWS; ++r) {
        float whole = subgroupAdd(temp[r]);
        uint row = first_row + r;

        if (tid == 0u && row < shape.rows) {
            uint out_at = listed
                          ? run_at * shape.rows + row
                          : member * shape.rows * shape.count
                            + shape.first * shape.rows + row;
            y[out_at] = shape.joins != 0u ? whole + rj[out_at] : whole;
        }
    }
}
