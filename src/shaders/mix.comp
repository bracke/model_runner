#version 450

//  The weighted sum that ends a mixture layer, and the residual after it.
//
//  Each chosen expert's projection down, scaled by its share and added
//  in the order the experts were chosen -- best first -- which is the
//  order the host has always added them in. Each term is the product
//  rounded and then the sum rounded, as two instructions on the host are,
//  and precise says so to a compiler that would otherwise fuse them: the
//  batched path sums on the host, the token's path sums here, and a test
//  holds the two to the bit.
//
//  The residual is what the layer joined after attention, added last,
//  which is where the layer's second join stood and what it added.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Route    { uint  r[]; };
layout(std430, binding = 1) readonly  buffer Downs    { float d[]; };
layout(std430, binding = 2) writeonly buffer Target   { float y[]; };
layout(std430, binding = 4) readonly  buffer Residual { float rj[]; };

//  An expert's scale on what it projected down, a row a width an expert,
//  where the mix takes it in (table): Gemma 4's, which a biasing step
//  multiplied into a copy of every slot's answer before the mix read it.
//  The expert a slot holds is the routing's, at the position's rank.
layout(std430, binding = 3) readonly  buffer Scales   { float sc[]; };
layout(std430, binding = 5) readonly  buffer Chosen   { uint  ch[]; };

layout(push_constant) uniform Shape {
    //  The width of one position's answer, and how many experts it is
    //  summed over.
    uint width;
    uint used;
    uint count;
    uint first;
    uint packing;
    uint base;

    //  Whether the residual is added.
    uint joins;

    //  Where the experts' scales begin at binding 3, in floats and plus
    //  one; nought for none. Only a mix over listed answers takes them.
    uint table;
} shape;

void main() {
    uint i = gl_GlobalInvocationID.x;

    if (i >= shape.count * shape.width) {
        return;
    }

    uint pos = i / shape.width;
    uint w = i - pos * shape.width;
    uint at_share = pos * 2u * shape.used + shape.used;

    precise float acc = 0.0;

    //  A batch's experts answered by slot, in the runs invert.comp laid
    //  out: the routing bound here is then its lists, first is the expert
    //  count that says where they lie, and each of this position's
    //  answers is found by the slot it was given and weighed by the share
    //  written beside it. The terms are added in rank order, as below.
    if (shape.base != 0u) {
        uint runs = shape.count * shape.used + 15u * shape.first;
        uint share_at = 2u * shape.first + runs;
        uint slot_at = share_at + runs;

        for (uint k = 0u; k < shape.used; ++k) {
            uint slot = r[slot_at + pos * shape.used + k];
            float share = uintBitsToFloat(r[share_at + slot]);
            //  Scaled first and rounded, as the biasing step stored it.
            precise float down = d[slot * shape.width + w];
            if (shape.table != 0u) {
                uint expert = ch[pos * 2u * shape.used + k];
                down = down * sc[shape.table - 1u + expert * shape.width + w];
            }
            precise float term = share * down;
            acc = acc + term;
        }
    } else {
        for (uint k = 0u; k < shape.used; ++k) {
            float share = uintBitsToFloat(r[at_share + k]);
            precise float term =
              share * d[(pos * shape.used + k) * shape.width + w];
            acc = acc + term;
        }
    }

    if (shape.joins != 0u) {
        acc = rj[pos * shape.width + w] + acc;
    }

    y[i] = acc;
}
