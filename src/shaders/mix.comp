#version 450

//  The weighted sum that ends a mixture layer, and the residual after it.
//
//  Each chosen expert's projection down, scaled by its share and added
//  in the order the experts were chosen -- best first -- which is the
//  order the host has always added them in. Each term is the product
//  rounded and then the sum rounded, as two instructions on the host are,
//  and precise says so to a compiler that would otherwise fuse them: the
//  batched path sums on the host, the token's path sums here, and a test
//  holds the two to the bit.
//
//  The residual is what the layer joined after attention, added last,
//  which is where the layer's second join stood and what it added.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Route    { uint  r[]; };
layout(std430, binding = 1) readonly  buffer Downs    { float d[]; };
layout(std430, binding = 2) writeonly buffer Target   { float y[]; };
layout(std430, binding = 4) readonly  buffer Residual { float rj[]; };

layout(push_constant) uniform Shape {
    //  The width of one position's answer, and how many experts it is
    //  summed over.
    uint width;
    uint used;
    uint count;
    uint first;
    uint packing;
    uint base;

    //  Whether the residual is added.
    uint joins;
} shape;

void main() {
    uint i = gl_GlobalInvocationID.x;

    if (i >= shape.count * shape.width) {
        return;
    }

    uint pos = i / shape.width;
    uint w = i - pos * shape.width;
    uint at_share = pos * 2u * shape.used + shape.used;

    precise float acc = 0.0;

    for (uint k = 0u; k < shape.used; ++k) {
        float share = uintBitsToFloat(r[at_share + k]);
        precise float term = share * d[(pos * shape.used + k) * shape.width + w];
        acc = acc + term;
    }

    if (shape.joins != 0u) {
        acc = rj[pos * shape.width + w] + acc;
    }

    y[i] = acc;
}
