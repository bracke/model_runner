#version 450

//  A Q4_K row against a batch of one, decoded a super-block at a time the way
//  llama.cpp's own generating product does it -- the arrangement that reads
//  its rate on this part where the eight-lane kernel and the wide float
//  kernel both fall short. Two things make it: the eight sub-block scales are
//  unpacked together, a handful of vector operations over the packed
//  six-bit fields rather than a byte extracted at a time; and a lane takes a
//  whole super-block's worth of one region rather than eight columns, so the
//  header -- the scale word and the block's two factors -- is read once for
//  sixteen weights instead of once for eight and never redundantly across a
//  sub-block's lanes.
//
//  Sixteen lanes share a super-block and a workgroup of thirty-two takes two
//  at a time, striding the row's super-blocks between them; each lane carries
//  a partial for every row the workgroup lands, and the subgroup adds them at
//  the end. One workgroup is one subgroup of thirty-two, which is what lets
//  the device run it at that width.

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#ifdef DOTS
#extension GL_EXT_integer_dot_product : require
#endif

#ifndef NUM_ROWS
#define NUM_ROWS 2u
#endif

//  KSPLIT waves a row band where the rows are long: see
//  row_product_super6.comp, which the same was measured on first.
#ifndef KSPLIT
#define KSPLIT 1u
#endif
layout(local_size_x = 64 * KSPLIT) in;

//  GLU: a feed-forward's gate and up projections at once, the up's rows
//  stride bytes past the gate's in the same buffer, and the answer the
//  gate through the sigmoid-weighted unit times the up -- what combine.comp
//  makes of the two, in the same order. Each row of either is summed as
//  the plain kernel sums it, so the two arms are the same bits they were;
//  what goes is the combining step and the barrier before it.
#ifdef GLU
#define ACC (2u * NUM_ROWS)
#else
#define ACC NUM_ROWS
#endif


shared float wave_sums[KSPLIT * NUM_ROWS];

layout(std430, binding = 0) readonly  buffer Weights  { uint  w[]; };
layout(std430, binding = 1) readonly  buffer Vectors  { float x[]; };
layout(std430, binding = 1) readonly  buffer Vectors4 { vec4  x4[]; };
layout(std430, binding = 2) writeonly buffer Result   { float y[]; };
layout(std430, binding = 3) readonly  buffer Routing  { uint  route[]; };
layout(std430, binding = 4) readonly  buffer Residual { float rj[]; };
#ifdef DOTS
layout(std430, binding = 6) readonly  buffer Rounded  { int   qw[]; };
layout(std430, binding = 6) readonly  buffer Scales   { float qs[]; };
#endif

const uint LISTED_BY_POSITION = 2u;

layout(push_constant) uniform Shape {
    uint rows;
    uint columns;
    uint count;
    uint first;
    uint format;
    uint base;
    uint joins;
    uint table;
    uint members[16];
    uint stride;
    uint apart;
    uint routed;
} shape;

#ifdef DOTS
//  Where the rounding's scales begin: past room for eight positions'
//  bytes, or -- for a walk that reads its experts' runs by slot, which may
//  be many more rows than eight -- past the room the push block's table
//  word says, in rows.
#define SCALES_AT ((shape.routed == 3u && shape.table != 0u ? shape.table : 8u) * shape.columns / 4u)
#endif

float sigmoid_weighted(float x) {
    return x / (1.0 + exp(-clamp(x, -60.0, 60.0)));
}

//  And the Gaussian unit in the tanh form, as combine.comp states it; the
//  push block's table word says which of the two, as combine's unit word
//  does: nought or one.
float gaussian(float x) {
    const float root = 0.7978845608028654;
    const float bend = 0.044715;
    float inner = root * (x + bend * x * x * x);
    return 0.5 * x * (1.0 + tanh(clamp(inner, -60.0, 60.0)));
}

float gate_unit(float x) {
    return shape.table == 1u ? gaussian(x) : sigmoid_weighted(x);
}

#ifdef MULTI
//  A few positions at once -- a drafted round's check, two to eight --
//  through the same walk: each lane's weights of a row decoded once and
//  dotted with every position's activations, which a lane loads once a
//  block for all the rows it takes. The row kernel this replaces for them
//  carried every position through its accumulation a weight at a time, and
//  a Steelman layer checked at six positions took 1.55 times one.
layout(constant_id = 1) const uint VEC = 2u;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint il = itid >> 2u;
    uint ir = itid & 3u;
    uint v_im = il >> 1u;
    uint v_in = il & 1u;
    uint l0 = 4u * (2u * ir + v_in);
    uint q_word = (32u * v_im + l0) >> 2u;
    uint y_off = 64u * v_im + l0;

    uint member = gl_WorkGroupID.z;
    bool listed = shape.routed >= LISTED_BY_POSITION;
    uint which = listed ? member
               : shape.routed != 0u ? route[member] : shape.members[member];
    uint slice = which * shape.stride;
    uint experts = shape.members[0];
    uint run_at = listed ? route[experts + member] : 0u;
    uint run_count = listed ? route[member] : shape.count - shape.first;
    uint list_at = 2u * experts;

    if (run_count == 0u) {
        return;
    }

    //  Where each position's vector begins, and whether it is one: past
    //  the run or the batch it reads the last real one and is not stored.
    uint from_k[VEC];
    bool real_k[VEC];
    for (uint k = 0u; k < VEC; ++k) {
        uint kk = min(k, run_count - 1u);
        real_k[k] = k < run_count;
        from_k[k] = listed
              ? (shape.routed == LISTED_BY_POSITION
                   ? route[list_at + run_at + kk] : run_at + kk)
                * shape.columns
              : (shape.first + kk) * shape.columns + member * shape.apart;
    }

    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    uint blocks = shape.columns / 256u;
    uint span = blocks * 144u;

    float temp[ACC][VEC];
    for (uint r = 0u; r < ACC; ++r) {
        for (uint k = 0u; k < VEC; ++k) {
            temp[r][k] = 0.0;
        }
    }

    for (uint i = ix; i < blocks; i += 4u) {
#ifdef DOTS
        //  The positions rounded to integers by round_vectors.comp, four
        //  to a word where these lie, and each region's scale; the sums
        //  the minimum term takes are the integers' too, so that both
        //  terms see the one rounded vector.
        int qy[VEC][4];
        vec4 dy[VEC];
        vec4 bsum[VEC];
        for (uint k = 0u; k < VEC; ++k) {
            uint y1 = from_k[k] + i * 256u + y_off;
            uint w1 = y1 >> 2u;
            uint w2 = (y1 + 128u) >> 2u;
            qy[k][0] = qw[w1];
            qy[k][1] = qw[w1 + 8u];
            qy[k][2] = qw[w2];
            qy[k][3] = qw[w2 + 8u];
            uint s1 = SCALES_AT + (y1 >> 5u);
            uint s2 = SCALES_AT + ((y1 + 128u) >> 5u);
            dy[k] = vec4 (qs[s1], qs[s1 + 1u], qs[s2], qs[s2 + 1u]);
            bsum[k] = dy[k] * vec4 (float (dotPacked4x8EXT (qy[k][0], 0x01010101)),
                                    float (dotPacked4x8EXT (qy[k][1], 0x01010101)),
                                    float (dotPacked4x8EXT (qy[k][2], 0x01010101)),
                                    float (dotPacked4x8EXT (qy[k][3], 0x01010101)));
        }
#else
        vec4 by10[VEC], by132[VEC], by20[VEC], by232[VEC];
        vec4 bsum[VEC];
        for (uint k = 0u; k < VEC; ++k) {
            uint y1 = from_k[k] + i * 256u + y_off;
            uint b1 = y1 >> 2u;
            uint b2 = (y1 + 128u) >> 2u;
            by10[k]  = x4[b1];
            by132[k] = x4[b1 + 8u];
            by20[k]  = x4[b2];
            by232[k] = x4[b2 + 8u];
            bsum[k] = vec4 (dot (by10[k], vec4 (1.0)),
                            dot (by132[k], vec4 (1.0)),
                            dot (by20[k], vec4 (1.0)),
                            dot (by232[k], vec4 (1.0)));
        }

#endif
        for (uint r = 0u; r < ACC; ++r) {
#ifdef GLU
            uint row = min (first_row + r % NUM_ROWS, shape.rows - 1u);
            uint at = shape.base + (r >= NUM_ROWS ? shape.stride : 0u)
                      + row * span + i * 144u;
#else
            uint row = min (first_row + r, shape.rows - 1u);
            uint at = shape.base + slice + row * span + i * 144u;
#endif
            uint head = at >> 2u;
            vec2 dm = unpackHalf2x16 (w[head]);
            uvec3 sc = uvec3 (w[head + 1u], w[head + 2u], w[head + 3u]);
            uint s0 = v_im == 0u ? (sc.x & 0xFFFFu) : (sc.x >> 16u);
            uint s4 = v_im == 0u ? (sc.y & 0xFFFFu) : (sc.y >> 16u);
            uint s8 = v_im == 0u ? (sc.z & 0xFFFFu) : (sc.z >> 16u);
            uint sl = (s4 << 16u) | s0;
            uint sh = (sl & 0xC0C0C0C0u) >> 2u;
            vec4 s04 = vec4 (unpack8 (sl & 0x3F3F3F3Fu));
            vec4 s8f = vec4 (unpack8 ((((s8 << 12u) | s8) & 0x0F0F0F0Fu) | sh));
            uint qbase = (at + 16u) >> 2u;
            uint qs0  = w[qbase + q_word];
            uint qs64 = w[qbase + q_word + 16u];
#ifdef DOTS
            //  The nibbles as they lie are four bytes of nought to
            //  fifteen, which is what a signed four-way dot takes.
            int q0lo  = int (qs0  & 0x0F0F0F0Fu);
            int q0hi  = int ((qs0  >> 4u) & 0x0F0F0F0Fu);
            int q64lo = int (qs64 & 0x0F0F0F0Fu);
            int q64hi = int ((qs64 >> 4u) & 0x0F0F0F0Fu);
            vec4 mins = vec4 (s04.z, s04.w, s8f.z, s8f.w);
            vec4 scl = vec4 (s04.x, s04.y, s8f.x, s8f.y);

            for (uint k = 0u; k < VEC; ++k) {
                vec4 sums = vec4 (float (dotPacked4x8EXT (qy[k][0], q0lo)),
                                  float (dotPacked4x8EXT (qy[k][1], q0hi)),
                                  float (dotPacked4x8EXT (qy[k][2], q64lo)),
                                  float (dotPacked4x8EXT (qy[k][3], q64hi)));
                temp[r][k] += dm.x * dot (sums * dy[k], scl)
                              - dm.y * dot (mins, bsum[k]);
            }
        }
    }
#else
            vec4 q0lo  = vec4 (unpack8 (qs0  & 0x0F0F0F0Fu));
            vec4 q0hi  = vec4 (unpack8 ((qs0  >> 4u) & 0x0F0F0F0Fu));
            vec4 q64lo = vec4 (unpack8 (qs64 & 0x0F0F0F0Fu));
            vec4 q64hi = vec4 (unpack8 ((qs64 >> 4u) & 0x0F0F0F0Fu));
            vec4 mins = vec4 (s04.z, s04.w, s8f.z, s8f.w);

            for (uint k = 0u; k < VEC; ++k) {
                float sx = dot (by10[k],  q0lo);
                float sy = dot (by132[k], q0hi);
                float sz = dot (by20[k],  q64lo);
                float sw = dot (by232[k], q64hi);
                temp[r][k] += dm.x * (sx * s04.x + sy * s04.y
                                      + sz * s8f.x + sw * s8f.y)
                              - dm.y * dot (mins, bsum[k]);
            }
        }
    }

#endif

#ifdef GLU
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        uint row = first_row + r;
        for (uint k = 0u; k < VEC; ++k) {
            float gate = subgroupAdd (temp[r][k]);
            float up = subgroupAdd (temp[r + NUM_ROWS][k]);
            if (tid == 0u && row < shape.rows && real_k[k]) {
                y[(shape.first + k) * shape.rows + row] =
                  gate_unit (gate) * up;
            }
        }
    }
    return;
#endif
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        uint row = first_row + r;
        for (uint k = 0u; k < VEC; ++k) {
            float whole = subgroupAdd (temp[r][k]);
            if (tid == 0u && row < shape.rows && real_k[k]) {
                uint out_at = listed
                              ? (run_at + k) * shape.rows + row
                              : member * shape.rows * shape.count
                                + (shape.first + k) * shape.rows + row;
                y[out_at] = shape.joins != 0u ? whole + rj[out_at] : whole;
            }
        }
    }
}
#else
void main() {
    uint tid = gl_LocalInvocationID.x;   // 0..31
    uint itid = tid & 15u;               // 0..15, the sixteen sharing a block
    uint ix = tid >> 4u;                 // 0 or 1, which of two blocks in flight

    uint il = itid >> 2u;                // 0..3
    uint ir = itid & 3u;                 // 0..3
    uint v_im = il >> 1u;                // 0 or 1: which half of the block
    uint v_in = il & 1u;
    uint l0 = 4u * (2u * ir + v_in);     // 0..15
    uint q_word = (32u * v_im + l0) >> 2u;   // word of quants this lane reads
    uint y_off = 64u * v_im + l0;            // element of the activation

    uint member = gl_WorkGroupID.z;
    bool listed = shape.routed >= LISTED_BY_POSITION;
    uint which = listed ? member
               : shape.routed != 0u ? route[member] : shape.members[member];
    uint slice = which * shape.stride;

    uint experts = shape.members[0];
    uint run_at = listed ? route[experts + member] : 0u;
    uint run_count = listed ? route[member]
                            : min(1u, shape.count - shape.first);
    uint list_at = 2u * experts;

    if (run_count == 0u) {
        return;
    }

    uint from_base = listed
          ? (shape.routed == LISTED_BY_POSITION
               ? route[list_at + run_at] : run_at) * shape.columns
          : min(shape.first, shape.count - 1u) * shape.columns
            + member * shape.apart;

    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    uint blocks = shape.columns / 256u;   // super-blocks a row
    uint span = blocks * 144u;            // bytes a row takes

    float temp[ACC];
    for (uint r = 0u; r < ACC; ++r) {
        temp[r] = 0.0;
    }

    //  This lane's two super-blocks stride the row, ix and ix + 2, ix + 4 ...
    for (uint i = ix; i < blocks; i += 4u * KSPLIT) {
        //  The activation of the two regions this lane's half owns, four
        //  vectors of four: the near sixteen and the far sixteen.
        uint y1 = i * 256u + y_off;
        uint y2 = y1 + 128u;
        uint b1 = (from_base + y1) >> 2u;
        uint b2 = (from_base + y2) >> 2u;
        vec4 by10  = x4[b1];
        vec4 by132 = x4[b1 + 8u];
        vec4 by20  = x4[b2];
        vec4 by232 = x4[b2 + 8u];

        float bs10  = by10.x  + by10.y  + by10.z  + by10.w;
        float bs132 = by132.x + by132.y + by132.z + by132.w;
        float bs20  = by20.x  + by20.y  + by20.z  + by20.w;
        float bs232 = by232.x + by232.y + by232.z + by232.w;

        for (uint r = 0u; r < ACC; ++r) {
#ifdef GLU
            uint row = first_row + r % NUM_ROWS;
            uint at = shape.base + (r >= NUM_ROWS ? shape.stride : 0u)
                      + row * span + i * 144u;
#else
            uint row = first_row + r;
            uint at = shape.base + slice + row * span + i * 144u;
#endif
            uint head = at >> 2u;

            vec2 dm = unpackHalf2x16 (w[head]);
            uvec3 sc = uvec3 (w[head + 1u], w[head + 2u], w[head + 3u]);

            //  The eight sub-block scales unpacked together. The twelve scale
            //  bytes are six sixteen-bit fields; this half reads three of
            //  them, and the six-bit values come out four at a time -- the
            //  low four bits in place and the top two carried from the shared
            //  byte, exactly as the processor's own decoder packs them.
            uint s0 = v_im == 0u ? (sc.x & 0xFFFFu) : (sc.x >> 16u);
            uint s4 = v_im == 0u ? (sc.y & 0xFFFFu) : (sc.y >> 16u);
            uint s8 = v_im == 0u ? (sc.z & 0xFFFFu) : (sc.z >> 16u);
            uint sl = (s4 << 16u) | s0;
            uint sh = (sl & 0xC0C0C0C0u) >> 2u;
            vec4 s04 = vec4 (unpack8 (sl & 0x3F3F3F3Fu));
            vec4 s8f = vec4 (unpack8 ((((s8 << 12u) | s8) & 0x0F0F0F0Fu) | sh));

            uint qbase = (at + 16u) >> 2u;
            uint qs0  = w[qbase + q_word];
            uint qs64 = w[qbase + q_word + 16u];

            vec4 q0lo  = vec4 (unpack8 (qs0  & 0x0F0F0F0Fu));
            vec4 q0hi  = vec4 (unpack8 ((qs0  >> 4u) & 0x0F0F0F0Fu));
            vec4 q64lo = vec4 (unpack8 (qs64 & 0x0F0F0F0Fu));
            vec4 q64hi = vec4 (unpack8 ((qs64 >> 4u) & 0x0F0F0F0Fu));

            float sx = dot (by10,  q0lo);
            float sy = dot (by132, q0hi);
            float sz = dot (by20,  q64lo);
            float sw = dot (by232, q64hi);

            //  The minimum term: the sum of each region's activation weighted
            //  by that region's minimum scale, taken away once.
            float smin = s04.z * bs10 + s04.w * bs132
                       + s8f.z * bs20 + s8f.w * bs232;

            temp[r] += dm.x * (sx * s04.x + sy * s04.y
                               + sz * s8f.x + sw * s8f.y)
                       - dm.y * smin;
        }
    }

    if (KSPLIT > 1u) {
        for (uint r = 0u; r < NUM_ROWS; ++r) {
            float part = subgroupAdd (temp[r]);

            if (subgroupElect ()) {
                wave_sums[gl_SubgroupID * NUM_ROWS + r] = part;
            }
        }

        barrier ();
    }

#ifdef GLU
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        float gate = subgroupAdd (temp[r]);
        float up = subgroupAdd (temp[r + NUM_ROWS]);
        uint row = first_row + r;

        if (tid == 0u && row < shape.rows) {
            y[shape.first * shape.rows + row] = gate_unit (gate) * up;
        }
    }
    return;
#endif
    for (uint r = 0u; r < NUM_ROWS; ++r) {
        float whole = subgroupAdd (temp[r]);

        if (KSPLIT > 1u) {
            whole = 0.0;
            for (uint g = 0u; g < gl_NumSubgroups; ++g) {
                whole += wave_sums[g * NUM_ROWS + r];
            }
        }
        uint row = first_row + r;

        if (tid == 0u && row < shape.rows) {
            uint out_at = listed
                          ? run_at * shape.rows + row
                          : member * shape.rows * shape.count
                            + shape.first * shape.rows + row;

            y[out_at] = shape.joins != 0u ? whole + rj[out_at] : whole;
        }
    }
}
#endif
