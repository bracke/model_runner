#version 450

//  The front of a hybrid's linear layer: the short causal convolution
//  over each position and the ones remembered, the unit, and the query
//  and key heads to unit length.
//
//  A linear layer projects a position into a mixed row -- its queries,
//  its keys and its values, one after another -- and convolves each
//  channel of the row over the last Taps positions before the rule reads
//  it. The positions before this batch are what the layer remembered: a
//  memory of Taps - 1 mixed rows in a slot of the state buffer, the
//  oldest first, which the host kept in a ring of slots so a draft could
//  rewind to one; this writes the memory each position leaves into the
//  slot the position after it reads, and the ring's arithmetic is the
//  host's. The convolved row goes through the logistic-weighted unit,
//  and each query and key head -- the first blocks of the row -- is
//  scaled to unit length, held away from nothing by the epsilon.
//
//  The batch is runs of positions, each run one session's: a batch is
//  one run, and a round of sessions one a member, whose rows lie one
//  member after another. A table in the state buffer says, for each
//  run, where the session's ring begins, the position the run starts
//  at, how many rows it has, which row is its first, and how many slots
//  its ring has; a workgroup finds its run by its row.
//
//  Two passes, told apart by a word of the shape: the first convolves and
//  writes the rows, reading the memory; the second writes the memories.
//  The two are one dispatch each with a barrier between, because a
//  position's memory may land in the slot another position of the batch
//  is still reading -- the ring wraps -- and workgroups have no order.
//
//  A workgroup a position and a block, its lanes over the block: a block
//  is a head's width, so a query or key head is one block and its length
//  is one reduction.

const uint LANES = 128u;

layout(local_size_x = LANES) in;

layout(std430, binding = 0) readonly  buffer Weight { float w[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) buffer Target { float y[]; };
layout(std430, binding = 4) buffer State { float s[]; };

//  And the same buffer as words, read only, for the runs' table: a
//  table read as floats' bits through a buffer this kernel also writes
//  cost a fifth of the kernel, since the compiler could not tell the
//  reads were the same for every lane and made vector loads of them.
layout(std430, binding = 4) readonly buffer Table { uint tab[]; };

layout(push_constant) uniform Shape {
    //  Elements a mixed row holds.
    uint mix;

    //  Elements a block holds, which is the state's width.
    uint head;

    //  Positions in this batch.
    uint count;

    //  Where the runs' table begins in the state buffer, in elements:
    //  five words a run.
    uint table_at;

    //  Taps of the convolution.
    uint taps;

    //  Where the weights begin in the buffer the device kept them in, in
    //  elements: Taps rows of Mix, the oldest tap first.
    uint base;

    //  One to write the memories, zero to convolve.
    uint writing;

    //  Blocks scaled to unit length: the query heads and the key heads.
    uint unit_blocks;

    //  Where this layer's memory begins within a slot, in elements; how
    //  many elements a slot holds; how many runs the table names; and
    //  the epsilon by its bits.
    uint memory_at;
    uint every;
    uint runs;
    uint epsilon;

    uint unused[12];
} shape;

shared float partial[LANES];

//  x / (1 + exp(-x)), as the host's kernel computes it.
float unit(float v) {
    return v / (1.0 + exp(-clamp(v, -60.0, 60.0)));
}

void main() {
    uint block = gl_WorkGroupID.x;
    uint t = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    if (t >= shape.count) {
        return;
    }

    uint c0 = block * shape.head;
    uint remembered = shape.taps - 1u;

    //  The run this row is in, and where it stands in it.
    uint base = 0u;
    uint first = 0u;
    uint run_count = shape.count;
    uint row0 = 0u;
    uint slots = 1u;
    for (uint r = 0u; r < shape.runs; r++) {
        uint at = shape.table_at + r * 5u;
        uint r_row0 = tab[at + 3u];
        uint r_count = tab[at + 2u];
        if (t >= r_row0 && t < r_row0 + r_count) {
            base = tab[at];
            first = tab[at + 1u];
            run_count = r_count;
            row0 = r_row0;
            slots = tab[at + 4u];
        }
    }
    uint p = t - row0;

    //  Where the memory this run begins with lies, and where this
    //  position's goes.
    uint read_slot = first % slots;
    uint write_slot = (first + p + 1u) % slots;
    uint read_at = base + read_slot * shape.every + shape.memory_at;
    uint write_at = base + write_slot * shape.every + shape.memory_at;

    if (shape.writing != 0u) {
        //  Only the run's last Slots positions, whose slots are their
        //  own: the ones before would write the same slots as these and
        //  land in no order, and the host keeps only these.
        if (p + slots < run_count) {
            return;
        }

        //  The last Taps - 1 inputs, this position's newest: k of them
        //  is position t - (Taps - 2 - k), out of the batch where that
        //  is a position of it and out of the memory read where it is
        //  before it.
        for (uint c = lane; c < shape.head; c += LANES) {
            for (uint k = 0u; k < remembered; k++) {
                int from = int(p) - int(remembered - 1u - k);
                float held;
                if (from >= 0) {
                    held = x[(row0 + uint(from)) * shape.mix + c0 + c];
                } else {
                    held = s[read_at + uint(int(remembered) + from) * shape.mix + c0 + c];
                }
                s[write_at + k * shape.mix + c0 + c] = held;
            }
        }
        return;
    }

    float sum = 0.0;

    for (uint c = lane; c < shape.head; c += LANES) {
        float made = 0.0;

        //  Tap m from the newest: the input m positions back, times the
        //  tap Taps - 1 - m, which is how the host lays the taps out.
        for (uint m = 0u; m < shape.taps; m++) {
            int from = int(p) - int(m);
            float held;
            if (from >= 0) {
                held = x[(row0 + uint(from)) * shape.mix + c0 + c];
            } else {
                held = s[read_at + uint(int(remembered) + from) * shape.mix + c0 + c];
            }
            made += held * w[shape.base + (shape.taps - 1u - m) * shape.mix + c0 + c];
        }

        made = unit(made);
        y[t * shape.mix + c0 + c] = made;
        sum += made * made;
    }

    if (block >= shape.unit_blocks) {
        return;
    }

    //  The block's length, folded as the normalization folds.
    partial[lane] = sum;
    for (uint reach = LANES / 2u; reach > 0u; reach >>= 1u) {
        barrier();
        if (lane < reach) {
            partial[lane] += partial[lane + reach];
        }
    }
    barrier();

    float length = max(sqrt(partial[0]), uintBitsToFloat(shape.epsilon));

    for (uint c = lane; c < shape.head; c += LANES) {
        y[t * shape.mix + c0 + c] = y[t * shape.mix + c0 + c] / length;
    }
}
