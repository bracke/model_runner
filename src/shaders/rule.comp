#version 450

#extension GL_EXT_control_flow_attributes : enable

//  The gated delta rule of a hybrid's linear layer, a head at a time,
//  over a batch of positions in order.
//
//  A position's state is the one before decayed and corrected: S_t =
//  a_t S_(t-1) + k_t u_t', with u_t = b_t (v_t - a_t S_(t-1)' k_t), and
//  its answer is S_t' q_t, scaled, normalized over the head by its own
//  mean square and a gain, and gated by the logistic-weighted unit of z.
//
//  Unrolled over a chunk of positions from the state S_0 the chunk began
//  with, as the host unrolls it, with g_t the product of the decays up
//  to t and g_(s..t) the product from s + 1 to t:
//
//    S_t = g_t S_0 + sum over s <= t of g_(s..t) k_s u_s'
//    u_s = b_s (v_s - g_s S_0' k_s - sum over r < s of g_(r..s) (k_r . k_s) u_r)
//    o_t = g_t S_0' q_t + sum over s <= t of g_(s..t) (k_s . q_t) u_s
//
//  So the state is read once for every key and query of the chunk, the
//  corrections come out of a triangle of the keys against each other,
//  the answers out of a triangle of the keys against the queries, and
//  the state is read once more and written for the states the chunk
//  leaves. A position at a time, the state went through the cache twice
//  a position -- a head's square, read and written, for a few thousand
//  multiplications -- and a prompt's rule was most of a linear layer's
//  time: 6.5 milliseconds a layer of Qwen3.5-0.8B at a hundred and one
//  positions. A chunk reads it twice for sixteen positions and writes
//  it for the one or two the ring keeps, and each row read feeds
//  thirty-two independent products, which is what a lane needs to have
//  something to do while the next rows are on their way: 0.85
//  milliseconds a layer, and the same numbers as the host's chunk,
//  associated as its triangles are.
//
//  A workgroup is two waves of a head and a run, and a prompt's layer
//  is sixteen of them, so the device has a wave or two a unit and
//  nothing to switch to while one waits; what the kernel is shaped by
//  is the waits it exposes rather than the work it issues. The rows
//  are loaded sixteen at a time before any is used, the keys and
//  queries go through shared memory as vectors, the roots are folded
//  as a tree, and a chunk's count is a compile-time constant -- the
//  run is taken in whole chunks and then in halves, each its own copy
//  of the kernel, so a chunk's loops unroll and a lane's numbers stay
//  in registers; the single position a token generated is the copy
//  made for one.
//
//  The decay is exp(A_log times the softplus of alpha plus dt's bias)
//  and the rate the logistic of beta, one number a head a position, as
//  the host computes them. A_log, dt's bias and the gain lie one after
//  another in the weight the device keeps for this step.
//
//  The state the batch begins with is in a slot of the ring, and each
//  position's goes to the slot the position after it reads: the ones
//  the host keeps, which are a run's last Slots positions, since a slot
//  holds the last of the positions that map to it; and each chunk's
//  last, which the chunk after it begins from. A head's state is Head
//  rows of Head, key-major: row i holds S (i, j) for every j, so a lane
//  is a j and a row read is one read a lane, in step.
//
//  The batch is runs of positions, each run one session's, as the
//  convolution's table says: a workgroup a value head and a run, its
//  lanes over the columns of the state, the run's positions in order.

const uint LANES = 128u;

//  Positions a chunk takes at once. A lane holds a chunk's numbers for
//  its column in registers -- what the state says of each key and each
//  query, and each correction -- so this is bounded by what a lane can
//  hold without spilling.
const uint CHUNK = 16u;

const uint NOWHERE = 0xFFFFFFFFu;

layout(local_size_x = LANES) in;

layout(std430, binding = 0) readonly  buffer Weight { float w[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) buffer Target { float y[]; };
layout(std430, binding = 3) readonly  buffer Rooms  { float r[]; };
layout(std430, binding = 4) buffer State { float s[]; };

//  And the same buffer as words, read only, for the runs' table: a
//  table read as floats' bits through a buffer this kernel also writes
//  cost a fifth of the kernel, since the compiler could not tell the
//  reads were the same for every lane and made vector loads of them.
layout(std430, binding = 4) readonly buffer Table { uint tab[]; };

layout(push_constant) uniform Shape {
    //  Elements a mixed row holds, and the state's width.
    uint mix;
    uint head;

    //  Positions in this batch, and where the runs' table begins in the
    //  state buffer, in elements: five words a run.
    uint count;
    uint table_at;

    //  Key heads, and elements the queries or the keys take in a row.
    uint key_heads;
    uint key_width;

    //  Where the weight begins, in elements: A_log a value head, then
    //  dt's bias a value head, then the gain a column.
    uint base;

    //  Value heads, which is how many workgroups there are.
    uint value_heads;

    //  Where this layer's state begins within a slot, in elements; how
    //  many elements a slot holds; how many runs the table names.
    uint state_at;
    uint every;
    uint runs;

    //  Where the gate rows, the alphas and the betas lie in the rooms
    //  buffer, in elements: a row of Value_Heads * Head, of Value_Heads
    //  and of Value_Heads a position.
    uint z_at;
    uint alpha_at;
    uint beta_at;

    //  The scale on the answer and the epsilon under the mean square,
    //  by their bits.
    uint scale;
    uint epsilon;

    uint unused[8];
} shape;

//  The state's rows a lane takes at once: four, which is a vector of
//  the keys, so a step over the rows reads a position's keys as one.
//  A row at a time, a lane waited out the memory for every row and
//  The state's rows a lane takes at once, in vectors of four, which is
//  how the keys are staged: the loads of a step are on their way
//  together, and a row at a time a lane waited out the memory for
//  every row.
const uint ROWS = 16u;
const uint VECS = ROWS / 4u;

//  Columns of a head the chunk's keys and queries are staged in shared
//  memory at a time, and the stride between positions there, in
//  vectors: one past the piece, so that the lanes reading different
//  positions are in different banks.
const uint PIECE = LANES;
const uint STRIDE = PIECE / 4u + 1u;

//  The chunk's numbers every lane reads: the decay and the rate a
//  position, the products of decays from one position to another, the
//  two triangles, where each position's state is written, and the root
//  of each position's mean square.
shared float decay[CHUNK];
shared float rate[CHUNK];
shared float between[CHUNK * CHUNK];
shared float gram[CHUNK * CHUNK];
shared float cross[CHUNK * CHUNK];
shared uint written[CHUNK];
shared float root[CHUNK];

//  A piece of the chunk's keys and queries, in vectors of four columns.
//  Read from the rows where they lie, a lane's reads of the keys were
//  the same for every lane, which the compiler made scalar loads --
//  thirty-two a row of the state, more than the scalar registers hold
//  on their way, so each waited for the one before; and the triangles'
//  reads were scattered over the chunk's rows, a cache line a lane a
//  step.
shared vec4 keys[CHUNK * STRIDE];
shared vec4 queries[CHUNK * STRIDE];

//  Every lane's sum of squares of every position, for the roots.
shared float partial[CHUNK * LANES];

float logistic(float v) {
    return 1.0 / (1.0 + exp(-clamp(v, -60.0, 60.0)));
}

float softplus(float v) {
    return v > 20.0 ? v : log(1.0 + exp(v));
}

//  The workgroup's run, head and lane, for the chunks.
uint lane;
uint h;
uint first;
uint run_count;
uint row0;
uint slots;
uint head;
uint key_of;
uint query_of;
uint value_of;
uint answer;
uint head_at;
uint kept_from;
float a_log;
float dt_bias;

//  A position's row in the source, and in the answer.
#define ROW(t) ((row0 + done + (t)) * shape.mix)
#define OUT(t) ((row0 + done + (t)) * answer + h * head)

//  The keys and queries of the chunk's n positions from column p0,
//  into shared memory; the lanes have to be through with the piece
//  before, and the piece has to be there before anybody reads it.
void stage(const uint n, uint done, uint p0) {
    uint i = p0 + lane;
    bool inside = i < head;

    barrier();

    [[unroll]] for (uint t = 0u; t < n; t++) {
        keys[t * STRIDE + lane / 4u][lane % 4u] =
            inside ? x[ROW(t) + key_of + i] : 0.0;
        queries[t * STRIDE + lane / 4u][lane % 4u] =
            inside ? x[ROW(t) + query_of + i] : 0.0;
    }

    barrier();
}

//  One chunk of n positions from position done of the run, beginning
//  from the state in read_at. The count is a constant at every call,
//  so that each call is its own kernel once the compiler is through:
//  the loops over the chunk's positions unroll to the count, and a
//  lane's numbers for its column stay in registers.
void chunk(const uint n, uint done, uint read_at) {
    //  The decay and the rate a position, where each position's state
    //  goes, and the products of the decays: lane t for position t, and
    //  then between (s, t) for s <= t is the decays from s + 1 to t, one
    //  for s = t -- products and not quotients of a running product,
    //  since a decay can be very small.
    if (lane < CHUNK) {
        uint t = lane;
        if (t < n) {
            uint p = row0 + done + t;
            float alpha = r[shape.alpha_at + p * shape.value_heads + h];
            float beta = r[shape.beta_at + p * shape.value_heads + h];
            decay[t] = exp(a_log * softplus(alpha + dt_bias));
            rate[t] = logistic(beta);

            uint slot = (first + done + t + 1u) % slots;
            bool keep = done + t >= kept_from || t == n - 1u;
            written[t] = keep ? head_at + slot * shape.every : NOWHERE;
        } else {
            decay[t] = 1.0;
            rate[t] = 0.0;
            written[t] = NOWHERE;
        }
    }

    barrier();

    if (lane < CHUNK) {
        uint sfrom = lane;
        float product = 1.0;
        between[sfrom * CHUNK + sfrom] = 1.0;
        for (uint t = sfrom + 1u; t < CHUNK; t++) {
            product *= decay[t];
            between[sfrom * CHUNK + t] = product;
        }
    }

    //  The two triangles: the keys against each other, gram (a, b) for
    //  a < b, and against the queries, cross (a, b) for a <= b, an
    //  entry a lane, summed over the pieces as they are staged for the
    //  first columns' pass.
    float kk[CHUNK * CHUNK / LANES];
    float kq[CHUNK * CHUNK / LANES];

    [[unroll]] for (uint e = 0u; e < CHUNK * CHUNK / LANES; e++) {
        kk[e] = 0.0;
        kq[e] = 0.0;
    }

    //  The columns of the state, LANES at a time.
    for (uint g = 0u; g < head; g += LANES) {
        //  A lane past the head takes the first column: it reads what
        //  lane 0 reads and computes what lane 0 computes, so what it
        //  writes there is what lane 0 writes, and nothing it does needs
        //  guarding but its square, which would count the column twice.
        uint j = g + lane;
        bool live = j < head;
        uint column = live ? j : 0u;

        //  What the state says of every key and every query of the
        //  chunk, from one pass over the state's rows, ROWS of them on
        //  their way at once, a piece of the keys and queries at a
        //  time. A row past the head is nothing, and what it reads of
        //  the piece is within it, so nothing needs guarding but the
        //  row.
        float of_key[CHUNK];
        float of_query[CHUNK];
        float fix[CHUNK];

        [[unroll]] for (uint t = 0u; t < n; t++) {
            of_key[t] = 0.0;
            of_query[t] = 0.0;
        }

        for (uint p0 = 0u; p0 < head; p0 += PIECE) {
            stage(n, done, p0);

            uint span = min(PIECE, head - p0);

            if (g == 0u) {
                [[unroll]] for (uint e = 0u; e < CHUNK * CHUNK / LANES; e++) {
                    uint entry = lane + e * LANES;
                    uint a = entry / CHUNK;
                    uint b = entry % CHUNK;

                    if (a <= b && b < n) {
                        for (uint c = 0u; c < (span + 3u) / 4u; c++) {
                            vec4 key = keys[a * STRIDE + c];
                            kk[e] += dot(key, keys[b * STRIDE + c]);
                            kq[e] += dot(key, queries[b * STRIDE + c]);
                        }
                    }
                }
            }

            for (uint i0 = 0u; i0 < span; i0 += ROWS) {
                vec4 state[VECS];

                [[unroll]] for (uint v = 0u; v < VECS; v++) {
                    [[unroll]] for (uint k = 0u; k < 4u; k++) {
                        uint i = p0 + i0 + v * 4u + k;
                        state[v][k] = i < head ? s[read_at + i * head + column] : 0.0;
                    }
                }

                [[unroll]] for (uint t = 0u; t < n; t++) {
                    [[unroll]] for (uint v = 0u; v < VECS; v++) {
                        vec4 key = keys[t * STRIDE + i0 / 4u + v];
                        vec4 query = queries[t * STRIDE + i0 / 4u + v];
                        [[unroll]] for (uint k = 0u; k < 4u; k++) {
                            of_key[t] += state[v][k] * key[k];
                            of_query[t] += state[v][k] * query[k];
                        }
                    }
                }
            }
        }

        if (g == 0u) {
            [[unroll]] for (uint e = 0u; e < CHUNK * CHUNK / LANES; e++) {
                gram[lane + e * LANES] = kk[e];
                cross[lane + e * LANES] = kq[e];
            }

            barrier();
        }

        //  The corrections, each from the ones before it: g_s is the
        //  decays from the chunk's start through s. The triangle is
        //  taken square, the half above the diagonal by nothing, so
        //  that every index is a constant and the corrections stay in
        //  registers.
        [[unroll]] for (uint t = 0u; t < n; t++) {
            fix[t] = 0.0;
        }

        [[unroll]] for (uint t = 0u; t < n; t++) {
            float g_t = between[t] * decay[0];
            float u = x[ROW(t) + value_of + column] - g_t * of_key[t];
            [[unroll]] for (uint q = 0u; q < n; q++) {
                float weight = q < t ? between[q * CHUNK + t] * gram[q * CHUNK + t] : 0.0;
                u -= weight * fix[q];
            }
            fix[t] = u * rate[t];
        }

        //  The answers, scaled, and each one's square into the sum the
        //  root comes from; the normalization waits for every column's
        //  square.
        [[unroll]] for (uint t = 0u; t < n; t++) {
            float o = between[t] * decay[0] * of_query[t];
            [[unroll]] for (uint q = 0u; q < n; q++) {
                float weight = q <= t ? between[q * CHUNK + t] * cross[q * CHUNK + t] : 0.0;
                o += weight * fix[q];
            }
            o *= uintBitsToFloat(shape.scale);
            y[OUT(t) + column] = o;
            float square = live ? o * o : 0.0;
            if (g == 0u) {
                partial[t * LANES + lane] = square;
            } else {
                partial[t * LANES + lane] += square;
            }
        }

        //  The states the chunk leaves, a row at a time from the row it
        //  began with: each position's is the one before decayed and
        //  corrected, and the ones nobody asks for are not written. The
        //  row is read before any position's is written, so a slot
        //  written may be the slot read.
        for (uint p0 = 0u; p0 < head; p0 += PIECE) {
            //  Still there from the pass before, where one piece is the
            //  head.
            if (head > PIECE) {
                stage(n, done, p0);
            }

            uint span = min(PIECE, head - p0);

            for (uint i0 = 0u; i0 < span; i0 += ROWS) {
                vec4 row[VECS];

                [[unroll]] for (uint v = 0u; v < VECS; v++) {
                    [[unroll]] for (uint k = 0u; k < 4u; k++) {
                        uint i = p0 + i0 + v * 4u + k;
                        row[v][k] = i < head ? s[read_at + i * head + column] : 0.0;
                    }
                }

                [[unroll]] for (uint t = 0u; t < n; t++) {
                    [[unroll]] for (uint v = 0u; v < VECS; v++) {
                        row[v] = row[v] * decay[t] + keys[t * STRIDE + i0 / 4u + v] * fix[t];
                    }

                    uint to = written[t];
                    if (to != NOWHERE) {
                        [[unroll]] for (uint v = 0u; v < VECS; v++) {
                            [[unroll]] for (uint k = 0u; k < 4u; k++) {
                                uint i = p0 + i0 + v * 4u + k;
                                if (i < head) {
                                    s[to + i * head + column] = row[v][k];
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    barrier();

    //  Each position's root from every lane's sum: the partials folded
    //  in halves, every position's at once.
    for (uint reach = LANES / 2u; reach > 0u; reach >>= 1u) {
        if (lane < reach) {
            [[unroll]] for (uint t = 0u; t < n; t++) {
                partial[t * LANES + lane] += partial[t * LANES + lane + reach];
            }
        }
        barrier();
    }

    if (lane < n) {
        root[lane] = 1.0 / sqrt(partial[lane * LANES] / float(head)
                                + uintBitsToFloat(shape.epsilon));
    }

    barrier();

    //  The answers normalized and gated.
    [[unroll]] for (uint t = 0u; t < n; t++) {
        for (uint j = lane; j < head; j += LANES) {
            uint o_at = OUT(t) + j;
            float z = r[shape.z_at + (row0 + done + t) * answer + h * head + j];
            float gain = w[shape.base + 2u * shape.value_heads + j];
            y[o_at] = y[o_at] * root[t] * gain * logistic(z) * z;
        }
    }

    //  The chunk's last state has to land before the next chunk reads
    //  it, and the shared numbers have to be read out before the next
    //  chunk writes them.
    memoryBarrierBuffer();
    barrier();
}

void main() {
    h = gl_WorkGroupID.x;
    uint run = gl_WorkGroupID.y;
    lane = gl_LocalInvocationID.x;

    if (h >= shape.value_heads || run >= shape.runs) {
        return;
    }

    uint at = shape.table_at + run * 5u;
    uint base = tab[at];
    first = tab[at + 1u];
    run_count = tab[at + 2u];
    row0 = tab[at + 3u];
    slots = tab[at + 4u];

    head = shape.head;
    uint kh = h % shape.key_heads;
    query_of = kh * head;
    key_of = shape.key_width + kh * head;
    value_of = 2u * shape.key_width + h * head;
    answer = shape.value_heads * head;
    a_log = w[shape.base + h];
    dt_bias = w[shape.base + shape.value_heads + h];

    //  The slot a chunk begins from walks the ring a chunk at a time,
    //  and the slot a position writes is the one after its own.
    head_at = base + shape.state_at + h * head * head;

    //  The first position the host keeps the state of.
    kept_from = run_count > slots ? run_count - slots : 0u;

    //  The run in chunks: whole ones while they last, then the rest in
    //  halves, so that a single position -- a token generated -- takes
    //  the kernel made for one.
    uint done = 0u;

    while (done < run_count) {
        uint left = run_count - done;
        uint read_at = head_at + ((first + done) % slots) * shape.every;
        uint n;

        if (left >= CHUNK) {
            n = CHUNK;
            chunk(CHUNK, done, read_at);
        } else if (left >= CHUNK / 2u) {
            n = CHUNK / 2u;
            chunk(CHUNK / 2u, done, read_at);
        } else if (left >= CHUNK / 4u) {
            n = CHUNK / 4u;
            chunk(CHUNK / 4u, done, read_at);
        } else if (left >= CHUNK / 8u) {
            n = CHUNK / 8u;
            chunk(CHUNK / 8u, done, read_at);
        } else {
            n = 1u;
            chunk(1u, done, read_at);
        }

        done += n;
    }
}
