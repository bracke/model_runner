#version 450

//  The root-mean-square normalization, on the device -- and the centred
//  one with a shift, which is the same kernel with a mean taken first.
//
//  It is here for what it saves around it rather than for itself. A layer
//  normalizes twice and each of those is a few thousand multiplications
//  against products of millions -- but the host doing them is the host
//  needing the products back, and that is a submission and a wait on a
//  fence. With this on the device the join and the normalization stop being
//  one of the three submissions a layer makes.
//
//  A workgroup a position, and the sum folded in a tree.
//
//  The processor adds a position's squares in order, and this does not: two
//  hundred and fifty-six lanes each add a stride of the row and then fold
//  those partials in eight halvings. A different association is a different
//  sum in the last bits, and a layer's normalization feeds everything after
//  it, so this is one of the few places on the device where the answer is
//  the conformance sweep's to judge rather than a digest's.
//
//  In binary32, and it used to be binary64 the whole way through the fold.
//  That was the wrong instrument on this part: a consumer RDNA3 device runs
//  double precision at a sixteenth of single, and this kernel is eight
//  squares a lane, eight folding steps and eight scaled stores -- all of
//  them doubles, on hardware that would rather not. Measured against
//  llama.cpp's own normalization, which is binary32 and does the same fold,
//  this one was three times slower for a sum whose error a tree already
//  bounds: two thousand and forty-eight squares folded pairwise carry a
//  relative error of a few parts in ten million, and the epsilon added to
//  the mean is a thousand times that.
//
//  Two earlier shapes are what argue for this one. Having a single
//  invocation walk the whole position -- loads and adds both -- cost three
//  hundred and twenty microseconds a layer, a third of a generated token:
//  one lane issuing two thousand dependent loads has nothing to hide their
//  latency behind. Having the lanes fetch each block together and one of
//  them add it up in order cost a hundred, and that hundred was the adds,
//  because the other two hundred and fifty-five lanes spend the whole sum
//  waiting at a barrier. Only the fold puts them to work.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

const uint LANES = 256u;

layout(local_size_x = LANES) in;

//  The weight, one element a component, which the device keeps resident the
//  way it keeps a matrix: a normalization weight is a tensor of the model
//  and reaches this the way every other tensor does.
layout(std430, binding = 0) readonly  buffer Weight { float g[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) writeonly buffer Target { float y[]; };

//  And the same answer in half precision, which is what the matrix
//  instruction's operand takes. Where everything that reads this
//  normalization is a tiled product, the binary32 answer above is written
//  and never read -- so this is written instead of it, not beside it, and
//  the conversion that used to make it does not run at all.
layout(std430, binding = 3) writeonly buffer Halves { float16_t h[]; };

layout(push_constant) uniform Shape {
    //  Components a position holds.
    uint width;

    //  One for the centred normalization with a shift: the mean taken
    //  off first, and a shift of the width read after the gain. Zero for
    //  the root-mean-square one, which reads the gain alone.
    uint centered;

    //  Positions in this batch.
    uint count;

    //  Epsilon, as the bits of a binary32 rather than as a float, because
    //  the block this shares with the other kernels is words.
    uint epsilon;

    //  Positions the half-precision copy is to hold, which is the batch
    //  rounded up to a whole tile: the positions between that and the count
    //  are the ones the rounding invented and they get zeros, because the
    //  tile has no test for a column it does not have.
    //
    //  Zero means write the binary32 answer as this always did. A run whose
    //  products all take the row shader has no half-precision buffer at
    //  all, and the binding this would write through is then the batch's
    //  own -- so the caller says, and this does not guess from a binding.
    uint room;

    //  Where the weight begins in the buffer the device kept it in, in
    //  elements: a kept weight shares its buffer with others.
    uint base;

    //  Whether the residual at binding four is added to what this makes,
    //  which is a join folded into the normalization before it: Gemma
    //  normalizes what attention and the feed-forward made before each is
    //  added back, and the join's own pass over both stops existing.
    uint joins;
} shape;

layout(std430, binding = 4) readonly buffer Residual { float rj[]; };

shared float partial[LANES];

//  The row this lane reads, held from the first pass to the last: a
//  stride a lane, sixteen of them, which is a width of four thousand and
//  ninety-six. A wider row reads the rest again.
const uint HELD = 16u;

//  Every lane's value added: in each subgroup, and then the subgroups'
//  sums through shared memory -- one barrier where the fold took eight,
//  and a normalization of a generated token is a workgroup alone, its
//  barriers the whole of its time.
float whole_sum (float v) {
    float mine = subgroupAdd (v);

    if (subgroupElect ()) {
        partial[gl_SubgroupID] = mine;
    }

    barrier ();

    float total = 0.0;

    for (uint g = 0u; g < gl_NumSubgroups; g++) {
        total += partial[g];
    }

    barrier ();
    return total;
}

void main() {
    uint slot = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    bool halved = shape.room > 0u;
    uint limit  = halved && shape.room > shape.count
                  ? shape.room : shape.count;

    if (slot >= limit) {
        return;
    }

    uint at = slot * shape.width;

    //  A position the rounding invented: zeros in the copy and none of the
    //  arithmetic below.
    if (slot >= shape.count) {
        for (uint c = lane; c < shape.width; c += LANES) {
            h[at + c] = float16_t (0.0);
        }

        return;
    }

    float row[HELD];

    //  And the gain and the residual with it, asked for before the sums
    //  rather than after them: nothing about them waits on the root, and
    //  a load issued after the barriers is a load whose latency nothing
    //  hides.
    float gain_of[HELD];
    float join_of[HELD];

    [[unroll]] for (uint k = 0u; k < HELD; k++) {
        uint c = lane + k * LANES;
        bool inside = c < shape.width;

        row[k] = inside ? x[at + c] : 0.0;
        gain_of[k] = inside ? g[shape.base + c] : 0.0;
        join_of[k] = inside && shape.joins != 0u ? rj[at + c] : 0.0;
    }

    //  The mean first, for the centred one, over the values rather than
    //  their squares.
    float mean = 0.0;

    if (shape.centered != 0u) {
        float total = 0.0;

        [[unroll]] for (uint k = 0u; k < HELD; k++) {
            total += row[k];
        }
        for (uint c = lane + HELD * LANES; c < shape.width; c += LANES) {
            total += x[at + c];
        }

        mean = whole_sum (total) / float (shape.width);
    }

    //  A stride a lane, so that the lanes of a turn read neighbours.
    float mine = 0.0;

    [[unroll]] for (uint k = 0u; k < HELD; k++) {
        if (lane + k * LANES < shape.width) {
            float v = row[k] - mean;
            mine += v * v;
        }
    }
    for (uint c = lane + HELD * LANES; c < shape.width; c += LANES) {
        float v = x[at + c] - mean;
        mine += v * v;
    }

    float squares = whole_sum (mine);

    float gain =
      sqrt (squares / float (shape.width)
            + uintBitsToFloat (shape.epsilon));

    //  A zero or non-finite scale means the input was degenerate. A unit
    //  gain keeps the layer's output finite so that the caller's own
    //  finiteness check reports the condition rather than the arithmetic
    //  doing it here, which is what the processor's does and for the same
    //  reason.
    if (gain == 0.0 || isinf (gain) || isnan (gain)) {
        gain = 1.0;
    } else {
        gain = 1.0 / gain;
    }

    //  And out, every lane at once: nothing here is serial either.
    for (uint c = lane; c < shape.width; c += LANES) {
        uint k = (c - lane) / LANES;
        bool held = k < HELD;
        float scaled = ((held ? row[k] : x[at + c]) - mean) * gain;

        float made = scaled * (held ? gain_of[k] : g[shape.base + c])
                     + (shape.centered != 0u
                        ? g[shape.base + shape.width + c] : 0.0);

        if (shape.joins != 0u) {
            made += held ? join_of[k] : rj[at + c];
        }

        if (halved) {
            h[at + c] = float16_t (made);
        } else {
            y[at + c] = made;
        }
    }
}
