#version 450

//  A step's result, packed into the cache the device holds: a byte an
//  element with a scale a row, or a nibble an element with a scale a block
//  of thirty-two, which are the two storages a session chooses with
//  --kv-cache q8 and q4.
//
//  place.comp writes a layer's keys and values into the exact cache so
//  that they never leave the device between the projection that made them
//  and the attention that reads them. A packed session had no such step:
//  the host read the rows back, rounded them and put the bytes there, and
//  stood between the two halves of every layer for it. This is that step
//  for a packed block, and it rounds as the host rounds -- the same scale,
//  the same level, the same byte -- so that the copy the host keeps, read
//  back out of this cache or packed on the host from the same rows, is the
//  same bytes.
//
//  Rounding as the host does it, exactly. A byte is the row's largest
//  magnitude over a hundred and twenty-seven for its scale and each
//  element over that scale rounded half away from zero, which is
//  Real'Rounding; the rounding is done with a floor and a difference, both
//  exact, rather than with round(), whose halves the language leaves to
//  the implementation. A nibble is the block's largest signed element
//  over minus eight for its scale and each element times the inverse plus
//  eight and a half, floored, held to the sixteen levels -- llama.cpp's
//  Q4_0 block, as the host packs it; the product and the sum are marked
//  precise so the compiler does not fuse them into one rounding where the
//  host makes two.
//
//  Every division goes through a double. A device's single-precision
//  division need only be within two and a half units of the last place,
//  and a reciprocal is one instruction that is not exact; the host's is
//  exact, and a level that lands on a whole number for one and just under
//  it for the other is a nibble apart. A double's quotient narrowed to a
//  single is the single the host computes: rounding twice is harmless for
//  division at these widths, since two singles' quotient is never within
//  a double's reach of a single's midpoint without being on one, which it
//  cannot be either. The turning table is doubles already, so the device
//  has them.
//
//  A workgroup a position. For bytes, the lanes find the row's largest
//  together and each then writes a word of four bytes; for nibbles, a lane
//  takes a block of thirty-two and writes its four words, since a block's
//  scale is its own and the blocks of a row are few.
//
//  A row need not fill whole words. A model whose heads are narrow -- four
//  elements a head in nibbles is two bytes a row -- leaves a row sharing a
//  word with the row after it, and the row after it is another workgroup
//  writing at the same time: a whole word written by each is each writing
//  the other's nibbles away. Where a word is partly this row's, the bits
//  that are go in by two atomic operations, one clearing them and one
//  setting them, which the workgroup beside it neither reads nor writes.
//  The caller used to refuse such a layer instead, and every narrow-headed
//  model with a packed cache took the road of pieces for it.

#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require

const uint LANES = 256u;
const uint BLOCK = 32u;

layout(local_size_x = LANES) in;

layout(std430, binding = 0) readonly  buffer Kept   { uint kept[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) buffer Words  { uint  kvw[]; };
layout(std430, binding = 2) writeonly buffer Scales { float kvf[]; };

layout(push_constant) uniform Shape {
    //  Elements a position holds.
    uint width;

    //  Bytes from one position's packed row to the next.
    uint row_bytes;

    //  Positions in this batch.
    uint count;

    //  Where the first of them goes, in bytes of the cache buffer.
    uint at_byte;

    //  Eight or four: how many bits an element.
    uint bits;

    //  Where the first position's scales go, in floats of the cache
    //  buffer, and how many a row has.
    uint at_scale;
    uint blocks;

    //  A round: where its per-row table begins, in words, or zero for a
    //  batch. A batch's rows go one after the first; a round's each into
    //  its own member's block at its own position, which the table says
    //  as place.comp reads it -- where the row has got to, and where its
    //  block begins in words.
    uint table_at;

    //  A cache in pages rather than blocks, as place.comp has it: where
    //  this batch's page table for the layer begins, a word a page of
    //  page_shift's power of two positions; at_byte and at_scale are then
    //  a region's offset inside a page, and a position's page holds it. A
    //  round's rows carry their own page table in the per-row table, where
    //  a block's base was. Zero for page_shift is a cache in blocks.
    uint pages_at;
    uint page_shift;
    uint first_position;
} shape;

#ifdef SUBGROUPS
shared float shared_max[64];

//  The largest of a value across the workgroup.
float whole_max (float mine) {
    float found = subgroupMax (mine);

    if (gl_NumSubgroups == 1u) {
        return found;
    }

    if (subgroupElect ()) {
        shared_max[gl_SubgroupID] = found;
    }
    barrier ();

    float whole = shared_max[0];
    for (uint i = 1u; i < gl_NumSubgroups; i++) {
        whole = max (whole, shared_max[i]);
    }
    barrier ();
    return whole;
}
#else
shared float shared_max[LANES];

float whole_max (float mine) {
    shared_max[gl_LocalInvocationID.x] = mine;
    barrier ();

    float whole = shared_max[0];
    for (uint i = 1u; i < LANES; i++) {
        whole = max (whole, shared_max[i]);
    }
    barrier ();
    return whole;
}
#endif

//  One word of a row's packed bytes or nibbles, written where the whole of
//  it is the row's and merged where it is not: the bits that are not this
//  row's belong to the row before or after, which is another workgroup
//  writing them now.
//
//  @param at Word of the cache buffer.
//  @param word What this row puts there, in its own bits.
//  @param mask Which bits of the word are this row's.
void put_word (uint at, uint word, uint mask) {
    if (mask == 0xFFFFFFFFu) {
        kvw[at] = word;
        return;
    }

    atomicAnd (kvw[at], ~mask);
    atomicOr (kvw[at], word & mask);
}

//  Real'Rounding: to the nearest whole number, halves away from zero.
float rounded (float v) {
    float r = floor (v);
    float f = v - r;
    if (f > 0.5 || (f == 0.5 && v > 0.0)) {
        return r + 1.0;
    }
    return r;
}

void main() {
    uint slot = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (slot >= shape.count) {
        return;
    }

    uint from = slot * shape.width;

    //  Where this row's packed bytes and its scales go. A block: the
    //  member's block in words, four bytes a word, and the position inside
    //  it. A page: the position's page out of the table -- the batch's or,
    //  for a round, the row's own -- and the place inside the page. The
    //  page base is in words as a block is, so it turns to bytes the same
    //  way.
    uint row_at;
    uint scale_at;

    if (shape.page_shift == 0u) {
        uint cell = shape.table_at != 0u ? kept[shape.table_at + slot * 2u] : slot;
        uint block = shape.table_at != 0u ? kept[shape.table_at + slot * 2u + 1u] : 0u;
        row_at = shape.at_byte + block * 4u + cell * shape.row_bytes;
        scale_at = shape.at_scale + block + cell * shape.blocks;
    } else {
        uint table = shape.table_at != 0u
                   ? kept[shape.table_at + slot * 2u + 1u]
                   : shape.pages_at;
        uint pos = shape.table_at != 0u
                 ? kept[shape.table_at + slot * 2u]
                 : shape.first_position + slot;
        uint base = kept[table + (pos >> shape.page_shift)];
        uint in_page = pos & ((1u << shape.page_shift) - 1u);
        row_at = shape.at_byte + base * 4u + in_page * shape.row_bytes;
        scale_at = shape.at_scale + base + in_page * shape.blocks;
    }

    if (shape.bits == 8u) {
        float largest = 0.0;
        for (uint c = lane; c < shape.width; c += LANES) {
            largest = max (largest, abs (x[from + c]));
        }
        largest = whole_max (largest);

        float scale = largest > 0.0 ? float (double (largest) / 127.0lf) : 1.0;
        if (lane == 0u) {
            kvf[scale_at] = scale;
        }

        //  A word of the cache at a time, over the words the row's bytes
        //  fall in: a row that begins or ends inside a word shares it
        //  with its neighbour, and only the bytes that are this row's go
        //  in. A lane a word.
        int first = int (row_at) >> 2;
        int last = int (row_at + shape.width - 1u) >> 2;

        for (int wi = first + int (lane); wi <= last; wi += int (LANES)) {
            uint word = 0u;
            uint mask = 0u;

            for (uint k = 0u; k < 4u; k++) {
                int c = wi * 4 + int (k) - int (row_at);

                if (c >= 0 && c < int (shape.width)) {
                    float step =
                      rounded (float (double (x[from + uint (c)])
                                      / double (scale)));
                    float held = max (-127.0, min (127.0, step));
                    uint byte = uint (int (held) + 128);

                    word |= byte << (8u * k);
                    mask |= 0xFFu << (8u * k);
                }
            }

            put_word (uint (wi), word, mask);
        }
        return;
    }

    //  Nibbles: a lane a block.
    for (uint b = lane; b * BLOCK < shape.width; b += LANES) {
        uint start = b * BLOCK;
        uint span = min (BLOCK, shape.width - start);

        float largest = 0.0;
        float signed_largest = 0.0;
        for (uint i = 0u; i < span; i++) {
            float v = x[from + start + i];
            if (abs (v) > largest) {
                largest = abs (v);
                signed_largest = v;
            }
        }
        float scale = signed_largest / (-8.0);
        float inverse = scale != 0.0 ? float (1.0lf / double (scale)) : 0.0;
        kvf[scale_at + b] = scale;

        //  A word of the cache at a time, over the words the block's
        //  nibbles fall in: the nibbles of a word this block begins or
        //  ends inside belong to the block or the row beside it, and only
        //  this block's go in. A row of four elements in nibbles is two
        //  bytes, so half of its one word is the row after it.
        uint block_at = row_at + start / 2u;
        int first = int (block_at) >> 2;
        int last = int (block_at + (span + 1u) / 2u - 1u) >> 2;

        for (int wi = first; wi <= last; wi++) {
            uint word = 0u;
            uint mask = 0u;

            for (uint k = 0u; k < 8u; k++) {
                int i = (wi * 4 - int (block_at)) * 2 + int (k);

                if (i >= 0 && i < int (span)) {
                    precise float level =
                      floor (x[from + start + uint (i)] * inverse + 8.5);
                    uint nibble = uint (int (max (0.0, min (15.0, level))));

                    word |= nibble << (4u * k);
                    mask |= 0xFu << (4u * k);
                }
            }

            put_word (uint (wi), word, mask);
        }
    }
}
