#version 450

//  A step's result, packed into the cache the device holds: a byte an
//  element with a scale a row, an OCP E4M3FN byte, or a nibble an element
//  with a scale a block of thirty-two, selected by --kv-cache q8,
//  f8_e4m3 and q4.
//
//  place.comp writes a layer's keys and values into the exact cache so
//  that they never leave the device between the projection that made them
//  and the attention that reads them. A packed session had no such step:
//  the host read the rows back, rounded them and put the bytes there, and
//  stood between the two halves of every layer for it. This is that step
//  for a packed block, and it rounds as the host rounds -- the same scale,
//  the same level, the same byte -- so that the copy the host keeps, read
//  back out of this cache or packed on the host from the same rows, is the
//  same bytes.
//
//  Rounding as the host does it, exactly. A byte is the row's largest
//  magnitude over a hundred and twenty-seven for its scale and each
//  element over that scale rounded half away from zero, which is
//  Real'Rounding; the rounding is done with a floor and a difference, both
//  exact, rather than with round(), whose halves the language leaves to
//  the implementation. A nibble is the block's largest signed element
//  over minus eight for its scale and each element times the inverse plus
//  eight and a half, floored, held to the sixteen levels -- llama.cpp's
//  Q4_0 block, as the host packs it; the product and the sum are marked
//  precise so the compiler does not fuse them into one rounding where the
//  host makes two.
//
//  Every division goes through a double. A device's single-precision
//  division need only be within two and a half units of the last place,
//  and a reciprocal is one instruction that is not exact; the host's is
//  exact, and a level that lands on a whole number for one and just under
//  it for the other is a nibble apart. A double's quotient narrowed to a
//  single is the single the host computes: rounding twice is harmless for
//  division at these widths, since two singles' quotient is never within
//  a double's reach of a single's midpoint without being on one, which it
//  cannot be either. The turning table is doubles already, so the device
//  has them.
//
//  A workgroup a position. For bytes, the lanes find the row's largest
//  together and each then writes a word of four bytes; for nibbles, a lane
//  takes a block of thirty-two and writes its four words, since a block's
//  scale is its own and the blocks of a row are few.
//
//  A row need not fill whole words. A model whose heads are narrow -- four
//  elements a head in nibbles is two bytes a row -- leaves a row sharing a
//  word with the row after it, and the row after it is another workgroup
//  writing at the same time: a whole word written by each is each writing
//  the other's nibbles away. Where a word is partly this row's, the bits
//  that are go in by two atomic operations, one clearing them and one
//  setting them, which the workgroup beside it neither reads nor writes.
//  The caller used to refuse such a layer instead, and every narrow-headed
//  model with a packed cache took the road of pieces for it.

#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle    : require

const uint LANES = 256u;
const uint BLOCK = 32u;
const uint E4M3_BITS = 9u;
const uint TRANSFORMED_FOUR_BIT_CODEC = 2u;
const uint Q4T_SIGN_MASK = 0xD6E8FEB8u;

layout(local_size_x = LANES) in;

layout(std430, binding = 0) readonly  buffer Kept   { uint kept[]; };
layout(std430, binding = 1) readonly  buffer Source { float x[]; };
layout(std430, binding = 2) buffer Words  { uint  kvw[]; };
layout(std430, binding = 2) writeonly buffer Scales { float kvf[]; };

layout(push_constant) uniform Shape {
    //  Elements a position holds.
    uint width;

    //  Bytes from one position's packed row to the next.
    uint row_bytes;

    //  Positions in this batch.
    uint count;

    //  Where the first of them goes, in bytes of the cache buffer.
    uint at_byte;

    //  Eight or four: how many bits an element.
    uint bits;

    //  Where the first position's scales go, in floats of the cache
    //  buffer, and how many a row has.
    uint at_scale;
    uint blocks;

    //  Reserved, always zero: the products keep the word for layout.
    uint table_at;

    //  A cache in pages rather than blocks, as place.comp has it: where
    //  this batch's page table for the layer begins, a word a page of
    //  page_shift's power of two positions; at_byte and at_scale are then
    //  a region's offset inside a page, and a position's page holds it.
    //  Zero for page_shift is a cache in blocks.
    uint pages_at;
    uint page_shift;
    uint first_position;

    //  Explicit codec identity. Zero is scaled integer, one is E4M3 and
    //  two is transformed Q4; the bit width alone never selects q4t.
    uint codec;
} shape;

#ifdef SUBGROUPS
shared float shared_max[64];

//  The largest of a value across the workgroup.
float whole_max (float mine) {
    float found = subgroupMax (mine);

    if (gl_NumSubgroups == 1u) {
        return found;
    }

    if (subgroupElect ()) {
        shared_max[gl_SubgroupID] = found;
    }
    barrier ();

    float whole = shared_max[0];
    for (uint i = 1u; i < gl_NumSubgroups; i++) {
        whole = max (whole, shared_max[i]);
    }
    barrier ();
    return whole;
}
#else
shared float shared_max[LANES];

float whole_max (float mine) {
    shared_max[gl_LocalInvocationID.x] = mine;
    barrier ();

    float whole = shared_max[0];
    for (uint i = 1u; i < LANES; i++) {
        whole = max (whole, shared_max[i]);
    }
    barrier ();
    return whole;
}
#endif

//  One word of a row's packed bytes or nibbles, written where the whole of
//  it is the row's and merged where it is not: the bits that are not this
//  row's belong to the row before or after, which is another workgroup
//  writing them now.
//
//  @param at Word of the cache buffer.
//  @param word What this row puts there, in its own bits.
//  @param mask Which bits of the word are this row's.
void put_word (uint at, uint word, uint mask) {
    if (mask == 0xFFFFFFFFu) {
        kvw[at] = word;
        return;
    }

    atomicAnd (kvw[at], ~mask);
    atomicOr (kvw[at], word & mask);
}

//  Real'Rounding: to the nearest whole number, halves away from zero.
float rounded (float v) {
    float r = floor (v);
    float f = v - r;
    if (f > 0.5 || (f == 0.5 && v > 0.0)) {
        return r + 1.0;
    }
    return r;
}

//  Round a non-negative number to the nearest whole number, ties to even.
uint nearest_even (float value) {
    float below = floor (value);
    uint whole = uint (below);
    float part = value - below;
    return whole + ((part > 0.5 || (part == 0.5 && (whole & 1u) != 0u))
                    ? 1u : 0u);
}

//  Binary32 to OCP E4M3FN, the same cases and rounding as the host codec.
uint e4m3_of (float value) {
    uint raw = floatBitsToUint (value);
    uint sign = (raw >> 24u) & 0x80u;
    uint exponent = (raw >> 23u) & 0xFFu;
    uint mantissa = raw & 0x7FFFFFu;

    if (exponent == 0xFFu) {
        return sign | (mantissa == 0u ? 0x7Eu : 0x7Fu);
    }
    if (exponent == 0u && mantissa == 0u) {
        return sign;
    }

    float magnitude = uintBitsToFloat (raw & 0x7FFFFFFFu);
    int power = int (exponent) - 127;
    uint encoded;

    if (power < -6) {
        encoded = min (8u, nearest_even (magnitude * 512.0));
    } else if (power > 8) {
        encoded = 0x7Eu;
    } else {
        uint quantized = nearest_even
          (magnitude / exp2 (float (power - 3)));
        if (quantized == 16u) {
            quantized = 8u;
            encoded = power == 8
                      ? 0x7Eu : uint (power + 8) * 8u + quantized - 8u;
        } else if (power == 8) {
            encoded = min (0x7Eu, 15u * 8u + quantized - 8u);
        } else {
            encoded = uint (power + 7) * 8u + quantized - 8u;
        }
    }
    return sign | encoded;
}

void main() {
    uint slot = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (slot >= shape.count) {
        return;
    }

    uint from = slot * shape.width;

    //  Where this row's packed bytes and its scales go. A block: the first
    //  member's block in words, four bytes a word, and the position inside
    //  it. A page: the position's page out of the batch's table and the
    //  place inside the page. The page base is in words as a block is, so
    //  it turns to bytes the same way.
    uint row_at;
    uint scale_at;

    if (shape.page_shift == 0u) {
        uint cell = slot;
        uint block = 0u;
        row_at = shape.at_byte + block * 4u + cell * shape.row_bytes;
        scale_at = shape.at_scale + block + cell * shape.blocks;
    } else {
        uint table = shape.pages_at;
        uint pos = shape.first_position + slot;
        uint base = kept[table + (pos >> shape.page_shift)];
        uint in_page = pos & ((1u << shape.page_shift) - 1u);
        row_at = shape.at_byte + base * 4u + in_page * shape.row_bytes;
        scale_at = shape.at_scale + base + in_page * shape.blocks;
    }

    if (shape.bits == E4M3_BITS) {
        if (lane == 0u) {
            //  E4M3 has no quantization scale, but the common packed-cache
            //  layout retains this slot. Keep snapshots deterministic and
            //  identical to the host representation.
            kvf[scale_at] = 1.0;
        }
        uint first = row_at >> 2;
        uint last = (row_at + shape.width - 1u) >> 2;

        for (uint wi = first + lane; wi <= last; wi += LANES) {
            uint word = 0u;
            uint mask = 0u;

            for (uint k = 0u; k < 4u; k++) {
                int c = int (wi * 4u + k - row_at);
                if (c >= 0 && c < int (shape.width)) {
                    word |= e4m3_of (x[from + uint (c)]) << (8u * k);
                    mask |= 0xFFu << (8u * k);
                }
            }
            put_word (wi, word, mask);
        }
        return;
    }

    if (shape.bits == 8u) {
        float largest = 0.0;
        for (uint c = lane; c < shape.width; c += LANES) {
            largest = max (largest, abs (x[from + c]));
        }
        largest = whole_max (largest);

        float scale = largest > 0.0 ? float (double (largest) / 127.0lf) : 1.0;
        if (lane == 0u) {
            kvf[scale_at] = scale;
        }

        //  A word of the cache at a time, over the words the row's bytes
        //  fall in: a row that begins or ends inside a word shares it
        //  with its neighbour, and only the bytes that are this row's go
        //  in. A lane a word.
        //  The words counted unsigned, a cache past two gigabytes being a
        //  byte offset no signed word holds; only the offset within the
        //  row, a few bytes either side, is signed.
        uint first = row_at >> 2;
        uint last = (row_at + shape.width - 1u) >> 2;

        for (uint wi = first + lane; wi <= last; wi += LANES) {
            uint word = 0u;
            uint mask = 0u;

            for (uint k = 0u; k < 4u; k++) {
                int c = int (wi * 4u + k - row_at);

                if (c >= 0 && c < int (shape.width)) {
                    float step =
                      rounded (float (double (x[from + uint (c)])
                                      / double (scale)));
                    float held = max (-127.0, min (127.0, step));
                    uint byte = uint (int (held) + 128);

                    word |= byte << (8u * k);
                    mask |= 0xFFu << (8u * k);
                }
            }

            put_word (wi, word, mask);
        }
        return;
    }

    //  Transformed nibbles: a lane rotates and packs one group. The
    //  butterfly and its double intermediates mirror the host codec. A
    //  short last group is partitioned greedily into power-of-two pieces.
    if (shape.codec == TRANSFORMED_FOUR_BIT_CODEC) {
#ifdef SUBGROUPS
        //  Production q4t rows are whole transform groups and word-aligned.
        //  Give a group to thirty-two lanes: the five butterfly stages are
        //  subgroup shuffles, and four leaders write its four words. Keep
        //  the scalar path below for partial test rows and unaligned rows.
        if (gl_SubgroupSize >= BLOCK
            && shape.width % BLOCK == 0u && (row_at & 3u) == 0u) {
            //  A sixty-four-lane subgroup computes the group twice, one
            //  copy in each half; that lets the ordinary subgroup maximum
            //  and minimum stand in for clustered operations without
            //  requiring that optional device feature. Only its lower half
            //  writes. A thirty-two-lane subgroup computes it once.
            uint cohort = gl_SubgroupID;
            uint within = gl_SubgroupInvocationID % BLOCK;
            uint cohorts = gl_NumSubgroups;

            for (uint b = cohort; b * BLOCK < shape.width; b += cohorts) {
                double turned = double (x[from + b * BLOCK + within]);
                if (((Q4T_SIGN_MASK >> within) & 1u) != 0u) {
                    turned = -turned;
                }
                for (uint step = 1u; step < BLOCK; step *= 2u) {
                    double other = subgroupShuffleXor (turned, step);
                    turned = (within & step) == 0u
                             ? turned + other : other - turned;
                }
                float rotated = float (turned / sqrt (double (BLOCK)));

                float magnitude = abs (rotated);
                float largest = subgroupMax (magnitude);
                uint winner = subgroupMin
                  (magnitude == largest ? within : BLOCK);
                float signed_largest = subgroupShuffle (rotated, winner);

                float scale = signed_largest / (-8.0);
                float inverse = scale != 0.0
                                ? float (1.0lf / double (scale)) : 0.0;
                if (gl_SubgroupInvocationID == 0u) {
                    kvf[scale_at + b] = scale;
                }

                precise float level = floor (rotated * inverse + 8.5);
                uint nibble = uint (int (max (0.0, min (15.0, level))));
                uint word = nibble << (4u * (within & 7u));
                for (uint step = 1u; step < 8u; step *= 2u) {
                    word += subgroupShuffleXor (word, step);
                }
                if (gl_SubgroupInvocationID < BLOCK
                    && (within & 7u) == 0u) {
                    uint wi = (row_at + b * (BLOCK / 2u)) / 4u + within / 8u;
                    put_word (wi, word, 0xFFFFFFFFu);
                }
            }
            return;
        }
#endif
        for (uint b = lane; b * BLOCK < shape.width; b += LANES) {
            uint start = b * BLOCK;
            uint span = min (BLOCK, shape.width - start);
            double scratch[32];
            float rotated[32];
            uint used = 0u;

            while (used < span) {
                uint width = 1u;
                while (width * 2u <= span - used) {
                    width *= 2u;
                }
                for (uint i = 0u; i < width; i++) {
                    double v = double (x[from + start + used + i]);
                    scratch[i] = ((Q4T_SIGN_MASK >> (used + i)) & 1u) == 0u
                               ? v : -v;
                }
                for (uint step = 1u; step < width; step *= 2u) {
                    for (uint block = 0u; block < width; block += step * 2u) {
                        for (uint i = 0u; i < step; i++) {
                            double a = scratch[block + i];
                            double z = scratch[block + step + i];
                            scratch[block + i] = a + z;
                            scratch[block + step + i] = a - z;
                        }
                    }
                }
                double normalizer = 1.0lf / sqrt (double (width));
                for (uint i = 0u; i < width; i++) {
                    rotated[used + i] = float (scratch[i] * normalizer);
                }
                used += width;
            }

            float largest = 0.0;
            float signed_largest = 0.0;
            for (uint i = 0u; i < span; i++) {
                if (abs (rotated[i]) > largest) {
                    largest = abs (rotated[i]);
                    signed_largest = rotated[i];
                }
            }
            float scale = signed_largest / (-8.0);
            float inverse = scale != 0.0 ? float (1.0lf / double (scale)) : 0.0;
            kvf[scale_at + b] = scale;

            uint block_at = row_at + start / 2u;
            uint first = block_at >> 2;
            uint last = (block_at + (span + 1u) / 2u - 1u) >> 2;
            for (uint wi = first; wi <= last; wi++) {
                uint word = 0u;
                uint mask = 0u;
                for (uint k = 0u; k < 8u; k++) {
                    int i = int (wi * 4u - block_at) * 2 + int (k);
                    if (i >= 0 && i < int (span)) {
                        precise float level =
                          floor (rotated[uint (i)] * inverse + 8.5);
                        uint nibble = uint (int (max (0.0, min (15.0, level))));
                        word |= nibble << (4u * k);
                        mask |= 0xFu << (4u * k);
                    }
                }
                put_word (wi, word, mask);
            }
        }
        return;
    }

    //  Ordinary nibbles: a lane a block.
    for (uint b = lane; b * BLOCK < shape.width; b += LANES) {
        uint start = b * BLOCK;
        uint span = min (BLOCK, shape.width - start);

        float largest = 0.0;
        float signed_largest = 0.0;
        for (uint i = 0u; i < span; i++) {
            float v = x[from + start + i];
            if (abs (v) > largest) {
                largest = abs (v);
                signed_largest = v;
            }
        }
        float scale = signed_largest / (-8.0);
        float inverse = scale != 0.0 ? float (1.0lf / double (scale)) : 0.0;
        kvf[scale_at + b] = scale;

        //  A word of the cache at a time, over the words the block's
        //  nibbles fall in: the nibbles of a word this block begins or
        //  ends inside belong to the block or the row beside it, and only
        //  this block's go in. A row of four elements in nibbles is two
        //  bytes, so half of its one word is the row after it.
        uint block_at = row_at + start / 2u;
        uint first = block_at >> 2;
        uint last = (block_at + (span + 1u) / 2u - 1u) >> 2;

        for (uint wi = first; wi <= last; wi++) {
            uint word = 0u;
            uint mask = 0u;

            for (uint k = 0u; k < 8u; k++) {
                int i = int (wi * 4u - block_at) * 2 + int (k);

                if (i >= 0 && i < int (span)) {
                    precise float level =
                      floor (x[from + start + uint (i)] * inverse + 8.5);
                    uint nibble = uint (int (max (0.0, min (15.0, level))));

                    word |= nibble << (4u * k);
                    mask |= 0xFu << (4u * k);
                }
            }

            put_word (wi, word, mask);
        }
    }
}
