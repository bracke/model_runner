#version 450

//  A tile of the answer at a time, through the device's matrix instruction.
//
//  This computes the same thing row_product.comp computes -- y[v][row] over
//  a batch of vectors -- and computes it as a matrix product rather than as
//  a row product repeated. The difference is not the instruction. It is the
//  shape of the work:
//
//  The row product carries GROUP vectors per invocation, so a batch longer
//  than GROUP is several dispatches and the weights are read once for each
//  of them. A hundred and twenty-eight vectors at eight a dispatch is
//  sixteen passes over the whole model. Raising GROUP does not fix it and
//  was measured not to: sixteen reads 1.219 s against eight's 1.054,
//  because what an invocation re-reads is the activations rather than the
//  weights.
//
//  A tile reads both once. One workgroup takes thirty-two rows and a
//  hundred and twenty-eight vectors and walks the columns, so the weights
//  are read once for the whole batch and the activations once for the
//  whole tile of rows.
//
//  Six formats -- half precision, brain floating point, eight-bit blocks
//  and the four-, five- and six-bit k-quants -- and only where the device
//  offers VK_KHR_cooperative_matrix with a sixteen-by-sixteen-by-sixteen
//  half-precision shape at subgroup scope.
//
//  Binary32 weights are deliberately not among them. The tile's operand is
//  half precision, so a binary32 weight would lose thirteen bits of
//  mantissa on the way in, and a caller who has chosen to keep a model at
//  binary32 has asked for exactly those bits. The two sixteen-bit formats
//  lose nothing: half precision is already what the tile holds, and brain
//  floating point has fewer mantissa bits than half precision has, so the
//  widening is exact for every value inside half precision's range.
//  Everything else goes to row_product.comp, which reads all fifteen
//  formats and needs nothing of the device beyond Vulkan 1.0.
//
//  This source is compiled twice. As it stands it decodes the six formats
//  a published model is usually made of; with MORE_FORMATS defined it
//  decodes eight others instead, and the engine picks the pipeline by the
//  weights it is given. Two compilations rather than one shader of
//  fourteen branches, because a pipeline pays for every branch compiled
//  into it whether or not the branch is ever taken -- adding the eight to
//  this one cost the six twenty-one per cent with the host refusing to
//  send them, so with not a line of the new code reachable. Registers are
//  allocated for the whole shader and the occupancy that follows is the
//  occupancy of every dispatch.
//
//  They share a source rather than a pipeline because only the decode
//  differs: the tile, the accumulators, the operand loads and the store are
//  the same instructions in the same order. The branch is on a push
//  constant, so it is uniform across a workgroup and taken once a step.
//
//  Those four are what a published model is made of. A "_M" file is a
//  mixture by construction -- four or five bits for most of it, six for the
//  output projection and a handful of others -- so a shader that took only
//  one of them left the other on the row product and the file no faster
//  than the sum of its slower half.
//
//  The activations are read as half precision, from a copy half_batch.comp
//  made before this ran. That is not an optimization, it is the only way
//  the instruction will take them: loading binary32 into a half-precision
//  matrix does not convert, it reinterprets, and the answers come back as
//  not-a-number. The copy is made once for a product rather than once for
//  a workgroup, which an earlier attempt at this measured as a seventh of
//  its time when each workgroup made its own.
//
//  The weights are decoded into shared memory, because the instruction
//  loads a matrix from an array and a Q8_0 block is a scale and thirty-two
//  bytes rather than an array of numbers. Thirty-two rows by thirty-two
//  columns of half precision is two kilobytes, which is small enough that
//  the tile is not what bounds how many of these a part will run.

#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

//  One subgroup, and the host has established that a subgroup here is
//  sixty-four invocations. The instruction is at subgroup scope, so a
//  workgroup of more than one would need each of them told which part of
//  the tile it owns; one is simpler and measured faster than two or four
//  at every tile shape tried.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Weights { uint      w[]; };
layout(std430, binding = 2) writeonly buffer Result  { float     y[]; };

//  The batch in half precision, as half_batch.comp left it: the same
//  vector-major layout the binary32 copy has, padded up to a multiple of
//  sixteen vectors with zeros.
layout(std430, binding = 3) readonly  buffer Halves  { float16_t x[]; };

layout(push_constant) uniform Shape {
    uint rows;
    uint columns;
    uint count;
    uint first;
    uint format;
    uint base;
} shape;

//  Rows and vectors of the answer one workgroup computes, and how much of
//  the columns it takes at a time. The step is one Q8_0 block deep, which
//  is what makes the decode below a whole number of blocks; sixty-four and
//  a hundred and twenty-eight were measured and are slower.
const uint TILE_R = 32u;
const uint TILE_V = 64u;
const uint KCH    = 32u;

//  Which is two matrices of weights and eight of vectors, so sixteen
//  accumulators. Eight against two is the way round that measured fastest
//  -- 1709 against 328 gigaflops for two against eight -- because a
//  weight matrix comes from shared memory and is used eight times, where
//  a vector matrix comes from memory and is used twice.
const uint AR = TILE_R / 16u;
const uint AV = TILE_V / 16u;

shared float16_t wt[TILE_R * KCH];

//  The two formats this decodes, numbered as Weight_Packing'Pos numbers
//  them, which is the same numbering row_product.comp is given.
const uint FMT_F16  = 1u;
const uint FMT_BF16 = 2u;
const uint FMT_Q8_0 = 7u;
const uint FMT_Q4_K = 11u;
const uint FMT_Q5_K = 12u;
const uint FMT_Q6_K = 13u;

uint byte_at(uint at) { return (w[at >> 2u] >> ((at & 3u) * 8u)) & 255u; }

float half_at(uint at) {
    return unpackHalf2x16(byte_at(at) | (byte_at(at + 1u) << 8u)).x;
}

//  One byte read as a signed number, which is how Q6_K keeps a sub-block
//  scale.
int signed_at(uint at) {
    int value = int(byte_at(at));
    return value > 127 ? value - 256 : value;
}

//  Sixteen bytes as four words. A block of any of these formats begins on a
//  four-byte boundary for every other block and two bytes into one for the
//  rest -- thirty-four and two hundred and ten are both two more than a
//  multiple of four -- so the odd case is shifted into place. Four loads
//  where a byte at a time is sixteen loads and sixteen shifts.
void four_words (uint at, out uint p0, out uint p1, out uint p2, out uint p3)
{
    uint i = at >> 2u;

    if ((at & 3u) == 0u) {
        p0 = w[i]; p1 = w[i + 1u]; p2 = w[i + 2u]; p3 = w[i + 3u];
    } else {
        uint a0 = w[i], a1 = w[i + 1u], a2 = w[i + 2u];
        uint a3 = w[i + 3u], a4 = w[i + 4u];
        p0 = (a0 >> 16u) | (a1 << 16u);
        p1 = (a1 >> 16u) | (a2 << 16u);
        p2 = (a2 >> 16u) | (a3 << 16u);
        p3 = (a3 >> 16u) | (a4 << 16u);
    }
}

//  The six-bit scale and minimum a Q4_K sub-block carries, as
//  row_product.comp reads them and for the same reason: twelve bytes hold
//  sixteen six-bit numbers, the first four pairs whole in a byte each and
//  the last four split, four bits in one byte and two in the top of another
//  that a lower sub-block is already using.
void sub_block_scale(uint at, uint index, out uint factor, out uint lowest) {
    if (index < 4u) {
        factor = byte_at(at + index) & 63u;
        lowest = byte_at(at + index + 4u) & 63u;
    } else {
        factor = (byte_at(at + index + 4u) & 15u)
                 | ((byte_at(at + index - 4u) >> 6u) << 4u);
        lowest = (byte_at(at + index + 4u) >> 4u)
                 | ((byte_at(at + index) >> 6u) << 4u);
    }
}

#ifdef MORE_FORMATS

const uint FMT_Q4_0   =  3u;
const uint FMT_Q4_1   =  4u;
const uint FMT_Q5_0   =  5u;
const uint FMT_Q5_1   =  6u;
const uint FMT_IQ4_NL =  8u;
const uint FMT_Q2_K   =  9u;
const uint FMT_Q3_K   = 10u;
const uint FMT_IQ4_XS = 14u;

//  The sixteen levels a non-linear four-bit quant may take. A nibble in
//  IQ4_NL and IQ4_XS is not a number but an index into this, and the table
//  belongs to the format rather than to any file.
const int LEVELS[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10,
                                  1,   13,  25,  38,  53,  69,  89, 113);

//  Whether a format keeps thirty-two elements to a block rather than two
//  hundred and fifty-six, which decides how a row's length is counted.
bool is_short (uint format) {
    return format >= FMT_Q4_0 && format <= FMT_IQ4_NL;
}

//  And which of those keep them as nibbles. The eight-bit format sits in
//  the middle of that range and is not one of them, which is worth a
//  predicate of its own: it was caught by the range once and decoded as
//  nibbles, and the format test said so at the first element.
bool is_nibble (uint format) {
    return is_short (format) && format != FMT_Q8_0;
}

//  Bytes one block takes.
uint block_bytes (uint format) {
    switch (format) {
        case FMT_Q4_0:
        case FMT_IQ4_NL: return  18u;
        case FMT_Q4_1:   return  20u;
        case FMT_Q5_0:   return  22u;
        case FMT_Q5_1:   return  24u;
        case FMT_Q8_0:   return  34u;
        case FMT_Q2_K:   return  84u;
        case FMT_Q3_K:   return 110u;
        case FMT_Q4_K:   return 144u;
        case FMT_Q5_K:   return 176u;
        case FMT_Q6_K:   return 210u;
        default:         return 136u;
    }
}

//  One nibble turned into the number its format means by it. Written as a
//  function so that the sixteen stores below can name their word rather
//  than choose it from four with a chain of tests: a chain the compiler
//  cannot fold is an indexed read of four live values, and it cost the
//  formats that were already here twenty-two per cent before this was
//  written out.
float nibble_value (uint word, uint shift, uint k, uint fifths,
                    bool levelled, float bias) {
    uint nib = (word >> shift) & 15u;
    return levelled
           ? float (LEVELS[nib])
           : float (nib + ((fifths >> k) & 1u) * 16u) - bias;
}

//  One of the sixteen six-bit scales a Q3_K super-block carries, which are
//  packed unlike Q4_K's: twelve bytes, the low four bits of each of the
//  first eight in a nibble of their own and every top pair gathered into
//  the last four, two bits to a scale. Signed by taking thirty-two away.
int q3k_scale (uint at, uint which) {
    uint j    = which & 3u;
    uint tier = which >> 2u;
    uint low  = (byte_at (at + (tier & 1u) * 4u + j)
                 >> ((tier >> 1u) * 4u)) & 15u;
    uint top  = (byte_at (at + 8u + j) >> (2u * tier)) & 3u;

    return int (low) + 16 * int (top) - 32;
}

#endif

void main() {
    uint row0 = gl_WorkGroupID.x * TILE_R;
    uint vec0 = gl_WorkGroupID.y * TILE_V;

    //  Nothing here asks how long the batch is. The host rounds it up to a
    //  whole tile and zeroes what the rounding invents, so every workgroup
    //  has all eight vector matrices and the loops below have constant
    //  bounds.
    //
    //  That is not tidiness either. Bounding them by what is real instead
    //  -- a count worked out from the batch length -- costs a fifth of this
    //  shader's speed, 1647 against 2031 gigaflops, because a loop whose
    //  length is not known when it is compiled is a loop whose accumulators
    //  cannot stay in registers.

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
        acc[AR][AV];

    for (uint i = 0u; i < AR; ++i) {
        for (uint j = 0u; j < AV; ++j) {
            acc[i][j] =
                coopmat<float, gl_ScopeSubgroup, 16, 16,
                        gl_MatrixUseAccumulator>(0.0);
        }
    }

    //  Bytes a row takes, which says where the next row starts. The
    //  formats differ in this, in the decode below, and in nothing else.
#ifdef MORE_FORMATS
    uint rb = (is_short (shape.format) ? shape.columns / 32u
                                       : shape.columns / 256u)
              * block_bytes (shape.format);
#else
    uint block = shape.format == FMT_Q4_K ? 144u
                 : (shape.format == FMT_Q5_K ? 176u : 210u);

    uint rb = shape.format <= FMT_BF16
              ? shape.columns * 2u
              : (shape.format == FMT_Q8_0
                 ? (shape.columns / 32u) * 34u
                 : (shape.columns / 256u) * block);
#endif

    for (uint k0 = 0u; k0 < shape.columns; k0 += KCH) {
        barrier();

        //  Sixty-four invocations decode thirty-two rows of the step,
        //  half a row each: sixteen values apiece, taken four bytes to a
        //  word.
        {
            uint half_of = gl_LocalInvocationID.x & 1u;
            uint r       = gl_LocalInvocationID.x >> 1u;
            uint into    = r * KCH + half_of * 16u;
            uint row     = shape.base + (row0 + r) * rb;

#ifdef MORE_FORMATS
            if (is_nibble (shape.format)) {
                //  The five formats that keep thirty-two elements in a
                //  block behind one scale, as nibbles. They share a shape
                //  and differ only in what is done to a nibble once it is
                //  out: centred on eight or sixteen, lifted by a minimum of
                //  its own, given a fifth bit from four bytes held apart,
                //  or read as an index into the table of levels.
                //
                //  The low half of byte j is element j and the high half is
                //  element j + 16, so both halves of a step read the same
                //  sixteen bytes and only the nibble differs.
                uint fmt = shape.format;

                uint quants_at = fmt == FMT_Q4_1 ? 4u
                                 : (fmt == FMT_Q5_0 ? 6u
                                    : (fmt == FMT_Q5_1 ? 8u : 2u));

                uint at = row + (k0 / 32u) * block_bytes (fmt);

                float scale = half_at (at);
                float lowest = (fmt == FMT_Q4_1 || fmt == FMT_Q5_1)
                               ? half_at (at + 2u) : 0.0;
                float bias = fmt == FMT_Q4_0 ? 8.0
                             : (fmt == FMT_Q5_0 ? 16.0 : 0.0);

                //  The fifth bits, read as one number. Bit j belongs to
                //  element j and bit j + 16 to element j + 16, so this
                //  invocation wants sixteen consecutive bits of it.
                uint fifths = 0u;
                if (fmt == FMT_Q5_0 || fmt == FMT_Q5_1) {
                    uint f = at + (fmt == FMT_Q5_0 ? 2u : 4u);
                    fifths = byte_at (f) | (byte_at (f + 1u) << 8u)
                             | (byte_at (f + 2u) << 16u)
                             | (byte_at (f + 3u) << 24u);
                    fifths = fifths >> (half_of * 16u);
                }

                uint p0, p1, p2, p3;
                four_words (at + quants_at, p0, p1, p2, p3);
                uint turn = half_of * 4u;
                bool levelled = fmt == FMT_IQ4_NL;

                wt[into +  0u] = float16_t (scale * nibble_value
                    (p0, turn +  0u,  0u, fifths, levelled, bias)
                    + lowest);
                wt[into +  1u] = float16_t (scale * nibble_value
                    (p0, turn +  8u,  1u, fifths, levelled, bias)
                    + lowest);
                wt[into +  2u] = float16_t (scale * nibble_value
                    (p0, turn + 16u,  2u, fifths, levelled, bias)
                    + lowest);
                wt[into +  3u] = float16_t (scale * nibble_value
                    (p0, turn + 24u,  3u, fifths, levelled, bias)
                    + lowest);
                wt[into +  4u] = float16_t (scale * nibble_value
                    (p1, turn +  0u,  4u, fifths, levelled, bias)
                    + lowest);
                wt[into +  5u] = float16_t (scale * nibble_value
                    (p1, turn +  8u,  5u, fifths, levelled, bias)
                    + lowest);
                wt[into +  6u] = float16_t (scale * nibble_value
                    (p1, turn + 16u,  6u, fifths, levelled, bias)
                    + lowest);
                wt[into +  7u] = float16_t (scale * nibble_value
                    (p1, turn + 24u,  7u, fifths, levelled, bias)
                    + lowest);
                wt[into +  8u] = float16_t (scale * nibble_value
                    (p2, turn +  0u,  8u, fifths, levelled, bias)
                    + lowest);
                wt[into +  9u] = float16_t (scale * nibble_value
                    (p2, turn +  8u,  9u, fifths, levelled, bias)
                    + lowest);
                wt[into + 10u] = float16_t (scale * nibble_value
                    (p2, turn + 16u, 10u, fifths, levelled, bias)
                    + lowest);
                wt[into + 11u] = float16_t (scale * nibble_value
                    (p2, turn + 24u, 11u, fifths, levelled, bias)
                    + lowest);
                wt[into + 12u] = float16_t (scale * nibble_value
                    (p3, turn +  0u, 12u, fifths, levelled, bias)
                    + lowest);
                wt[into + 13u] = float16_t (scale * nibble_value
                    (p3, turn +  8u, 13u, fifths, levelled, bias)
                    + lowest);
                wt[into + 14u] = float16_t (scale * nibble_value
                    (p3, turn + 16u, 14u, fifths, levelled, bias)
                    + lowest);
                wt[into + 15u] = float16_t (scale * nibble_value
                    (p3, turn + 24u, 15u, fifths, levelled, bias)
                    + lowest);
            } else if (shape.format == FMT_Q2_K) {
                //  Two bits an element, sixteen sub-blocks of sixteen, and
                //  a four-bit scale and a four-bit minimum sharing a byte
                //  for each. A step of thirty-two columns is two of those
                //  sub-blocks and an invocation takes one of them whole, so
                //  its scale is read once.
                uint at = row + (k0 / 256u) * 84u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint group = here & 3u;

                float d = half_at (at + 80u);
                float dmin = half_at (at + 82u);

                uint packed = byte_at (at + side * 8u + group * 2u + half_of);
                float factor = d * float (packed & 15u);
                float lowest = dmin * float (packed >> 4u);

                uint p0, p1, p2, p3;
                four_words (at + 16u + side * 32u + half_of * 16u,
                            p0, p1, p2, p3);
                uint shift = 2u * group;

                wt[into +  0u] = float16_t (factor * float
                    ((p0 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  1u] = float16_t (factor * float
                    ((p0 >> ( 8u + shift)) & 3u) - lowest);
                wt[into +  2u] = float16_t (factor * float
                    ((p0 >> (16u + shift)) & 3u) - lowest);
                wt[into +  3u] = float16_t (factor * float
                    ((p0 >> (24u + shift)) & 3u) - lowest);
                wt[into +  4u] = float16_t (factor * float
                    ((p1 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  5u] = float16_t (factor * float
                    ((p1 >> ( 8u + shift)) & 3u) - lowest);
                wt[into +  6u] = float16_t (factor * float
                    ((p1 >> (16u + shift)) & 3u) - lowest);
                wt[into +  7u] = float16_t (factor * float
                    ((p1 >> (24u + shift)) & 3u) - lowest);
                wt[into +  8u] = float16_t (factor * float
                    ((p2 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  9u] = float16_t (factor * float
                    ((p2 >> ( 8u + shift)) & 3u) - lowest);
                wt[into + 10u] = float16_t (factor * float
                    ((p2 >> (16u + shift)) & 3u) - lowest);
                wt[into + 11u] = float16_t (factor * float
                    ((p2 >> (24u + shift)) & 3u) - lowest);
                wt[into + 12u] = float16_t (factor * float
                    ((p3 >> ( 0u + shift)) & 3u) - lowest);
                wt[into + 13u] = float16_t (factor * float
                    ((p3 >> ( 8u + shift)) & 3u) - lowest);
                wt[into + 14u] = float16_t (factor * float
                    ((p3 >> (16u + shift)) & 3u) - lowest);
                wt[into + 15u] = float16_t (factor * float
                    ((p3 >> (24u + shift)) & 3u) - lowest);
            } else if (shape.format == FMT_IQ4_XS) {
                //  The levels again, over a super-block: one half-precision
                //  scale for the whole of it and a six-bit one for each
                //  sub-block of thirty-two, four bits in a nibble and two
                //  in a shared word, signed by taking thirty-two away.
                uint at = row + (k0 / 256u) * 136u;
                uint sub = (k0 / 32u) & 7u;

                float d = half_at (at);
                uint high = byte_at (at + 2u) | (byte_at (at + 3u) << 8u);

                uint nibble = (sub & 1u) == 0u
                              ? (byte_at (at + 4u + sub / 2u) & 15u)
                              : (byte_at (at + 4u + sub / 2u) >> 4u);
                uint upper = (high >> (2u * sub)) & 3u;
                float step = d * (float (nibble + 16u * upper) - 32.0);

                uint p0, p1, p2, p3;
                four_words (at + 8u + sub * 16u, p0, p1, p2, p3);
                uint turn = half_of * 4u;

                wt[into +  0u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 0u)) & 15u]));
                wt[into +  1u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 8u)) & 15u]));
                wt[into +  2u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 16u)) & 15u]));
                wt[into +  3u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 24u)) & 15u]));
                wt[into +  4u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 0u)) & 15u]));
                wt[into +  5u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 8u)) & 15u]));
                wt[into +  6u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 16u)) & 15u]));
                wt[into +  7u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 24u)) & 15u]));
                wt[into +  8u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 0u)) & 15u]));
                wt[into +  9u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 8u)) & 15u]));
                wt[into + 10u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 16u)) & 15u]));
                wt[into + 11u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 24u)) & 15u]));
                wt[into + 12u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 0u)) & 15u]));
                wt[into + 13u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 8u)) & 15u]));
                wt[into + 14u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 16u)) & 15u]));
                wt[into + 15u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 24u)) & 15u]));
            } else if (shape.format == FMT_Q3_K) {
                //  Two bits an element in sixty-four bytes and the third
                //  bit apart in a mask of thirty-two, one bit of it for
                //  each of the eight steps a super-block is made of. A set
                //  bit means the element is as it reads and a clear one
                //  means four is taken from it, which is the sign this
                //  format keeps in place of a minimum.
                uint at = row + (k0 / 256u) * 110u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint group = here & 3u;

                float factor = half_at (at + 108u)
                               * float (q3k_scale (at + 96u,
                                                   side * 8u + group * 2u
                                                   + half_of));

                uint p0, p1, p2, p3;
                four_words (at + 32u + side * 32u + half_of * 16u,
                            p0, p1, p2, p3);

                uint m0, m1, m2, m3;
                four_words (at + half_of * 16u, m0, m1, m2, m3);

                uint shift = 2u * group;
                uint bit = side * 4u + group;

                wt[into +  0u] = float16_t (factor *
                    (float ((p0 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> ( 0u + bit)) & 1u))));
                wt[into +  1u] = float16_t (factor *
                    (float ((p0 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> ( 8u + bit)) & 1u))));
                wt[into +  2u] = float16_t (factor *
                    (float ((p0 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> (16u + bit)) & 1u))));
                wt[into +  3u] = float16_t (factor *
                    (float ((p0 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> (24u + bit)) & 1u))));
                wt[into +  4u] = float16_t (factor *
                    (float ((p1 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> ( 0u + bit)) & 1u))));
                wt[into +  5u] = float16_t (factor *
                    (float ((p1 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> ( 8u + bit)) & 1u))));
                wt[into +  6u] = float16_t (factor *
                    (float ((p1 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> (16u + bit)) & 1u))));
                wt[into +  7u] = float16_t (factor *
                    (float ((p1 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> (24u + bit)) & 1u))));
                wt[into +  8u] = float16_t (factor *
                    (float ((p2 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> ( 0u + bit)) & 1u))));
                wt[into +  9u] = float16_t (factor *
                    (float ((p2 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> ( 8u + bit)) & 1u))));
                wt[into + 10u] = float16_t (factor *
                    (float ((p2 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> (16u + bit)) & 1u))));
                wt[into + 11u] = float16_t (factor *
                    (float ((p2 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> (24u + bit)) & 1u))));
                wt[into + 12u] = float16_t (factor *
                    (float ((p3 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> ( 0u + bit)) & 1u))));
                wt[into + 13u] = float16_t (factor *
                    (float ((p3 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> ( 8u + bit)) & 1u))));
                wt[into + 14u] = float16_t (factor *
                    (float ((p3 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> (16u + bit)) & 1u))));
                wt[into + 15u] = float16_t (factor *
                    (float ((p3 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> (24u + bit)) & 1u))));
            }
#else
            if (shape.format <= FMT_BF16) {
                //  Sixteen bits a weight and no blocks: the sixteen an
                //  invocation wants are eight words, and they always start
                //  on a word boundary because a row is a whole number of
                //  them.
                //
                //  Half precision is copied and brain floating point is
                //  shifted into the top of a binary32 and rounded once.
                //  Neither loses anything the tile could have held.
                uint at = row + (k0 + half_of * 16u) * 2u;
                uint i  = at >> 2u;

                for (uint j = 0u; j < 8u; ++j) {
                    uint held = w[i + j];

                    if (shape.format == FMT_F16) {
                        vec2 pair = unpackHalf2x16(held);
                        wt[into + j * 2u]      = float16_t(pair.x);
                        wt[into + j * 2u + 1u] = float16_t(pair.y);
                    } else {
                        wt[into + j * 2u] =
                            float16_t(uintBitsToFloat(held << 16u));
                        wt[into + j * 2u + 1u] =
                            float16_t(uintBitsToFloat(held & 0xFFFF0000u));
                    }
                }
            } else if (shape.format == FMT_Q8_0) {
                uint at = row + (k0 / 32u) * 34u;
                float16_t d = float16_t(half_at(at));

                uint q = at + 2u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);

                int q0 = int(p0), q1 = int(p1);
                int q2 = int(p2), q3 = int(p3);

                wt[into +  0u] = d * float16_t(bitfieldExtract(q0,  0, 8));
                wt[into +  1u] = d * float16_t(bitfieldExtract(q0,  8, 8));
                wt[into +  2u] = d * float16_t(bitfieldExtract(q0, 16, 8));
                wt[into +  3u] = d * float16_t(bitfieldExtract(q0, 24, 8));
                wt[into +  4u] = d * float16_t(bitfieldExtract(q1,  0, 8));
                wt[into +  5u] = d * float16_t(bitfieldExtract(q1,  8, 8));
                wt[into +  6u] = d * float16_t(bitfieldExtract(q1, 16, 8));
                wt[into +  7u] = d * float16_t(bitfieldExtract(q1, 24, 8));
                wt[into +  8u] = d * float16_t(bitfieldExtract(q2,  0, 8));
                wt[into +  9u] = d * float16_t(bitfieldExtract(q2,  8, 8));
                wt[into + 10u] = d * float16_t(bitfieldExtract(q2, 16, 8));
                wt[into + 11u] = d * float16_t(bitfieldExtract(q2, 24, 8));
                wt[into + 12u] = d * float16_t(bitfieldExtract(q3,  0, 8));
                wt[into + 13u] = d * float16_t(bitfieldExtract(q3,  8, 8));
                wt[into + 14u] = d * float16_t(bitfieldExtract(q3, 16, 8));
                wt[into + 15u] = d * float16_t(bitfieldExtract(q3, 24, 8));
            } else if (shape.format == FMT_Q4_K) {
                //  Q4_K. A super-block is two hundred and fifty-six
                //  elements in a hundred and forty-four bytes, and a step
                //  of thirty-two columns is one of its eight sub-blocks:
                //  the low nibbles of a thirty-two byte group, or the high
                //  nibbles of the same group for the sub-block after it.
                //
                //  A value here is the whole value -- the scale times the
                //  quant less the minimum -- rather than a quant with the
                //  correction taken out afterwards. That correction exists
                //  in the processor's kernel because its instruction
                //  multiplies integers; this one multiplies what it is
                //  given, so the minimum is subtracted where it is read.
                uint at  = row + (k0 / 256u) * 144u;
                uint sub = (k0 / 32u) & 7u;

                float d    = half_at(at);
                float least = half_at(at + 2u);

                uint factor, lowest;
                sub_block_scale(at + 4u, sub, factor, lowest);

                //  Both kept in binary32 and the value rounded once, at
                //  the end. Rounding the scale and the minimum first and
                //  then multiplying and subtracting in half precision
                //  rounds three times, and the subtraction is where a
                //  value goes small: 3.6 per cent worst relative error
                //  against 0.4 for one rounding, on the same numbers.
                float scale  = d * float(factor);
                float offset = least * float(lowest);

                //  Sixteen of the group's thirty-two bytes, and one nibble
                //  from each. The quants start sixteen bytes into a block
                //  whose length is a multiple of four, so this read is
                //  always on a word boundary and needs no shifting.
                uint q = at + 16u + (sub >> 1u) * 32u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);
                uint turn = (sub & 1u) * 4u;

                wt[into +  0u] = float16_t(
                    scale * float((p0 >> (turn)) & 15u)
                    - offset);
                wt[into +  1u] = float16_t(
                    scale * float((p0 >> (turn +  8u)) & 15u)
                    - offset);
                wt[into +  2u] = float16_t(
                    scale * float((p0 >> (turn + 16u)) & 15u)
                    - offset);
                wt[into +  3u] = float16_t(
                    scale * float((p0 >> (turn + 24u)) & 15u)
                    - offset);
                wt[into +  4u] = float16_t(
                    scale * float((p1 >> (turn)) & 15u)
                    - offset);
                wt[into +  5u] = float16_t(
                    scale * float((p1 >> (turn +  8u)) & 15u)
                    - offset);
                wt[into +  6u] = float16_t(
                    scale * float((p1 >> (turn + 16u)) & 15u)
                    - offset);
                wt[into +  7u] = float16_t(
                    scale * float((p1 >> (turn + 24u)) & 15u)
                    - offset);
                wt[into +  8u] = float16_t(
                    scale * float((p2 >> (turn)) & 15u)
                    - offset);
                wt[into +  9u] = float16_t(
                    scale * float((p2 >> (turn +  8u)) & 15u)
                    - offset);
                wt[into + 10u] = float16_t(
                    scale * float((p2 >> (turn + 16u)) & 15u)
                    - offset);
                wt[into + 11u] = float16_t(
                    scale * float((p2 >> (turn + 24u)) & 15u)
                    - offset);
                wt[into + 12u] = float16_t(
                    scale * float((p3 >> (turn)) & 15u)
                    - offset);
                wt[into + 13u] = float16_t(
                    scale * float((p3 >> (turn +  8u)) & 15u)
                    - offset);
                wt[into + 14u] = float16_t(
                    scale * float((p3 >> (turn + 16u)) & 15u)
                    - offset);
                wt[into + 15u] = float16_t(
                    scale * float((p3 >> (turn + 24u)) & 15u)
                    - offset);
            } else if (shape.format == FMT_Q5_K) {
                //  Q5_K. The four-bit k-quant with a bit taken out of every
                //  quant and kept apart: the same two scales and the same
                //  twelve packed six-bit pairs, then thirty-two bytes
                //  holding the fifth bit of all two hundred and fifty-six
                //  elements, then the nibbles.
                //
                //  A byte of that array serves all eight sub-blocks at one
                //  position, one bit each, so the bit a sub-block wants is
                //  bit s of it and the sixteen bytes an invocation reads
                //  are the same sixteen whichever sub-block the step is.
                uint at  = row + (k0 / 256u) * 176u;
                uint sub = (k0 / 32u) & 7u;

                float d     = half_at(at);
                float least = half_at(at + 2u);

                uint factor, lowest;
                sub_block_scale(at + 4u, sub, factor, lowest);

                float scale  = d * float(factor);
                float offset = least * float(lowest);

                uint q = at + 48u + (sub >> 1u) * 32u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);

                uint f0, f1, f2, f3;
                four_words (at + 16u + half_of * 16u, f0, f1, f2, f3);

                uint turn = (sub & 1u) * 4u;

                wt[into +  0u] = float16_t(scale * float(
                    ((p0 >> (turn)) & 15u)
                    + 16u * ((f0 >> (sub)) & 1u)) - offset);
                wt[into +  1u] = float16_t(scale * float(
                    ((p0 >> (turn +  8u)) & 15u)
                    + 16u * ((f0 >> (sub +  8u)) & 1u)) - offset);
                wt[into +  2u] = float16_t(scale * float(
                    ((p0 >> (turn + 16u)) & 15u)
                    + 16u * ((f0 >> (sub + 16u)) & 1u)) - offset);
                wt[into +  3u] = float16_t(scale * float(
                    ((p0 >> (turn + 24u)) & 15u)
                    + 16u * ((f0 >> (sub + 24u)) & 1u)) - offset);
                wt[into +  4u] = float16_t(scale * float(
                    ((p1 >> (turn)) & 15u)
                    + 16u * ((f1 >> (sub)) & 1u)) - offset);
                wt[into +  5u] = float16_t(scale * float(
                    ((p1 >> (turn +  8u)) & 15u)
                    + 16u * ((f1 >> (sub +  8u)) & 1u)) - offset);
                wt[into +  6u] = float16_t(scale * float(
                    ((p1 >> (turn + 16u)) & 15u)
                    + 16u * ((f1 >> (sub + 16u)) & 1u)) - offset);
                wt[into +  7u] = float16_t(scale * float(
                    ((p1 >> (turn + 24u)) & 15u)
                    + 16u * ((f1 >> (sub + 24u)) & 1u)) - offset);
                wt[into +  8u] = float16_t(scale * float(
                    ((p2 >> (turn)) & 15u)
                    + 16u * ((f2 >> (sub)) & 1u)) - offset);
                wt[into +  9u] = float16_t(scale * float(
                    ((p2 >> (turn +  8u)) & 15u)
                    + 16u * ((f2 >> (sub +  8u)) & 1u)) - offset);
                wt[into + 10u] = float16_t(scale * float(
                    ((p2 >> (turn + 16u)) & 15u)
                    + 16u * ((f2 >> (sub + 16u)) & 1u)) - offset);
                wt[into + 11u] = float16_t(scale * float(
                    ((p2 >> (turn + 24u)) & 15u)
                    + 16u * ((f2 >> (sub + 24u)) & 1u)) - offset);
                wt[into + 12u] = float16_t(scale * float(
                    ((p3 >> (turn)) & 15u)
                    + 16u * ((f3 >> (sub)) & 1u)) - offset);
                wt[into + 13u] = float16_t(scale * float(
                    ((p3 >> (turn +  8u)) & 15u)
                    + 16u * ((f3 >> (sub +  8u)) & 1u)) - offset);
                wt[into + 14u] = float16_t(scale * float(
                    ((p3 >> (turn + 16u)) & 15u)
                    + 16u * ((f3 >> (sub + 16u)) & 1u)) - offset);
                wt[into + 15u] = float16_t(scale * float(
                    ((p3 >> (turn + 24u)) & 15u)
                    + 16u * ((f3 >> (sub + 24u)) & 1u)) - offset);
            } else {
                //  Q6_K. Two hundred and fifty-six elements in two hundred
                //  and ten bytes: a hundred and twenty-eight low nibbles,
                //  sixty-four bytes of the two high bits, sixteen signed
                //  sub-block scales, then the block's own scale.
                //
                //  A step of thirty-two columns is exactly one of the eight
                //  runs the format is read in, and an invocation's sixteen
                //  of them share one sub-block scale, so the scale is read
                //  once rather than per element.
                uint at   = row + (k0 / 256u) * 210u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint run  = here & 3u;

                float d = half_at(at + 208u);
                float step = d * float
                  (signed_at (at + 192u + side * 8u + run * 2u + half_of));

                //  The low nibbles of this run, and the byte holding two
                //  high bits for each of the four runs the same nibble
                //  byte serves.
                uint low  = at + side * 64u + (run & 1u) * 32u
                            + half_of * 16u;
                uint high = at + 128u + side * 32u + half_of * 16u;

                uint l0, l1, l2, l3;
                uint h0, h1, h2, h3;
                four_words (low, l0, l1, l2, l3);
                four_words (high, h0, h1, h2, h3);

                //  Which nibble of the low byte, and which pair of bits of
                //  the high one. The first two runs take the low nibble and
                //  the last two the high; each takes its own pair.
                uint nib = (run >> 1u) * 4u;
                uint top = run * 2u;

                wt[into +  0u] = float16_t(step * (float(
                    ((l0 >> (nib)) & 15u)
                    | (((h0 >> (top)) & 3u) << 4u)) - 32.0));
                wt[into +  1u] = float16_t(step * (float(
                    ((l0 >> (nib +  8u)) & 15u)
                    | (((h0 >> (top +  8u)) & 3u) << 4u)) - 32.0));
                wt[into +  2u] = float16_t(step * (float(
                    ((l0 >> (nib + 16u)) & 15u)
                    | (((h0 >> (top + 16u)) & 3u) << 4u)) - 32.0));
                wt[into +  3u] = float16_t(step * (float(
                    ((l0 >> (nib + 24u)) & 15u)
                    | (((h0 >> (top + 24u)) & 3u) << 4u)) - 32.0));
                wt[into +  4u] = float16_t(step * (float(
                    ((l1 >> (nib)) & 15u)
                    | (((h1 >> (top)) & 3u) << 4u)) - 32.0));
                wt[into +  5u] = float16_t(step * (float(
                    ((l1 >> (nib +  8u)) & 15u)
                    | (((h1 >> (top +  8u)) & 3u) << 4u)) - 32.0));
                wt[into +  6u] = float16_t(step * (float(
                    ((l1 >> (nib + 16u)) & 15u)
                    | (((h1 >> (top + 16u)) & 3u) << 4u)) - 32.0));
                wt[into +  7u] = float16_t(step * (float(
                    ((l1 >> (nib + 24u)) & 15u)
                    | (((h1 >> (top + 24u)) & 3u) << 4u)) - 32.0));
                wt[into +  8u] = float16_t(step * (float(
                    ((l2 >> (nib)) & 15u)
                    | (((h2 >> (top)) & 3u) << 4u)) - 32.0));
                wt[into +  9u] = float16_t(step * (float(
                    ((l2 >> (nib +  8u)) & 15u)
                    | (((h2 >> (top +  8u)) & 3u) << 4u)) - 32.0));
                wt[into + 10u] = float16_t(step * (float(
                    ((l2 >> (nib + 16u)) & 15u)
                    | (((h2 >> (top + 16u)) & 3u) << 4u)) - 32.0));
                wt[into + 11u] = float16_t(step * (float(
                    ((l2 >> (nib + 24u)) & 15u)
                    | (((h2 >> (top + 24u)) & 3u) << 4u)) - 32.0));
                wt[into + 12u] = float16_t(step * (float(
                    ((l3 >> (nib)) & 15u)
                    | (((h3 >> (top)) & 3u) << 4u)) - 32.0));
                wt[into + 13u] = float16_t(step * (float(
                    ((l3 >> (nib +  8u)) & 15u)
                    | (((h3 >> (top +  8u)) & 3u) << 4u)) - 32.0));
                wt[into + 14u] = float16_t(step * (float(
                    ((l3 >> (nib + 16u)) & 15u)
                    | (((h3 >> (top + 16u)) & 3u) << 4u)) - 32.0));
                wt[into + 15u] = float16_t(step * (float(
                    ((l3 >> (nib + 24u)) & 15u)
                    | (((h3 >> (top + 24u)) & 3u) << 4u)) - 32.0));
            }
#endif
        }

        barrier();

        for (uint kk = 0u; kk < KCH; kk += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
                a[AR];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
                b[AV];

            for (uint i = 0u; i < AR; ++i) {
                coopMatLoad(a[i], wt, i * 16u * KCH + kk, KCH,
                            gl_CooperativeMatrixLayoutRowMajor);
            }

            //  Column major with the batch's own stride is the transpose
            //  the product wants, so nothing is turned round on the way in:
            //  element (k, n) of the operand is column k of vector n, which
            //  is where the batch already keeps it.
            for (uint j = 0u; j < AV; ++j) {
                coopMatLoad(b[j], x,
                            (vec0 + j * 16u) * shape.columns + k0 + kk,
                            shape.columns,
                            gl_CooperativeMatrixLayoutColumnMajor);
            }

            for (uint i = 0u; i < AR; ++i) {
                for (uint j = 0u; j < AV; ++j) {
                    acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
                }
            }
        }
    }

    //  And out the same way: the answers of one vector are contiguous, so
    //  the tile is stored column major with the row count as its stride.
    for (uint i = 0u; i < AR; ++i) {
        for (uint j = 0u; j < AV; ++j) {
            coopMatStore(acc[i][j], y,
                         (vec0 + j * 16u) * shape.rows + row0 + i * 16u,
                         shape.rows,
                         gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
}
