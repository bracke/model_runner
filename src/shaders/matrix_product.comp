#version 450

//  A tile of the answer at a time, through the device's matrix instruction.
//
//  This computes the same thing row_product.comp computes -- y[v][row] over
//  a batch of vectors -- and computes it as a matrix product rather than as
//  a row product repeated. The difference is not the instruction. It is the
//  shape of the work:
//
//  The row product carries GROUP vectors per invocation, so a batch longer
//  than GROUP is several dispatches and the weights are read once for each
//  of them. A hundred and twenty-eight vectors at eight a dispatch is
//  sixteen passes over the whole model. Raising GROUP does not fix it and
//  was measured not to: sixteen reads 1.219 s against eight's 1.054,
//  because what an invocation re-reads is the activations rather than the
//  weights.
//
//  A tile reads both once. One workgroup takes thirty-two rows and a
//  hundred and twenty-eight vectors and walks the columns, so the weights
//  are read once for the whole batch and the activations once for the
//  whole tile of rows.
//
//  Six formats -- half precision, brain floating point, eight-bit blocks
//  and the four-, five- and six-bit k-quants -- and only where the device
//  offers VK_KHR_cooperative_matrix with a sixteen-by-sixteen-by-sixteen
//  half-precision shape at subgroup scope.
//
//  Binary32 weights are deliberately not among them. The tile's operand is
//  half precision, so a binary32 weight would lose thirteen bits of
//  mantissa on the way in, and a caller who has chosen to keep a model at
//  binary32 has asked for exactly those bits. The two sixteen-bit formats
//  lose nothing: half precision is already what the tile holds, and brain
//  floating point has fewer mantissa bits than half precision has, so the
//  widening is exact for every value inside half precision's range.
//  Everything else goes to row_product.comp, which reads all fifteen
//  formats and needs nothing of the device beyond Vulkan 1.0.
//
//  This source is compiled twice. As it stands it decodes the six formats
//  a published model is usually made of; with MORE_FORMATS defined it
//  decodes nine others instead, and the engine picks the pipeline by the
//  weights it is given. Two compilations rather than one shader of
//  fifteen branches, because a pipeline pays for every branch compiled
//  into it whether or not the branch is ever taken -- adding the eight to
//  this one cost the six twenty-one per cent with the host refusing to
//  send them, so with not a line of the new code reachable. Registers are
//  allocated for the whole shader and the occupancy that follows is the
//  occupancy of every dispatch.
//
//  They share a source rather than a pipeline because only the decode
//  differs: the tile, the accumulators, the operand loads and the store are
//  the same instructions in the same order. The branch is on a push
//  constant, so it is uniform across a workgroup and taken once a step.
//
//  Those four are what a published model is made of. A "_M" file is a
//  mixture by construction -- four or five bits for most of it, six for the
//  output projection and a handful of others -- so a shader that took only
//  one of them left the other on the row product and the file no faster
//  than the sum of its slower half.
//
//  The activations are read as half precision, from a copy half_batch.comp
//  made before this ran. That is not an optimization, it is the only way
//  the instruction will take them: loading binary32 into a half-precision
//  matrix does not convert, it reinterprets, and the answers come back as
//  not-a-number. The copy is made once for a product rather than once for
//  a workgroup, which an earlier attempt at this measured as a seventh of
//  its time when each workgroup made its own.
//
//  The weights are decoded into shared memory, because the instruction
//  loads a matrix from an array and a Q8_0 block is a scale and thirty-two
//  bytes rather than an array of numbers. Thirty-two rows by thirty-two
//  columns of half precision is two kilobytes, which is small enough that
//  the tile is not what bounds how many of these a part will run.

#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

//  One subgroup, and the host has established that a subgroup here is
//  sixty-four invocations. The instruction is at subgroup scope, so a
//  workgroup of more than one would need each of them told which part of
//  the tile it owns; one is simpler and measured faster than two or four
//  at every tile shape tried.
//  Four subgroups where there was one.
//
//  The tile is unchanged and so is the work; what changes is how many lane
//  groups share it. One subgroup holding sixteen accumulators asks for two
//  hundred and fifty-six vector registers, which is the ceiling, and a
//  kernel at the ceiling runs one wave to a lane group with nothing to hide
//  a memory latency behind. Four subgroups of four accumulators is the
//  shape llama.cpp's matrix kernel uses on this part.
//
//  The staging below still runs on sixty-four invocations, because the
//  decode is written sixteen values to a lane. That is a probe rather than
//  the finished shape: it pays four times over on the decode to find out
//  whether the accumulators were the wall.
#ifdef NARROW
layout(local_size_x = 64) in;
const uint SUBS = 1u;
#elif defined(LISTED)
layout(local_size_x = 128) in;
const uint SUBS = 2u;
#elif defined(WIDER)
//  The wide tile over a long batch: eight subgroups, two hundred and
//  fifty-six vectors. Every weight is decoded once for each tile of
//  vectors, and the decode is where a tile's time goes, so a batch past
//  a hundred and twenty-eight decodes half as often -- a qwen3-8b prompt
//  of 434 tokens 325 -> 346 tokens a second. Below that it would pad a
//  hundred to two hundred and fifty-six, and a batch that short takes the
//  tile below.
layout(local_size_x = 512) in;
const uint SUBS = 8u;
#else
layout(local_size_x = 256) in;
const uint SUBS = 4u;
#endif

//  Column chunks a step decodes, one a lane group: the wider tile's eight
//  make its step two hundred and fifty-six columns. Its eight groups were
//  tried as four chunks of two row halves each, to keep the step at a
//  hundred and twenty-eight: twice the steps and their barriers, and
//  slower than the tile below it (gemma-3-4b 536 against 587).
const uint CHUNKS = SUBS;
const uint ROW_GROUPS = 1u;

layout(std430, binding = 0) readonly  buffer Weights { uint      w[]; };
layout(std430, binding = 2) writeonly buffer Result  { float     y[]; };

//  The batch in half precision, as half_batch.comp left it: the same
//  vector-major layout the binary32 copy has, padded up to a multiple of
//  sixteen vectors with zeros.
layout(std430, binding = 3) readonly  buffer Halves  { float16_t x[]; };

//  And the same buffer written. A product whose answer is read only in half
//  precision -- the two arms of a gated feed-forward are, because the step
//  that combines them reads halves -- writes it here instead of writing
//  binary32 into the result buffer that nothing would then read.
layout(std430, binding = 3) writeonly buffer Made { float16_t made[]; };

//  And the residual, where this product is one a join followed. A layer
//  adds its input back to what attention made and to what the feed-forward
//  made, and those two additions used to be dispatches of their own: two
//  arms read, a third buffer written, and the normalization after it
//  reading that third buffer back. Written here instead, the product's own
//  store carries the sum and the buffer in the middle stops existing --
//  which is the part that was costing, since a store's price on this device
//  is what it makes its reader pay rather than the bytes it moves.
layout(std430, binding = 4) readonly buffer Residual { float rj[]; };

//  The same binding as a batch's routing inverted, where the product is
//  every expert's over its run: see the push block.
layout(std430, binding = 4) readonly buffer Lists { uint lists[]; };

layout(push_constant) uniform Shape {
    uint rows;
    uint columns;
    uint count;
    //  Where this product's answer goes in the half-precision buffer, in
    //  halves and plus one, or zero for the binary32 answer this has always
    //  written. Plus one because zero is a real place.
    uint first;
    uint format;
    uint base;

    //  Whether the residual above is added to the answer before it is
    //  stored. Zero for every product that no join followed.
    uint joins;

    //  The rest of the row kernel's block, of which one word matters
    //  here: routed at two or three is a listed product. The third
    //  dimension of the dispatch is then the expert, the weights are its
    //  slice of the stack -- stride bytes a slice -- and the vectors are
    //  its run of the half-precision copy half_batch.comp laid out from
    //  the lists at binding four: the run begins at the slot the lists
    //  give and holds as many vectors as they count, padded to sixteen. A
    //  tile of vectors past the run's end has nothing to do and leaves;
    //  the answers are stored by slot.
    uint table;
    uint members[16];
    uint stride;
    uint apart;
    uint routed;
} shape;

//  Rows and vectors of the answer one workgroup computes, and how much of
//  the columns it takes at a time. The step is one Q8_0 block deep, which
//  is what makes the decode below a whole number of blocks; sixty-four and
//  a hundred and twenty-eight were measured and are slower.
//  Sixty-four rows, for the plain tiles as for the listed one: a tile reads
//  its vectors straight from memory once for every tile of rows, so at
//  thirty-two a qwen3-8b gate of 12288 rows read its batch of 434 vectors
//  384 times over -- over a gigabyte, against twenty megabytes of weights.
//  Sixty-four halved that and read gemma-3-4b's 421-token prompt at 604
//  tokens a second against 557, qwen3-8b's at 322 against 289; a hundred
//  and twenty-eight read 551 and 316, the accumulators past what fits. A
//  matrix whose rows are a multiple of thirty-two and not of sixty-four
//  ends in half a tile, whose rows past the end decode the last row and
//  are never stored.
#ifdef LISTED
const uint TILE_R = 64u;
#else
const uint TILE_R = 64u;
#endif

//  A tile is as wide as it is whether the batch filling it is a hundred and
//  twenty-eight vectors or nine, and what the rounding invents is zeros the
//  instruction multiplies anyway. At a hundred and twenty-eight that is the
//  right shape for a prompt; for a round of nine to thirty-two sequences it
//  is seven eighths waste, and this source is compiled again with NARROW to
//  give those a tile their own size. The weight tile is the same either way
//  -- it is the vector side that shrinks.
//
//  LISTED is the tile for listed products: thirty-two vectors over two
//  subgroups, since a run is thirty-two positions on average and a tile
//  of a hundred and twenty-eight is three quarters padding for each,
//  which the instruction multiplies all the same, and one subgroup alone
//  hides nothing; and sixty-four rows, since every tile of rows reads its
//  expert's whole run of vectors again. The engine's constants beside
//  Listed_Vectors carry the measurements. A specialization constant was
//  tried for the width and the constants derived from it did not follow
//  it.
#ifdef NARROW
const uint TILE_V = 32u;
#elif defined(LISTED)
const uint TILE_V = 32u;
#elif !defined(WIDER)
const uint TILE_V = 128u;
#else
const uint TILE_V = 256u;
#endif

const uint KCH    = 32u;

//  Which is two matrices of weights and eight of vectors, so sixteen
//  accumulators. Eight against two is the way round that measured fastest
//  -- 1709 against 328 gigaflops for two against eight -- because a
//  weight matrix comes from shared memory and is used eight times, where
//  a vector matrix comes from memory and is used twice.
const uint AR = TILE_R / 16u;
const uint AV = TILE_V / 16u / SUBS;

//  The step a row takes in the shared tile, which is wider than the step
//  it holds. A sixteen-by-sixteen load out of shared memory reads sixteen
//  rows at once, and a stride that is a power of two lands them in the
//  same banks; llama.cpp pads its own tile on these devices for the same
//  reason. What the padding costs is memory nothing reads.
//
//  Four, eight and sixteen measure the same -- 1.039, 1.040 and 1.041 s
//  on the long device prompt -- and no padding at all is 1.048, so what
//  this buys is a stride that is not a power of two rather than a
//  particular bank pattern. Two is worse than none, 1.097 s, which the
//  bank arithmetic does not predict and which is the one reading here
//  that is not understood: a stride of sixty-eight bytes is the only one
//  of these a sixteen-byte load cannot be built out of, so alignment
//  rather than banking is the likely reason.
const uint WT_PAD    = 4u;
const uint WT_STRIDE = KCH + WT_PAD;

//  One chunk a lane group. All four decode at once, each its own
//  thirty-two columns, and then all four read the whole of what the four
//  wrote: the decode keeps its shape -- sixteen values to a lane, four
//  bytes to a word -- and stops being a quarter of the invocations' work.
shared float16_t wt[CHUNKS * TILE_R * WT_STRIDE];

//  The two formats this decodes, numbered as Weight_Packing'Pos numbers
//  them, which is the same numbering row_product.comp is given.
const uint FMT_F16  = 1u;
const uint FMT_BF16 = 2u;
const uint FMT_Q8_0 = 7u;
const uint FMT_Q4_K = 11u;
const uint FMT_Q5_K = 12u;
const uint FMT_Q6_K = 13u;

uint byte_at(uint at) { return (w[at >> 2u] >> ((at & 3u) * 8u)) & 255u; }

float half_at(uint at) {
    return unpackHalf2x16(byte_at(at) | (byte_at(at + 1u) << 8u)).x;
}

//  One byte read as a signed number, which is how Q6_K keeps a sub-block
//  scale.
int signed_at(uint at) {
    int value = int(byte_at(at));
    return value > 127 ? value - 256 : value;
}

//  Sixteen bytes as four words. A block of any of these formats begins on a
//  four-byte boundary for every other block and two bytes into one for the
//  rest -- thirty-four and two hundred and ten are both two more than a
//  multiple of four -- so the odd case is shifted into place. Four loads
//  where a byte at a time is sixteen loads and sixteen shifts.
//
//  MXFP4 is the one format whose block is an odd length, seventeen, so
//  its runs begin one and three bytes into a word as well. Those take a
//  third arm with the shift they need, and only the compilation that
//  decodes MXFP4 has the arm: the six formats of the first compilation
//  never reach it, and a pipeline pays for a branch compiled into it
//  whether or not the branch is taken, so they keep the words they had.
void four_words (uint at, out uint p0, out uint p1, out uint p2, out uint p3)
{
    uint i = at >> 2u;

    if ((at & 3u) == 0u) {
        p0 = w[i]; p1 = w[i + 1u]; p2 = w[i + 2u]; p3 = w[i + 3u];
#ifdef MORE_FORMATS
    } else if ((at & 3u) == 2u) {
#else
    } else {
#endif
        uint a0 = w[i], a1 = w[i + 1u], a2 = w[i + 2u];
        uint a3 = w[i + 3u], a4 = w[i + 4u];
        p0 = (a0 >> 16u) | (a1 << 16u);
        p1 = (a1 >> 16u) | (a2 << 16u);
        p2 = (a2 >> 16u) | (a3 << 16u);
        p3 = (a3 >> 16u) | (a4 << 16u);
#ifdef MORE_FORMATS
    } else {
        uint s = (at & 3u) * 8u;
        uint t = 32u - s;
        uint a0 = w[i], a1 = w[i + 1u], a2 = w[i + 2u];
        uint a3 = w[i + 3u], a4 = w[i + 4u];
        p0 = (a0 >> s) | (a1 << t);
        p1 = (a1 >> s) | (a2 << t);
        p2 = (a2 >> s) | (a3 << t);
        p3 = (a3 >> s) | (a4 << t);
#endif
    }
}

#ifdef LOW_BITS
//  The twelve low-bit formats, decoded into the tile by the compilation
//  that defines LOW_BITS and by no other: numbered as Weight_Packing'Pos
//  numbers them, as row_product.comp's LOW_BITS compilation is.
const uint FMT_IQ3_S   = 16u;
const uint FMT_IQ2_XXS = 17u;
const uint FMT_IQ2_XS  = 18u;
const uint FMT_IQ2_S   = 19u;
const uint FMT_IQ3_XXS = 20u;
const uint FMT_IQ1_S   = 21u;
