void main() {
    uint row0 = gl_WorkGroupID.x * TILE_R;

    //  A listed product's expert: its run of vectors and its slice of
    //  the stack. The run's end is what the stores below stop at.
    bool listed = shape.routed >= 2u;
    uint expert = gl_WorkGroupID.z;
    uint run_at = listed ? lists[shape.members[0] + expert] : 0u;
    uint run_count = listed ? lists[expert] : shape.count;
    uint slice = listed ? expert * shape.stride : 0u;

    if (listed && gl_WorkGroupID.y * TILE_V >= run_count) {
        return;
    }

    //  This lane group's quarter of the tile's vectors.
    uint vec0 = run_at + gl_WorkGroupID.y * TILE_V
                + (gl_LocalInvocationID.x >> 6u) * (TILE_V / SUBS);

    //  Nothing here asks how long the batch is. The host rounds it up to a
    //  whole tile and zeroes what the rounding invents, so every workgroup
    //  has all eight vector matrices and the loops below have constant
    //  bounds.
    //
    //  That is not tidiness either. Bounding them by what is real instead
    //  -- a count worked out from the batch length -- costs a fifth of this
    //  shader's speed, 1647 against 2031 gigaflops, because a loop whose
    //  length is not known when it is compiled is a loop whose accumulators
    //  cannot stay in registers.

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
        acc[AR][AV];

    for (uint i = 0u; i < AR; ++i) {
        for (uint j = 0u; j < AV; ++j) {
            acc[i][j] =
                coopmat<float, gl_ScopeSubgroup, 16, 16,
                        gl_MatrixUseAccumulator>(0.0);
        }
    }

    //  Bytes a row takes, which says where the next row starts. The
    //  formats differ in this, in the decode below, and in nothing else.
#if defined(LOW_BITS)
    uint rb = (shape.columns / low_elements (shape.format))
              * low_bytes (shape.format);
#elif defined(MORE_FORMATS)
    uint rb = (is_short (shape.format) ? shape.columns / 32u
                                       : shape.columns / 256u)
              * block_bytes (shape.format);
#else
    uint block = shape.format == FMT_Q4_K ? 144u
                 : (shape.format == FMT_Q5_K ? 176u : 210u);

    uint rb = shape.format <= FMT_BF16
              ? shape.columns * 2u
              : (shape.format == FMT_Q8_0
                 ? (shape.columns / 32u) * 34u
                 : (shape.columns / 256u) * block);
#endif

    for (uint kb = 0u; kb < shape.columns; kb += KCH * CHUNKS) {
        barrier();

        uint k0 = kb + ((gl_LocalInvocationID.x >> 6u) % CHUNKS) * KCH;

        //  Sixty-four invocations decode thirty-two rows of the step,
        //  half a row each: sixteen values apiece, taken four bytes to a
        //  word -- and the next thirty-two rows after, where the tile is
        //  taller.
        for (uint rr = ((gl_LocalInvocationID.x >> 6u) / CHUNKS) * 32u;
             rr < TILE_R; rr += 32u * ROW_GROUPS)
        {
            uint chunk   = (gl_LocalInvocationID.x >> 6u) % CHUNKS;
            uint half_of = gl_LocalInvocationID.x & 1u;
            uint r       = rr + ((gl_LocalInvocationID.x & 63u) >> 1u);
            uint into    = chunk * TILE_R * WT_STRIDE
                           + r * WT_STRIDE + half_of * 16u;
            uint row     = shape.base + slice
                           + min(row0 + r, shape.rows - 1u) * rb;

#if defined(LOW_BITS)
            {
                //  The low-bit formats: sixteen weights decoded by the
                //  format's own arithmetic, as the row product has it.
                float v[16];
                decode16 (shape.format, row, k0 + half_of * 16u, v);
                for (uint j = 0u; j < 16u; ++j) {
                    wt[into + j] = float16_t (v[j]);
                }
            }
#elif defined(MORE_FORMATS)
            if (is_nibble (shape.format)) {
                //  The six formats that keep thirty-two elements in a
                //  block behind one scale, as nibbles. They share a shape
                //  and differ only in what is done to a nibble once it is
                //  out: centred on eight or sixteen, lifted by a minimum of
                //  its own, given a fifth bit from four bytes held apart,
                //  or read as an index into a table -- the levels, or the
                //  fours behind MXFP4's one-byte power-of-two scale.
                //
                //  The low half of byte j is element j and the high half is
                //  element j + 16, so both halves of a step read the same
                //  sixteen bytes and only the nibble differs.
                uint fmt = shape.format;

                uint quants_at = fmt == FMT_Q4_1 ? 4u
                                 : (fmt == FMT_Q5_0 ? 6u
                                    : (fmt == FMT_Q5_1 ? 8u
                                       : (fmt == FMT_MXFP4 ? 1u : 2u)));

                uint at = row + (k0 / 32u) * block_bytes (fmt);

                float scale = fmt == FMT_MXFP4 ? e8m0_at (at) : half_at (at);
                float lowest = (fmt == FMT_Q4_1 || fmt == FMT_Q5_1)
                               ? half_at (at + 2u) : 0.0;
                float bias = fmt == FMT_Q4_0 ? 8.0
                             : (fmt == FMT_Q5_0 ? 16.0 : 0.0);

                //  The fifth bits, read as one number. Bit j belongs to
                //  element j and bit j + 16 to element j + 16, so this
                //  invocation wants sixteen consecutive bits of it.
                uint fifths = 0u;
                if (fmt == FMT_Q5_0 || fmt == FMT_Q5_1) {
                    uint f = at + (fmt == FMT_Q5_0 ? 2u : 4u);
                    fifths = byte_at (f) | (byte_at (f + 1u) << 8u)
                             | (byte_at (f + 2u) << 16u)
                             | (byte_at (f + 3u) << 24u);
                    fifths = fifths >> (half_of * 16u);
                }

                uint p0, p1, p2, p3;
                four_words (at + quants_at, p0, p1, p2, p3);
                uint turn = half_of * 4u;
                uint levelled = fmt == FMT_IQ4_NL ? LEVELS_TABLE
                                : (fmt == FMT_MXFP4 ? FOURS_TABLE : NO_TABLE);

                wt[into +  0u] = float16_t (scale * nibble_value
                    (p0, turn +  0u,  0u, fifths, levelled, bias)
                    + lowest);
                wt[into +  1u] = float16_t (scale * nibble_value
                    (p0, turn +  8u,  1u, fifths, levelled, bias)
                    + lowest);
                wt[into +  2u] = float16_t (scale * nibble_value
                    (p0, turn + 16u,  2u, fifths, levelled, bias)
                    + lowest);
                wt[into +  3u] = float16_t (scale * nibble_value
                    (p0, turn + 24u,  3u, fifths, levelled, bias)
                    + lowest);
                wt[into +  4u] = float16_t (scale * nibble_value
                    (p1, turn +  0u,  4u, fifths, levelled, bias)
                    + lowest);
                wt[into +  5u] = float16_t (scale * nibble_value
                    (p1, turn +  8u,  5u, fifths, levelled, bias)
                    + lowest);
                wt[into +  6u] = float16_t (scale * nibble_value
                    (p1, turn + 16u,  6u, fifths, levelled, bias)
                    + lowest);
                wt[into +  7u] = float16_t (scale * nibble_value
                    (p1, turn + 24u,  7u, fifths, levelled, bias)
                    + lowest);
                wt[into +  8u] = float16_t (scale * nibble_value
                    (p2, turn +  0u,  8u, fifths, levelled, bias)
                    + lowest);
                wt[into +  9u] = float16_t (scale * nibble_value
                    (p2, turn +  8u,  9u, fifths, levelled, bias)
                    + lowest);
                wt[into + 10u] = float16_t (scale * nibble_value
                    (p2, turn + 16u, 10u, fifths, levelled, bias)
                    + lowest);
                wt[into + 11u] = float16_t (scale * nibble_value
                    (p2, turn + 24u, 11u, fifths, levelled, bias)
                    + lowest);
                wt[into + 12u] = float16_t (scale * nibble_value
                    (p3, turn +  0u, 12u, fifths, levelled, bias)
                    + lowest);
                wt[into + 13u] = float16_t (scale * nibble_value
                    (p3, turn +  8u, 13u, fifths, levelled, bias)
                    + lowest);
                wt[into + 14u] = float16_t (scale * nibble_value
                    (p3, turn + 16u, 14u, fifths, levelled, bias)
                    + lowest);
                wt[into + 15u] = float16_t (scale * nibble_value
                    (p3, turn + 24u, 15u, fifths, levelled, bias)
                    + lowest);
            } else if (shape.format == FMT_Q2_K) {
                //  Two bits an element, sixteen sub-blocks of sixteen, and
                //  a four-bit scale and a four-bit minimum sharing a byte
                //  for each. A step of thirty-two columns is two of those
                //  sub-blocks and an invocation takes one of them whole, so
                //  its scale is read once.
                uint at = row + (k0 / 256u) * 84u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint group = here & 3u;

                float d = half_at (at + 80u);
                float dmin = half_at (at + 82u);

                uint packed = byte_at (at + side * 8u + group * 2u + half_of);
                float factor = d * float (packed & 15u);
                float lowest = dmin * float (packed >> 4u);

                uint p0, p1, p2, p3;
                four_words (at + 16u + side * 32u + half_of * 16u,
                            p0, p1, p2, p3);
                uint shift = 2u * group;

                wt[into +  0u] = float16_t (factor * float
                    ((p0 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  1u] = float16_t (factor * float
                    ((p0 >> ( 8u + shift)) & 3u) - lowest);
                wt[into +  2u] = float16_t (factor * float
                    ((p0 >> (16u + shift)) & 3u) - lowest);
                wt[into +  3u] = float16_t (factor * float
                    ((p0 >> (24u + shift)) & 3u) - lowest);
                wt[into +  4u] = float16_t (factor * float
                    ((p1 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  5u] = float16_t (factor * float
                    ((p1 >> ( 8u + shift)) & 3u) - lowest);
                wt[into +  6u] = float16_t (factor * float
                    ((p1 >> (16u + shift)) & 3u) - lowest);
                wt[into +  7u] = float16_t (factor * float
                    ((p1 >> (24u + shift)) & 3u) - lowest);
                wt[into +  8u] = float16_t (factor * float
                    ((p2 >> ( 0u + shift)) & 3u) - lowest);
                wt[into +  9u] = float16_t (factor * float
                    ((p2 >> ( 8u + shift)) & 3u) - lowest);
                wt[into + 10u] = float16_t (factor * float
                    ((p2 >> (16u + shift)) & 3u) - lowest);
                wt[into + 11u] = float16_t (factor * float
                    ((p2 >> (24u + shift)) & 3u) - lowest);
                wt[into + 12u] = float16_t (factor * float
                    ((p3 >> ( 0u + shift)) & 3u) - lowest);
                wt[into + 13u] = float16_t (factor * float
                    ((p3 >> ( 8u + shift)) & 3u) - lowest);
                wt[into + 14u] = float16_t (factor * float
                    ((p3 >> (16u + shift)) & 3u) - lowest);
                wt[into + 15u] = float16_t (factor * float
                    ((p3 >> (24u + shift)) & 3u) - lowest);
            } else if (shape.format == FMT_IQ4_XS) {
                //  The levels again, over a super-block: one half-precision
                //  scale for the whole of it and a six-bit one for each
                //  sub-block of thirty-two, four bits in a nibble and two
                //  in a shared word, signed by taking thirty-two away.
                uint at = row + (k0 / 256u) * 136u;
                uint sub = (k0 / 32u) & 7u;

                float d = half_at (at);
                uint high = byte_at (at + 2u) | (byte_at (at + 3u) << 8u);

                uint nibble = (sub & 1u) == 0u
                              ? (byte_at (at + 4u + sub / 2u) & 15u)
                              : (byte_at (at + 4u + sub / 2u) >> 4u);
                uint upper = (high >> (2u * sub)) & 3u;
                float step = d * (float (nibble + 16u * upper) - 32.0);

                uint p0, p1, p2, p3;
                four_words (at + 8u + sub * 16u, p0, p1, p2, p3);
                uint turn = half_of * 4u;

                wt[into +  0u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 0u)) & 15u]));
                wt[into +  1u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 8u)) & 15u]));
                wt[into +  2u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 16u)) & 15u]));
                wt[into +  3u] = float16_t (step * float
                    (LEVELS[(p0 >> (turn + 24u)) & 15u]));
                wt[into +  4u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 0u)) & 15u]));
                wt[into +  5u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 8u)) & 15u]));
                wt[into +  6u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 16u)) & 15u]));
                wt[into +  7u] = float16_t (step * float
                    (LEVELS[(p1 >> (turn + 24u)) & 15u]));
                wt[into +  8u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 0u)) & 15u]));
                wt[into +  9u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 8u)) & 15u]));
                wt[into + 10u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 16u)) & 15u]));
                wt[into + 11u] = float16_t (step * float
                    (LEVELS[(p2 >> (turn + 24u)) & 15u]));
                wt[into + 12u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 0u)) & 15u]));
                wt[into + 13u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 8u)) & 15u]));
                wt[into + 14u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 16u)) & 15u]));
                wt[into + 15u] = float16_t (step * float
                    (LEVELS[(p3 >> (turn + 24u)) & 15u]));
            } else if (shape.format == FMT_Q3_K) {
                //  Two bits an element in sixty-four bytes and the third
                //  bit apart in a mask of thirty-two, one bit of it for
                //  each of the eight steps a super-block is made of. A set
                //  bit means the element is as it reads and a clear one
                //  means four is taken from it, which is the sign this
                //  format keeps in place of a minimum.
                uint at = row + (k0 / 256u) * 110u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint group = here & 3u;

                float factor = half_at (at + 108u)
                               * float (q3k_scale (at + 96u,
                                                   side * 8u + group * 2u
                                                   + half_of));

                uint p0, p1, p2, p3;
                four_words (at + 32u + side * 32u + half_of * 16u,
                            p0, p1, p2, p3);

                uint m0, m1, m2, m3;
                four_words (at + half_of * 16u, m0, m1, m2, m3);

                uint shift = 2u * group;
                uint bit = side * 4u + group;

                wt[into +  0u] = float16_t (factor *
                    (float ((p0 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> ( 0u + bit)) & 1u))));
                wt[into +  1u] = float16_t (factor *
                    (float ((p0 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> ( 8u + bit)) & 1u))));
                wt[into +  2u] = float16_t (factor *
                    (float ((p0 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> (16u + bit)) & 1u))));
                wt[into +  3u] = float16_t (factor *
                    (float ((p0 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m0 >> (24u + bit)) & 1u))));
                wt[into +  4u] = float16_t (factor *
                    (float ((p1 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> ( 0u + bit)) & 1u))));
                wt[into +  5u] = float16_t (factor *
                    (float ((p1 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> ( 8u + bit)) & 1u))));
                wt[into +  6u] = float16_t (factor *
                    (float ((p1 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> (16u + bit)) & 1u))));
                wt[into +  7u] = float16_t (factor *
                    (float ((p1 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m1 >> (24u + bit)) & 1u))));
                wt[into +  8u] = float16_t (factor *
                    (float ((p2 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> ( 0u + bit)) & 1u))));
                wt[into +  9u] = float16_t (factor *
                    (float ((p2 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> ( 8u + bit)) & 1u))));
                wt[into + 10u] = float16_t (factor *
                    (float ((p2 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> (16u + bit)) & 1u))));
                wt[into + 11u] = float16_t (factor *
                    (float ((p2 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m2 >> (24u + bit)) & 1u))));
                wt[into + 12u] = float16_t (factor *
                    (float ((p3 >> ( 0u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> ( 0u + bit)) & 1u))));
                wt[into + 13u] = float16_t (factor *
                    (float ((p3 >> ( 8u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> ( 8u + bit)) & 1u))));
                wt[into + 14u] = float16_t (factor *
                    (float ((p3 >> (16u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> (16u + bit)) & 1u))));
                wt[into + 15u] = float16_t (factor *
                    (float ((p3 >> (24u + shift)) & 3u)
                     - 4.0 * float (1u - ((m3 >> (24u + bit)) & 1u))));
            }
#else
            if (shape.format <= FMT_BF16) {
                //  Sixteen bits a weight and no blocks: the sixteen an
                //  invocation wants are eight words, and they always start
                //  on a word boundary because a row is a whole number of
                //  them.
                //
                //  Half precision is copied and brain floating point is
                //  shifted into the top of a binary32 and rounded once.
                //  Neither loses anything the tile could have held.
                uint at = row + (k0 + half_of * 16u) * 2u;
                uint i  = at >> 2u;

                for (uint j = 0u; j < 8u; ++j) {
                    uint held = w[i + j];

                    if (shape.format == FMT_F16) {
                        vec2 pair = unpackHalf2x16(held);
                        wt[into + j * 2u]      = float16_t(pair.x);
                        wt[into + j * 2u + 1u] = float16_t(pair.y);
                    } else {
                        wt[into + j * 2u] =
                            float16_t(uintBitsToFloat(held << 16u));
                        wt[into + j * 2u + 1u] =
                            float16_t(uintBitsToFloat(held & 0xFFFF0000u));
                    }
                }
            } else if (shape.format == FMT_Q8_0) {
                uint at = row + (k0 / 32u) * 34u;
                float16_t d = float16_t(half_at(at));

                uint q = at + 2u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);

                //  Four signed bytes a word, unpacked together and scaled in
                //  half precision, as they were one at a time.
                f16vec4 v0 = f16vec4(unpack8(int(p0))) * d;
                f16vec4 v1 = f16vec4(unpack8(int(p1))) * d;
                f16vec4 v2 = f16vec4(unpack8(int(p2))) * d;
                f16vec4 v3 = f16vec4(unpack8(int(p3))) * d;

                wt[into +  0u] = v0.x; wt[into +  1u] = v0.y;
                wt[into +  2u] = v0.z; wt[into +  3u] = v0.w;
                wt[into +  4u] = v1.x; wt[into +  5u] = v1.y;
                wt[into +  6u] = v1.z; wt[into +  7u] = v1.w;
                wt[into +  8u] = v2.x; wt[into +  9u] = v2.y;
                wt[into + 10u] = v2.z; wt[into + 11u] = v2.w;
                wt[into + 12u] = v3.x; wt[into + 13u] = v3.y;
                wt[into + 14u] = v3.z; wt[into + 15u] = v3.w;
            } else if (shape.format == FMT_Q4_K) {
                //  Q4_K. A super-block is two hundred and fifty-six
                //  elements in a hundred and forty-four bytes, and a step
                //  of thirty-two columns is one of its eight sub-blocks:
                //  the low nibbles of a thirty-two byte group, or the high
                //  nibbles of the same group for the sub-block after it.
                //
                //  A value here is the whole value -- the scale times the
                //  quant less the minimum -- rather than a quant with the
                //  correction taken out afterwards. That correction exists
                //  in the processor's kernel because its instruction
                //  multiplies integers; this one multiplies what it is
                //  given, so the minimum is subtracted where it is read.
                uint at  = row + (k0 / 256u) * 144u;
                uint sub = (k0 / 32u) & 7u;

                float d    = half_at(at);
                float least = half_at(at + 2u);

                uint factor, lowest;
                sub_block_scale(at + 4u, sub, factor, lowest);

                //  Both kept in binary32 and the value rounded once, at
                //  the end. Rounding the scale and the minimum first and
                //  then multiplying and subtracting in half precision
                //  rounds three times, and the subtraction is where a
                //  value goes small: 3.6 per cent worst relative error
                //  against 0.4 for one rounding, on the same numbers.
                float scale  = d * float(factor);
                float offset = least * float(lowest);

                //  Sixteen of the group's thirty-two bytes, and one nibble
                //  from each. The quants start sixteen bytes into a block
                //  whose length is a multiple of four, so this read is
                //  always on a word boundary and needs no shifting.
                uint q = at + 16u + (sub >> 1u) * 32u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);
                uint turn = (sub & 1u) * 4u;

                //  Four values a word: the nibble of every byte masked at
                //  once, the four bytes unpacked together, and the scale
                //  and the minimum applied as a vector in binary32 before
                //  the one rounding to half.
                f16vec4 v0 = f16vec4(scale * vec4(unpack8((p0 >> turn)
                                                  & 0x0F0F0F0Fu)) - offset);
                f16vec4 v1 = f16vec4(scale * vec4(unpack8((p1 >> turn)
                                                  & 0x0F0F0F0Fu)) - offset);
                f16vec4 v2 = f16vec4(scale * vec4(unpack8((p2 >> turn)
                                                  & 0x0F0F0F0Fu)) - offset);
                f16vec4 v3 = f16vec4(scale * vec4(unpack8((p3 >> turn)
                                                  & 0x0F0F0F0Fu)) - offset);

                wt[into +  0u] = v0.x; wt[into +  1u] = v0.y;
                wt[into +  2u] = v0.z; wt[into +  3u] = v0.w;
                wt[into +  4u] = v1.x; wt[into +  5u] = v1.y;
                wt[into +  6u] = v1.z; wt[into +  7u] = v1.w;
                wt[into +  8u] = v2.x; wt[into +  9u] = v2.y;
                wt[into + 10u] = v2.z; wt[into + 11u] = v2.w;
                wt[into + 12u] = v3.x; wt[into + 13u] = v3.y;
                wt[into + 14u] = v3.z; wt[into + 15u] = v3.w;
            } else if (shape.format == FMT_Q5_K) {
                //  Q5_K. The four-bit k-quant with a bit taken out of every
                //  quant and kept apart: the same two scales and the same
                //  twelve packed six-bit pairs, then thirty-two bytes
                //  holding the fifth bit of all two hundred and fifty-six
                //  elements, then the nibbles.
                //
                //  A byte of that array serves all eight sub-blocks at one
                //  position, one bit each, so the bit a sub-block wants is
                //  bit s of it and the sixteen bytes an invocation reads
                //  are the same sixteen whichever sub-block the step is.
                uint at  = row + (k0 / 256u) * 176u;
                uint sub = (k0 / 32u) & 7u;

                float d     = half_at(at);
                float least = half_at(at + 2u);

                uint factor, lowest;
                sub_block_scale(at + 4u, sub, factor, lowest);

                float scale  = d * float(factor);
                float offset = least * float(lowest);

                uint q = at + 48u + (sub >> 1u) * 32u + half_of * 16u;
                uint p0, p1, p2, p3;
                four_words (q, p0, p1, p2, p3);

                uint f0, f1, f2, f3;
                four_words (at + 16u + half_of * 16u, f0, f1, f2, f3);

                uint turn = (sub & 1u) * 4u;

                wt[into +  0u] = float16_t(scale * float(
                    ((p0 >> (turn)) & 15u)
                    + 16u * ((f0 >> (sub)) & 1u)) - offset);
                wt[into +  1u] = float16_t(scale * float(
                    ((p0 >> (turn +  8u)) & 15u)
                    + 16u * ((f0 >> (sub +  8u)) & 1u)) - offset);
                wt[into +  2u] = float16_t(scale * float(
                    ((p0 >> (turn + 16u)) & 15u)
                    + 16u * ((f0 >> (sub + 16u)) & 1u)) - offset);
                wt[into +  3u] = float16_t(scale * float(
                    ((p0 >> (turn + 24u)) & 15u)
                    + 16u * ((f0 >> (sub + 24u)) & 1u)) - offset);
                wt[into +  4u] = float16_t(scale * float(
                    ((p1 >> (turn)) & 15u)
                    + 16u * ((f1 >> (sub)) & 1u)) - offset);
                wt[into +  5u] = float16_t(scale * float(
                    ((p1 >> (turn +  8u)) & 15u)
                    + 16u * ((f1 >> (sub +  8u)) & 1u)) - offset);
                wt[into +  6u] = float16_t(scale * float(
                    ((p1 >> (turn + 16u)) & 15u)
                    + 16u * ((f1 >> (sub + 16u)) & 1u)) - offset);
                wt[into +  7u] = float16_t(scale * float(
                    ((p1 >> (turn + 24u)) & 15u)
                    + 16u * ((f1 >> (sub + 24u)) & 1u)) - offset);
                wt[into +  8u] = float16_t(scale * float(
                    ((p2 >> (turn)) & 15u)
                    + 16u * ((f2 >> (sub)) & 1u)) - offset);
                wt[into +  9u] = float16_t(scale * float(
                    ((p2 >> (turn +  8u)) & 15u)
                    + 16u * ((f2 >> (sub +  8u)) & 1u)) - offset);
                wt[into + 10u] = float16_t(scale * float(
                    ((p2 >> (turn + 16u)) & 15u)
                    + 16u * ((f2 >> (sub + 16u)) & 1u)) - offset);
                wt[into + 11u] = float16_t(scale * float(
                    ((p2 >> (turn + 24u)) & 15u)
                    + 16u * ((f2 >> (sub + 24u)) & 1u)) - offset);
                wt[into + 12u] = float16_t(scale * float(
                    ((p3 >> (turn)) & 15u)
                    + 16u * ((f3 >> (sub)) & 1u)) - offset);
                wt[into + 13u] = float16_t(scale * float(
                    ((p3 >> (turn +  8u)) & 15u)
                    + 16u * ((f3 >> (sub +  8u)) & 1u)) - offset);
                wt[into + 14u] = float16_t(scale * float(
                    ((p3 >> (turn + 16u)) & 15u)
                    + 16u * ((f3 >> (sub + 16u)) & 1u)) - offset);
                wt[into + 15u] = float16_t(scale * float(
                    ((p3 >> (turn + 24u)) & 15u)
                    + 16u * ((f3 >> (sub + 24u)) & 1u)) - offset);
            } else {
                //  Q6_K. Two hundred and fifty-six elements in two hundred
                //  and ten bytes: a hundred and twenty-eight low nibbles,
                //  sixty-four bytes of the two high bits, sixteen signed
                //  sub-block scales, then the block's own scale.
                //
                //  A step of thirty-two columns is exactly one of the eight
                //  runs the format is read in, and an invocation's sixteen
                //  of them share one sub-block scale, so the scale is read
                //  once rather than per element.
                uint at   = row + (k0 / 256u) * 210u;
                uint here = (k0 / 32u) & 7u;
                uint side = here >> 2u;
                uint run  = here & 3u;

                float d = half_at(at + 208u);
                float step = d * float
                  (signed_at (at + 192u + side * 8u + run * 2u + half_of));

                //  The low nibbles of this run, and the byte holding two
                //  high bits for each of the four runs the same nibble
                //  byte serves.
                uint low  = at + side * 64u + (run & 1u) * 32u
                            + half_of * 16u;
                uint high = at + 128u + side * 32u + half_of * 16u;

                uint l0, l1, l2, l3;
                uint h0, h1, h2, h3;
                four_words (low, l0, l1, l2, l3);
                four_words (high, h0, h1, h2, h3);

                //  Which nibble of the low byte, and which pair of bits of
                //  the high one. The first two runs take the low nibble and
                //  the last two the high; each takes its own pair.
                uint nib = (run >> 1u) * 4u;
                uint top = run * 2u;

                //  Four values a word: each byte's nibble and its pair of
                //  high bits masked together, the four bytes unpacked at
                //  once, and the offset and scale applied as a vector --
                //  a quarter of the shifts and masks one value at a time
                //  took, which is what this format's staging was bound by.
                uint q0 = ((l0 >> nib) & 0x0F0F0F0Fu)
                          | (((h0 >> top) & 0x03030303u) << 4u);
                uint q1 = ((l1 >> nib) & 0x0F0F0F0Fu)
                          | (((h1 >> top) & 0x03030303u) << 4u);
                uint q2 = ((l2 >> nib) & 0x0F0F0F0Fu)
                          | (((h2 >> top) & 0x03030303u) << 4u);
                uint q3 = ((l3 >> nib) & 0x0F0F0F0Fu)
                          | (((h3 >> top) & 0x03030303u) << 4u);

                f16vec4 v0 = f16vec4((vec4(unpack8(q0)) - 32.0) * step);
                f16vec4 v1 = f16vec4((vec4(unpack8(q1)) - 32.0) * step);
                f16vec4 v2 = f16vec4((vec4(unpack8(q2)) - 32.0) * step);
                f16vec4 v3 = f16vec4((vec4(unpack8(q3)) - 32.0) * step);

                wt[into +  0u] = v0.x; wt[into +  1u] = v0.y;
                wt[into +  2u] = v0.z; wt[into +  3u] = v0.w;
                wt[into +  4u] = v1.x; wt[into +  5u] = v1.y;
                wt[into +  6u] = v1.z; wt[into +  7u] = v1.w;
                wt[into +  8u] = v2.x; wt[into +  9u] = v2.y;
                wt[into + 10u] = v2.z; wt[into + 11u] = v2.w;
                wt[into + 12u] = v3.x; wt[into + 13u] = v3.y;
                wt[into + 14u] = v3.z; wt[into + 15u] = v3.w;
            }
#endif
        }

        barrier();

        for (uint step = 0u; step < KCH * CHUNKS; step += 16u) {
            uint chunk = step / KCH;
            uint kk    = step - chunk * KCH;

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
                a[AR];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
                b[AV];

            for (uint i = 0u; i < AR; ++i) {
                coopMatLoad(a[i], wt,
                            chunk * TILE_R * WT_STRIDE
                            + i * 16u * WT_STRIDE + kk,
                            WT_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }

            //  Column major with the batch's own stride is the transpose
            //  the product wants, so nothing is turned round on the way in:
            //  element (k, n) of the operand is column k of vector n, which
            //  is where the batch already keeps it.
            for (uint j = 0u; j < AV; ++j) {
                coopMatLoad(b[j], x,
                            (vec0 + j * 16u) * shape.columns + kb + step,
                            shape.columns,
                            gl_CooperativeMatrixLayoutColumnMajor);
            }

            for (uint i = 0u; i < AR; ++i) {
                for (uint j = 0u; j < AV; ++j) {
                    acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
                }
            }
        }
    }

    //  And out the same way: the answers of one vector are contiguous, so
    //  the tile is stored column major with the row count as its stride.
    for (uint i = 0u; i < AR; ++i) {
        for (uint j = 0u; j < AV; ++j) {
            uint where = (vec0 + j * 16u) * shape.rows
                         + row0 + i * 16u;

            //  A block of sixteen vectors past this expert's run is the
            //  next expert's, and is left to it; and a block of rows past
            //  the matrix's is nobody's.
            if ((listed && vec0 + j * 16u >= run_at + run_count)
                || row0 + i * 16u >= shape.rows) {
                continue;
            }

            if (shape.first > 0u) {
                coopMatStore
                  (coopmat<float16_t, gl_ScopeSubgroup, 16, 16,
                           gl_MatrixUseAccumulator> (acc[i][j]),
                   made, shape.first - 1u + where, shape.rows,
                   gl_CooperativeMatrixLayoutColumnMajor);
            } else if (shape.joins != 0u) {
                coopmat<float, gl_ScopeSubgroup, 16, 16,
                        gl_MatrixUseAccumulator> was;

                coopMatLoad(was, rj, where, shape.rows,
                            gl_CooperativeMatrixLayoutColumnMajor);

                coopMatStore(acc[i][j] + was, y, where, shape.rows,
                             gl_CooperativeMatrixLayoutColumnMajor);
            } else {
                coopMatStore(acc[i][j], y, where, shape.rows,
                             gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
    }
}
