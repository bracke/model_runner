uint u16_at(uint at) { return (w[at >> 2u] >> ((at & 2u) * 8u)) & 0xFFFFu; }
uint u32_at(uint at) { return u16_at(at) | (u16_at(at + 2u) << 16u); }

uint ksign(uint index) { return index | ((bitCount(index) & 1u) << 7u); }

uint low_elements(uint format) {
    return format == FMT_Q1_0 ? 128u
         : (format == FMT_Q2_0 || format == FMT_NVFP4) ? 64u : 256u;
}

uint low_bytes(uint format) {
    switch (format) {
        case FMT_IQ3_S:   return 110u;
        case FMT_IQ2_XXS: return 66u;
        case FMT_IQ2_XS:  return 74u;
        case FMT_IQ2_S:   return 82u;
        case FMT_IQ3_XXS: return 98u;
        case FMT_IQ1_S:   return 50u;
        case FMT_IQ1_M:   return 56u;
        case FMT_TQ1_0:   return 54u;
        case FMT_TQ2_0:   return 66u;
        case FMT_Q1_0:    return 18u;
        case FMT_Q2_0:    return 18u;
        default:          return 36u;
    }
}

//  Eight grid magnitudes, the bytes of two words, signed by a pattern.
void signed8(uint lo, uint hi, uint signs, float scale, inout float v[16], uint o) {
    for (uint j = 0u; j < 4u; ++j) {
        float m0 = float((lo >> (8u * j)) & 255u);
        float m1 = float((hi >> (8u * j)) & 255u);
        v[o + j]      = scale * (((signs >> j) & 1u) != 0u ? -m0 : m0);
        v[o + 4u + j] = scale * (((signs >> (j + 4u)) & 1u) != 0u ? -m1 : m1);
    }
}

//  Eight IQ1 values from a packed entry: dl (field - 1 + shift).
void iq1_8(uint index, float dl, float shift, inout float v[16], uint o) {
    uint entry = (IQ1S_PACKED[index >> 1u] >> ((index & 1u) * 16u)) & 0xFFFFu;
    for (uint j = 0u; j < 8u; ++j) {
        v[o + j] = dl * (float((entry >> (2u * j)) & 3u) - 1.0 + shift);
    }
}

const float FOURS4[16] = float[16](0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0,
                                   0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0);

//  Sixteen weights of a row, one after another from column col, into v.
void decode16(uint format, uint row, uint col, out float v[16]) {
    uint elems = low_elements(format);
    uint at = row + (col / elems) * low_bytes(format);
    uint within = col % elems;
    uint sub = within / 32u;
    uint l = (within % 32u) / 8u;

    for (uint j = 0u; j < 16u; ++j) {
        v[j] = 0.0;
    }

    if (format == FMT_IQ2_XXS) {
        uint q = at + 2u + 8u * sub;
        uint aux0 = u32_at(q);
        uint aux1 = u32_at(q + 4u);
        float db = unpackHalf2x16(u16_at(at)).x * (0.5 + float(aux1 >> 28u)) * 0.25;
        for (uint t = 0u; t < 2u; ++t) {
            uint g = (aux0 >> (8u * (l + t))) & 255u;
            signed8(IQ2XXS_GRID[2u * g], IQ2XXS_GRID[2u * g + 1u],
                    ksign((aux1 >> (7u * (l + t))) & 127u), db, v, 8u * t);
        }
    } else if (format == FMT_IQ2_XS) {
        uint scales = byte_at(at + 66u + sub);
        float db = unpackHalf2x16(u16_at(at)).x
                   * (0.5 + float(l < 2u ? (scales & 15u) : (scales >> 4u))) * 0.25;
        for (uint t = 0u; t < 2u; ++t) {
            uint lane = u16_at(at + 2u + 2u * (4u * sub + l + t));
            uint g = lane & 511u;
            signed8(IQ2XS_GRID[2u * g], IQ2XS_GRID[2u * g + 1u],
                    ksign(lane >> 9u), db, v, 8u * t);
        }
    } else if (format == FMT_IQ2_S) {
        uint tops = byte_at(at + 66u + sub);
        uint scales = byte_at(at + 74u + sub);
        float db = unpackHalf2x16(u16_at(at)).x
                   * (0.5 + float(l < 2u ? (scales & 15u) : (scales >> 4u))) * 0.25;
        for (uint t = 0u; t < 2u; ++t) {
            uint lane = 4u * sub + l + t;
            uint g = byte_at(at + 2u + lane) | (((tops >> (2u * (l + t))) & 3u) << 8u);
            signed8(IQ2S_GRID[2u * g], IQ2S_GRID[2u * g + 1u],
                    byte_at(at + 34u + lane), db, v, 8u * t);
        }
    } else if (format == FMT_IQ3_XXS) {
        uint aux = u32_at(at + 66u + 4u * sub);
        float db = unpackHalf2x16(u16_at(at)).x * (0.5 + float(aux >> 28u)) * 0.5;
        for (uint t = 0u; t < 2u; ++t) {
            uint q = at + 2u + 8u * sub + 2u * (l + t);
            signed8(IQ3XXS_GRID[byte_at(q)], IQ3XXS_GRID[byte_at(q + 1u)],
                    ksign((aux >> (7u * (l + t))) & 127u), db, v, 8u * t);
        }
    } else if (format == FMT_IQ3_S) {
        uint high = byte_at(at + 66u + sub);
        uint scales = byte_at(at + 106u + sub / 2u);
        float db = unpackHalf2x16(u16_at(at)).x
                   * float(1u + 2u * (sub % 2u == 0u ? (scales & 15u) : (scales >> 4u)));
        for (uint t = 0u; t < 2u; ++t) {
            uint k = l + t;
            uint q = at + 2u + 8u * sub + 2u * k;
            signed8(IQ3S_GRID[byte_at(q)      | (((high >> (2u * k)) & 1u) << 8u)],
                    IQ3S_GRID[byte_at(q + 1u) | (((high >> (2u * k + 1u)) & 1u) << 8u)],
                    byte_at(at + 74u + 4u * sub + k), db, v, 8u * t);
        }
    } else if (format == FMT_IQ1_S) {
        uint high = u16_at(at + 34u + 2u * sub);
        float dl = unpackHalf2x16(u16_at(at)).x * float(2u * ((high >> 12u) & 7u) + 1u);
        float shift = (high & 0x8000u) != 0u ? -0.125 : 0.125;
        for (uint t = 0u; t < 2u; ++t) {
            uint k = l + t;
            iq1_8(byte_at(at + 2u + 4u * sub + k) | (((high >> (3u * k)) & 7u) << 8u),
                  dl, shift, v, 8u * t);
        }
    } else if (format == FMT_IQ1_M) {
        uint s0 = u16_at(at + 48u);
        uint s1 = u16_at(at + 50u);
        uint s2 = u16_at(at + 52u);
        uint s3 = u16_at(at + 54u);
        float d = unpackHalf2x16((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u)
                                 | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u)).x;
        uint pair = sub / 2u;
        uint word = pair == 0u ? s0 : pair == 1u ? s1 : pair == 2u ? s2 : s3;
        float dl = d * float(2u * ((word >> (6u * (sub % 2u) + 3u * (l / 2u))) & 7u) + 1u);
        uint nibbles = byte_at(at + 32u + 2u * sub + l / 2u);
        for (uint t = 0u; t < 2u; ++t) {
            uint n = (nibbles >> (4u * t)) & 15u;
            iq1_8(byte_at(at + 4u * sub + l + t) | ((n & 7u) << 8u),
                  dl, (n & 8u) != 0u ? -0.125 : 0.125, v, 8u * t);
        }
    } else if (format == FMT_TQ1_0) {
        float d = unpackHalf2x16(u16_at(at + 52u)).x;
        for (uint e = 0u; e < 16u; ++e) {
            uint c = within + e;
            uint byte_index = c < 160u ? c % 32u
                            : c < 240u ? 32u + (c - 160u) % 16u : 48u + (c - 240u) % 4u;
            uint digit = c < 160u ? c / 32u : c < 240u ? (c - 160u) / 16u : (c - 240u) / 4u;
            uint pow3 = digit == 0u ? 1u : digit == 1u ? 3u : digit == 2u ? 9u
                      : digit == 3u ? 27u : 81u;
            uint trit = (((byte_at(at + byte_index) * pow3) & 255u) * 3u) >> 8u;
            v[e] = (float(trit) - 1.0) * d;
        }
    } else if (format == FMT_TQ2_0) {
        float d = unpackHalf2x16(u16_at(at + 64u)).x;
        uint first = at + 32u * (within / 128u) + within % 32u;
        uint shift = 2u * ((within % 128u) / 32u);
        for (uint e = 0u; e < 16u; ++e) {
            v[e] = (float((byte_at(first + e) >> shift) & 3u) - 1.0) * d;
        }
    } else if (format == FMT_Q1_0) {
        float d = unpackHalf2x16(u16_at(at)).x;
        uint bits = byte_at(at + 2u + within / 8u) | (byte_at(at + 3u + within / 8u) << 8u);
        for (uint e = 0u; e < 16u; ++e) {
            v[e] = ((bits >> e) & 1u) != 0u ? d : -d;
        }
    } else if (format == FMT_Q2_0) {
        float d = unpackHalf2x16(u16_at(at)).x;
        for (uint e = 0u; e < 16u; ++e) {
            uint c = within + e;
            v[e] = (float((byte_at(at + 2u + c / 4u) >> (2u * (c % 4u))) & 3u) - 1.0) * d;
        }
    } else {
        //  NVFP4: sixteen elements are one run -- its E4M3 scale, halved,
        //  and eight bytes of nibbles, low ones first, then high.
        uint run = within / 16u;
        uint code = byte_at(at + run);
        uint exponent = (code >> 3u) & 15u;
        float mantissa = float(code & 7u);
        float d = (code == 0u || code == 0x7Fu) ? 0.0
                : exponent == 0u ? mantissa * exp2(-10.0)
                : (1.0 + mantissa / 8.0) * exp2(float(exponent) - 8.0);
        for (uint j = 0u; j < 8u; ++j) {
            uint b = byte_at(at + 4u + 8u * run + j);
            v[j]      = d * FOURS4[b & 15u];
            v[j + 8u] = d * FOURS4[b >> 4u];
        }
    }
}
#endif

//  The six-bit scale and minimum a Q4_K sub-block carries, as
//  row_product.comp reads them and for the same reason: twelve bytes hold
//  sixteen six-bit numbers, the first four pairs whole in a byte each and
//  the last four split, four bits in one byte and two in the top of another
//  that a lower sub-block is already using.
void sub_block_scale(uint at, uint index, out uint factor, out uint lowest) {
    if (index < 4u) {
        factor = byte_at(at + index) & 63u;
        lowest = byte_at(at + index + 4u) & 63u;
    } else {
        factor = (byte_at(at + index + 4u) & 15u)
                 | ((byte_at(at + index - 4u) >> 6u) << 4u);
        lowest = (byte_at(at + index + 4u) >> 4u)
                 | ((byte_at(at + index) >> 6u) << 4u);
    }
}

#ifdef MORE_FORMATS

const uint FMT_Q4_0   =  3u;
const uint FMT_Q4_1   =  4u;
const uint FMT_Q5_0   =  5u;
const uint FMT_Q5_1   =  6u;
const uint FMT_IQ4_NL =  8u;
const uint FMT_Q2_K   =  9u;
const uint FMT_Q3_K   = 10u;
const uint FMT_IQ4_XS = 14u;
const uint FMT_MXFP4  = 15u;

//  The sixteen levels a non-linear four-bit quant may take. A nibble in
//  IQ4_NL and IQ4_XS is not a number but an index into this, and the table
//  belongs to the format rather than to any file.
const int LEVELS[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10,
                                  1,   13,  25,  38,  53,  69,  89, 113);

//  MXFP4's own sixteen: the E2M1 floating-point values at twice their
//  size, 0, 0.5, 1, 1.5, 2, 3, 4, 6 and the same again negated, as
//  row_product.comp and the processor's decoder hold them. The scale
//  carries the halving.
const int FOURS[16] = int[16](0, 1, 2, 3, 4, 6, 8, 12,
                              0, -1, -2, -3, -4, -6, -8, -12);

//  An E8M0 exponent byte as two to the byte less a hundred and
//  twenty-eight -- less a hundred and twenty-seven for the exponent's own
//  bias, and one more for the doubled table. The bit pattern has a biased
//  exponent of the byte less one and no mantissa, so it is a shift; the
//  two bytes below that are subnormal, where the shift is of the leading
//  bit instead.
float e8m0_at (uint at) {
    uint e = byte_at (at);
    return uintBitsToFloat (e < 2u ? (0x00200000u << e) : ((e - 1u) << 23u));
}

//  Whether a format keeps thirty-two elements to a block rather than two
//  hundred and fifty-six, which decides how a row's length is counted.
//  MXFP4 is numbered past the super-blocks, so it is named apart.
bool is_short (uint format) {
    return (format >= FMT_Q4_0 && format <= FMT_IQ4_NL)
           || format == FMT_MXFP4;
}

//  And which of those keep them as nibbles. The eight-bit format sits in
//  the middle of that range and is not one of them, which is worth a
//  predicate of its own: it was caught by the range once and decoded as
//  nibbles, and the format test said so at the first element.
bool is_nibble (uint format) {
    return is_short (format) && format != FMT_Q8_0;
}

//  Bytes one block takes.
uint block_bytes (uint format) {
    switch (format) {
        case FMT_Q4_0:
        case FMT_IQ4_NL: return  18u;
        case FMT_Q4_1:   return  20u;
        case FMT_Q5_0:   return  22u;
        case FMT_Q5_1:   return  24u;
        case FMT_Q8_0:   return  34u;
        case FMT_Q2_K:   return  84u;
        case FMT_Q3_K:   return 110u;
        case FMT_Q4_K:   return 144u;
        case FMT_Q5_K:   return 176u;
        case FMT_Q6_K:   return 210u;
        case FMT_MXFP4:  return  17u;
        default:         return 136u;
    }
}

//  One nibble turned into the number its format means by it. Written as a
//  function so that the sixteen stores below can name their word rather
//  than choose it from four with a chain of tests: a chain the compiler
//  cannot fold is an indexed read of four live values, and it cost the
//  formats that were already here twenty-two per cent before this was
//  written out.
//
//  Table names which table, if any, the nibble indexes: none, the levels
//  of IQ4_NL, or the fours of MXFP4.
const uint NO_TABLE = 0u;
const uint LEVELS_TABLE = 1u;
const uint FOURS_TABLE = 2u;

float nibble_value (uint word, uint shift, uint k, uint fifths,
                    uint table, float bias) {
    uint nib = (word >> shift) & 15u;
    return table == LEVELS_TABLE
           ? float (LEVELS[nib])
           : (table == FOURS_TABLE
              ? float (FOURS[nib])
              : float (nib + ((fifths >> k) & 1u) * 16u) - bias);
}

//  One of the sixteen six-bit scales a Q3_K super-block carries, which are
//  packed unlike Q4_K's: twelve bytes, the low four bits of each of the
//  first eight in a nibble of their own and every top pair gathered into
//  the last four, two bits to a scale. Signed by taking thirty-two away.
int q3k_scale (uint at, uint which) {
    uint j    = which & 3u;
    uint tier = which >> 2u;
    uint low  = (byte_at (at + (tier & 1u) * 4u + j)
                 >> ((tier >> 1u) * 4u)) & 15u;
    uint top  = (byte_at (at + 8u + j) >> (2u * tier)) & 3u;

    return int (low) + 16 * int (top) - 32;
}

