   function Lower (Code_Point : Natural) return Natural is
      Low  : Positive := Lowers'First;
      High : Natural := Lowers'Last;
   begin
      while Low <= High loop
         declare
            Middle : constant Positive := Low + (High - Low) / 2;
         begin
            if Lowers (Middle).From = Code_Point then
               return Lowers (Middle).To;
            elsif Lowers (Middle).From < Code_Point then
               Low := Middle + 1;
            else
               High := Middle - 1;
            end if;
         end;
      end loop;
      return Code_Point;
   end Lower;

   function First_Of_Decomposition (Code_Point : Natural) return Natural is
      Low  : Positive := Decompositions'First;
      High : Natural := Decompositions'Last;
   begin
      while Low <= High loop
         declare
            Middle : constant Positive := Low + (High - Low) / 2;
         begin
            if Code_Point < Decompositions (Middle).First then
               High := Middle - 1;
            elsif Code_Point > Decompositions (Middle).Last then
               Low := Middle + 1;
            else
               return Decompositions (Middle).To;
            end if;
         end;
      end loop;
      return Code_Point;
   end First_Of_Decomposition;

