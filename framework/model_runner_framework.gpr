with "config/model_runner_framework_config.gpr";

project Model_Runner_Framework is
   for Languages use ("Ada");
   for Source_Dirs use ("../src/library", "config");
   for Object_Dir use "obj/" & Model_Runner_Framework_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Model_Runner_Framework_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-gnatyM120");
   end Compiler;
end Model_Runner_Framework;
