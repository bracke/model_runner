      "id": 1,
      "title": "Defer MoE activation gathering",
      "implementation": "Gather fallback floating-point rows once, only after packed/direct products decline. Existing indexed activation and physical expert storage remain.",
      "verification": "Existing quantized decoder, indexed small-block bounds and batch/reference cases.",
      "decision": "retained in combined measured selective-PGO build"
    },
    {
      "id": 2,
      "title": "Vector drafter exponentials and activation",
      "implementation": "SIMD the original attention polynomial and SiLU operations, preserving scalar tails, signed zeros, thresholds, FMA order and runtime ISA guards.",
      "verification": "New bit-exact scalar comparisons for lengths 0..65, shifted/guarded slices, saturation boundaries and activation signs.",
      "decision": "retained in combined measured selective-PGO build"
    },
    {
      "id": 3,
      "title": "Reuse per-block drafter RoPE tables",
      "implementation": "Build one angle table per proposed position and reuse it for query/key rotations across the three layers.",
      "verification": "Exact original-rotation comparison across widths, positions and shifted bounds, plus independent DSpark intermediate fixtures.",
      "decision": "retained in combined measured selective-PGO build"
    },
    {
      "id": 4,
      "title": "Distribute attention by token and KV group",
      "implementation": "Run existing pool jobs over token/KV groups with at most eight worker-owned score/fold slots; preserve each head reduction and settle all shares on errors.",
      "verification": "Existing serial/parallel short and long-context drafter fixtures, reset/rewind/reinjection, cancellation and generation recovery.",
      "decision": "retained in combined measured selective-PGO build"
    },
    {
      "id": 5,
      "title": "Separate loop-visit scheduling plans",
      "implementation": "Index bounded exact-key descriptors by existing logical state identity, retaining physical expert keys and shared weights. Include complete slot/table limits in session budget.",
      "verification": "Structural logical-slot count, exact batch/logit reuse comparisons and session cleanup.",
      "decision": "retained in combined measured selective-PGO build"
    },
    {
      "id": 6,
      "title": "Fuse drafter projection/residual writes",
      "implementation": "For eligible Q8_0 projections, pack once and add bounded worker tiles directly into residuals; retain ordinary observer/adapter/format fallback.",
      "verification": "Synthetic 139-row Q8_0 projections for batches 1..8 match full projection plus addition bit-for-bit, preserve guards and reject pre-cancelled publication. Existing F32 fixture covers ordinary fallback.",
      "decision": "retained in combined measured selective-PGO build"
    }
  ],
