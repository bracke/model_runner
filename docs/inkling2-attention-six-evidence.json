      "status": "retained_and_verified"
    },
    {
      "id": 2,
      "title": "Eight-position CPU attention",
      "implementation": "Eight independent binary32 dot lanes with key addresses held in registers; three heads share loaded keys. Original channel order and four-position/scalar tails remain.",
      "status": "retained_and_verified"
    },
    {
      "id": 3,
      "title": "Cross-query KV reuse",
      "implementation": "A six-accumulator query-pair kernel reuses loaded keys across two queries. F16 key/value expansion is shared, score rows are independent and budgeted, and softmax/value reductions stay chronological.",
      "status": "retained_and_verified"
    },
    {
      "id": 4,
      "title": "Fused CPU finite checks",
      "implementation": "Checked in-place RMS accumulates output validity while writing the result; existing unchecked callers retain their prior loops. Native clipping checks its final stores. The slower SIMD-output refinement was rejected; this retains the first measured CPU implementation.",
      "status": "retained_and_verified"
    },
    {
      "id": 5,
      "title": "Expert work distribution",
      "implementation": "Inkling job sizes use physical gate/up/down byte counts, dimensions and selected-token counts. Stable work sorting accounts for four-vector reuse and activation traffic; expert aggregation order and other architectures retain their prior rules.",
      "status": "retained_and_verified"
    },
    {
      "id": 6,
      "title": "Resident GPU attention prototype",
      "status": "rejected_after_measurement",
      "implementation": "Tested logical-visit GPU KV residency, score/softmax/value intermediates, gating, output projection and convolution in one existing-engine sequence. Independent fixtures covered continuation, changed prefixes, eviction/origin changes and cancellation. Prior GPU sources are restored.",
      "scope_limit": "The prototype started from normalized Q/K/V and relative/sink inputs. Upstream projection and preprocessing residency was outside its boundary; complete Q/K/V-to-output GPU block residency is not claimed as delivered."
    }
