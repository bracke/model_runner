  "collected_at": "2026-11-26T07:27:41.800288+00:00",
  "status": "Complete: eight bounded native changes, reference comparisons, single measurements, shared-engine regression and repository audit pass",
  "items": [
    {
      "id": 1,
      "title": "Fused quantized small batches",
      "implementation": "Two packed physical rows across three token vectors per group for counts 2..6; Q4_K/Q5_K/Q6_K weights remain in registers with original binary32 stages, four binary64 lanes and 2048-element folds. Larger batches retain existing kernels.",
      "verification": "Exact format/count/shape/scale matrices, shifted bounds, tails, long spans and checkpoint activation bytes."
    },
    {
      "id": 2,
      "title": "Persistent MoE worker scratch",
      "implementation": "Inkling session owns four growable buffers per exclusive pooled-job invocation slot; Close frees them. Other architectures retain the previous temporary lifetime.",
      "verification": "Batched expert and changing-partition tests; watched/unwatched checkpoint equality; lifecycle suite. Worst-case bounded scratch is included in memory planning."
    },
    {
      "id": 3,
      "title": "In-place learned RMS",
      "implementation": "One in-out row replaces the copied source. Sequential wide sum and separate binary32 scale/gain stages remain.",
      "verification": "Exact weighted RMS comparison for lengths 0..129, shifted bounds and signed gains; independent fixtures."
    },
    {
      "id": 4,
      "title": "SIMD residual mixing",
      "implementation": "Eight independent channels with separate binary32 multiply/add, original candidate order and scalar tails.",
      "verification": "Independent messages/depth mixing and exact captured activations."
    },
    {
      "id": 5,
      "title": "Shared KV loads across heads",
      "implementation": "Three heads share four-position key tiles and converted value rows, retaining channel-order binary32 scores and chronological binary64 sums. Existing score storage is reused.",
      "verification": "Exact capture, prefill/decode, eviction, rewind and F16-cache profiles. Incompatible shapes/teams retain the old path."
    },
    {
      "id": 6,
      "title": "Batched Vulkan gates",
      "implementation": "Full token batches use the existing raw gate, native logistic multiplication and output projection sequence.",
      "verification": "Positive device test executes counts 1..17 with observed/unobserved outputs and compares every token; independent device checkpoint suite."
    },
    {
      "id": 7,
      "title": "Resident output normalization/projection",
      "implementation": "One-token final learned RMS and vocabulary projection run as one device sequence; actual normalized row returns for session state and observers.",
      "verification": "Positive sequence test and unchanged independent GPU tolerances. Other convolution/control operations remain on their existing paths; this is not a fully GPU-resident decoder."
    },
    {
      "id": 8,
      "title": "Draft rewind checkpoint ring",
      "implementation": "Four successful call-boundary checkpoints retain convolution/final rows. Rewind selects the newest reachable entry and invalidates future branches; reset/adoption invalidate and Close frees.",
      "verification": "Older-boundary test requires zero replay, then exact hidden state/continuation; cancellation, eviction and lifecycle suites. Memory estimate includes all entries. No per-token checkpoint inside a batch."
    }
  ],
