  "schema": "model_runner.inkling2.eight_native_candidates.v1",
  "collected_at": "2026-11-26T00:01:06.009311+00:00",
  "status": "Complete: all eight native candidates implemented, exact/reference comparisons and single measurements qualified, shared-engine regression and repository audit pass",
  "items": [
    {
      "id": 1,
      "title": "Reusable evaluation workspace",
      "implementation": "Retain and grow session-owned evaluation arena and optional per-position logits; operate on active slices; release on Close",
      "verification": "Existing mixed batch-size prefill, cancellation, reset and reopen cases; exact original activation bytes"
    },
    {
      "id": 2,
      "title": "Fixed physical tensor cache",
      "implementation": "Lazily decode norm/clip tables, convolution taps and reachable relative-bias rows once per physical layer per session; include bounds in session memory planning",
      "verification": "Independent F32/Q8/zero-control, nonfinite and memory-limit cases; reset/reuse/adopt; exact checkpoint activations"
    },
    {
      "id": 3,
      "title": "Fused Q4_K eight-output products",
      "implementation": "Stage only compact scale/minimum parameters; decode packed nibbles in registers and retain binary32 dequantization plus the original four binary64 lanes and 2048-element span fold",
      "verification": "Exact scalar/wide matrices with shifted bounds, row tails, multiple blocks/spans, signed/subnormal/extreme half scales and diverse activation exponents"
    },
    {
      "id": 4,
      "title": "SIMD convolution",
      "implementation": "Four-channel three-tap kernel with separate binary32 multiply/add operations; scalar fallback for other tap counts or incompatible head widths",
      "verification": "Independent per-layer convolution/message/output fixtures, CPU/Vulkan differential cases, prefill partitions, rewind and cancellation"
    },
    {
      "id": 5,
      "title": "Residual mixing without saved-block staging copies",
      "implementation": "Project immutable normalized saved blocks directly; apply scores and sum candidates in the original reverse-block order",
      "verification": "Independent three-loop residual fixtures and exact byte comparison for all 2425 captured activations"
    },
    {
      "id": 6,
      "title": "Bounded rewind checkpoint",
      "implementation": "Save one call-boundary convolution state and valid final rows; restore only while KV origins retain the necessary window; replay the retained suffix or use the original full replay fallback",
      "verification": "Instrumented AUnit confirms one replayed token instead of a five-token prefix; hidden state and continuation match full recomputation for F32/Q8 and exact/half caches; reset, adoption, cancellation and long-window eviction suites pass",
      "limits": "Not a per-token checkpoint ring. Older boundaries and evicted windows still require full replay."
    },
    {
      "id": 7,
      "title": "Longer Vulkan projection sequences",
      "implementation": "Chain down -> gain/forget entirely on the existing device sequence, returning only final outputs; group independent single-token attention projections with apart inputs",
      "verification": "Watched/unwatched tiny device equality, independent real-checkpoint conformance and exact sixteen-token greedy output",
      "limits": "Normalization, gates and attention still use their qualified existing paths; this does not claim a complete GPU-resident decoder."
    },
    {
      "id": 8,
      "title": "Batched control projection groups",
      "implementation": "Extend existing CPU grouped jobs with a default-one vector count; retain ordinary batched kernels. Vulkan uses grouped or chained control projections during prefill. Observers keep product notifications.",
      "verification": "Distinct-weight CPU groups of 4..17 matrices, counts 1/4/33, shifted group bounds and untouched target tails; native partition and device prefix fixtures"
    }
  ],
