  "schema": "model_runner.inkling2.next_eight_native_candidates.v1",
  "collected_at": "2026-11-26T05:58:07.691880+00:00",
  "status": "Complete: all eight changes, reference comparisons, single measurements, shared-engine regression and repository audit pass",
  "items": [
    {
      "id": 1,
      "title": "Two/three-token products",
      "implementation": "Share two decoded weight rows across two or three activation vectors; retain four binary64 lanes and original span folding; widen eligible multi-row dispatch to these small batches",
      "verification": "Exact matrix tests across quantized and floating encodings, shifted bounds, row tails and span boundaries; exact checkpoint captures"
    },
    {
      "id": 2,
      "title": "Fused Q5_K/Q6_K eight-output products",
      "implementation": "Stage compact scale metadata only; unpack weights in registers with the original separate binary32 dequantization stages and binary64 accumulation",
      "verification": "Exact scalar/wide matrix cases including signed, subnormal and extreme half scales; unchanged tail and bounds behavior"
    },
    {
      "id": 3,
      "title": "SIMD non-finite checks",
      "implementation": "Classify exponent bits in eight unaligned lanes using the existing AVX2 guard, with scalar tails; preserve every required validation",
      "verification": "Every position in lengths 0..129, shifted arrays, positive/negative infinity and quiet/signalling NaNs; native failure checks"
    },
    {
      "id": 4,
      "title": "Unweighted RMS normalization",
      "implementation": "Source-compatible kernel overload removes all-ones weight construction and multiplication while retaining the weighted unit-gain binary32 stage contract",
      "verification": "Bit-exact comparison to unit-weight normalization over lengths 0..129 and shifted arrays; all checkpoint captures exact"
    },
    {
      "id": 5,
      "title": "Remove blanket arena clearing",
      "implementation": "Keep explicit accumulator initialization; saved-block visit guards and producer lifetimes protect reused scratch; remove full active-arena zero fill",
      "verification": "Poison reused scratch with NaNs before smaller partitioned prefill calls and compare output; cancellation, reset, rewind and reference tests"
    },
    {
      "id": 6,
      "title": "Shared convolution backup",
      "implementation": "Reuse the same pre-call convolution history for failure rollback and bounded rewind checkpoint; remove its duplicate allocation/copy and reduce the memory estimate accordingly",
      "verification": "Suffix-only rewind matches fresh replay; cancellation, reset, context adoption and eviction fallback tests"
    },
    {
      "id": 7,
      "title": "Grouped decode attention",
      "implementation": "Let single-token attention workers process query heads sharing one KV head together when existing worker/shape requirements permit",
      "verification": "Exact checkpoint activations, partitioned prefill, incremental decode and long-context cache cases; previous scheduling retained for other shapes"
    },
    {
      "id": 8,
      "title": "Vulkan gate/multiply/output sequence",
      "implementation": "Use existing backend sequence for raw gate projection, CPU-compatible logistic polynomial, elementwise attention multiplication and output projection; retain raw gate finite check and actual observer values",
      "verification": "Positive device test requires the sequence to execute, compares observed/unobserved results, and passes independent full-checkpoint device conformance",
      "limits": "One-token F32 activation path with existing capability fallback. This is not a fully device-resident decoder."
    }
  ],
