with "../../inference/model_runner_inference.gpr";
with "../../framework/model_runner_framework.gpr";

project Inference_Consumer is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("inference_consumer.adb");
   for Create_Missing_Dirs use "True";
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-gnatyM120");
   end Compiler;
end Inference_Consumer;
