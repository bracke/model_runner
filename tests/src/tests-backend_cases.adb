with AUnit.Assertions;

with Model_Runner.Backend;
with Model_Runner.Backend.CPU;
with Model_Runner.Bytes;
with Model_Runner.Errors;
with Model_Runner.GGUF;
with Model_Runner.Numerics;
with Model_Runner.Platform;
with Model_Runner.Tensors;

with Fixtures;

package body Tests.Backend_Cases is

   use AUnit.Assertions;
   use type Model_Runner.Bytes.Byte_Array_Access;
   use type Model_Runner.Errors.Error_Code;
   use type Model_Runner.Numerics.Element_Count;
   use type Model_Runner.Numerics.Real;
   use type Model_Runner.Tensors.Real_Array_Access;

   package B renames Model_Runner.Bytes;
   package CPU renames Model_Runner.Backend.CPU;
   package E renames Model_Runner.Errors;
   package G renames Model_Runner.GGUF;
   package N renames Model_Runner.Numerics;
   package T renames Model_Runner.Tensors;

   Rows    : constant N.Element_Count := 37;
   Columns : constant N.Element_Count := 24;

   --  Build a float32 weight view over freshly generated bytes.
   procedure Make_Weight
     (Storage : out B.Byte_Array_Access;
      Weight  : out T.View)
   is
      Values : constant N.Real_Array :=
        Fixtures.Sequence (Rows * Columns, 4321, 1.0);
      Bytes  : constant B.Byte_Array := Fixtures.Encode_F32 (Values);
      Status : E.Error_Info;
   begin
      B.Allocate (Bytes'Length, Storage);
      Storage.all := Bytes;
      T.Make (G.Type_F32, Rows, Columns, Storage, 0, Weight, Status);
      Assert (E.Is_Ok (Status), "weight view could not be built");
   end Make_Weight;

   --  The partition covers every row exactly once, for every worker count.
   procedure Partition_Covers_Rows (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
   begin
      for Total in N.Element_Count range 0 .. 40 loop
         for Team in CPU.Worker_Count range 1 .. 9 loop
            declare
               Seen : array (N.Element_Count range 0 .. 40) of Natural :=
                 [others => 0];
            begin
               for Index in CPU.Worker_Count range 1 .. Team loop
                  declare
                     First, Last : N.Element_Count;
                  begin
                     CPU.Partition (Total, Team, Index, First, Last);
                     if First <= Last then
                        Assert (Last < Total,
                                "partition ran past the last row");
                        for Row in First .. Last loop
                           Seen (Row) := Seen (Row) + 1;
                        end loop;
                     end if;
                  end;
               end loop;

               for Row in N.Element_Count range 0 .. Total - 1 loop
                  Assert (Seen (Row) = 1,
                          "row" & N.Element_Count'Image (Row)
                          & " was covered" & Natural'Image (Seen (Row))
                          & " times with" & CPU.Worker_Count'Image (Team)
                          & " workers");
               end loop;
            end;
         end loop;
      end loop;
   end Partition_Covers_Rows;

   --  A parallel product equals the serial one exactly, for every worker
   --  count. This is the property that makes changing --threads safe.
   procedure Parallel_Matches_Serial
     (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
      Storage : B.Byte_Array_Access;
      Weight  : T.View;
      Vector  : T.Real_Array_Access;
      Serial  : T.Real_Array_Access;
      Status  : E.Error_Info;
   begin
      Make_Weight (Storage, Weight);
      T.Allocate (Columns, Vector);
      T.Allocate (Rows, Serial);

      declare
         Input : constant N.Real_Array := Fixtures.Sequence (Columns, 99, 1.0);
      begin
         Vector.all := Input;
      end;

      CPU.Dispatch (null, Weight, Vector, Serial, Status);
      Assert (E.Is_Ok (Status), "serial product failed");

      for Team in CPU.Worker_Count range 1 .. 6 loop
         declare
            Pool     : aliased CPU.Pool (Team);
            Parallel : T.Real_Array_Access;
         begin
            T.Allocate (Rows, Parallel);
            CPU.Open (Pool);
            Assert (CPU.Is_Open (Pool), "pool did not open");
            Assert (CPU.Worker_Total (Pool) = Team, "wrong worker count");

            CPU.Mat_Vec (Pool, Weight, Vector, Parallel, Status);
            Assert (E.Is_Ok (Status),
                    "parallel product failed with"
                    & CPU.Worker_Count'Image (Team) & " workers: "
                    & E.Error_Code'Image (Status.Code));

            for Row in 0 .. Rows - 1 loop
               Assert (Parallel.all (Row) = Serial.all (Row),
                       "row" & N.Element_Count'Image (Row)
                       & " differs with" & CPU.Worker_Count'Image (Team)
                       & " workers");
            end loop;

            CPU.Close (Pool);
            T.Free (Parallel);
         end;
      end loop;

      T.Free (Vector);
      T.Free (Serial);
      B.Free (Storage);
   end Parallel_Matches_Serial;

   --  More workers than rows is legal: the surplus workers get nothing and the
   --  result is still complete.
   procedure More_Workers_Than_Rows
     (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
      Storage : B.Byte_Array_Access;
      Weight  : T.View;
      Vector  : T.Real_Array_Access;
      Serial  : T.Real_Array_Access;
      Wide    : T.Real_Array_Access;
      Status  : E.Error_Info;
      Pool    : aliased CPU.Pool (CPU.Worker_Count (Rows + 5));
   begin
      Make_Weight (Storage, Weight);
      T.Allocate (Columns, Vector);
      T.Allocate (Rows, Serial);
      T.Allocate (Rows, Wide);
      Vector.all := Fixtures.Sequence (Columns, 99, 1.0);

      CPU.Dispatch (null, Weight, Vector, Serial, Status);
      Assert (E.Is_Ok (Status), "serial product failed");

      CPU.Mat_Vec (Pool, Weight, Vector, Wide, Status);
      Assert (E.Is_Ok (Status), "oversized pool failed");

      for Row in 0 .. Rows - 1 loop
         Assert (Wide.all (Row) = Serial.all (Row),
                 "row" & N.Element_Count'Image (Row)
                 & " differs when workers outnumber rows");
      end loop;

      CPU.Close (Pool);
      T.Free (Vector);
      T.Free (Serial);
      T.Free (Wide);
      B.Free (Storage);
   end More_Workers_Than_Rows;

   --  A closed pool rejects work rather than queueing it, and closing twice is
   --  harmless.
   procedure Closed_Pool_Rejects (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
      Storage : B.Byte_Array_Access;
      Weight  : T.View;
      Vector  : T.Real_Array_Access;
      Target  : T.Real_Array_Access;
      Status  : E.Error_Info;
      Pool    : aliased CPU.Pool (3);
   begin
      Make_Weight (Storage, Weight);
      T.Allocate (Columns, Vector);
      T.Allocate (Rows, Target);
      Vector.all := Fixtures.Sequence (Columns, 5, 1.0);

      CPU.Mat_Vec (Pool, Weight, Vector, Target, Status);
      Assert (E.Is_Ok (Status), "first product failed");

      CPU.Close (Pool);
      Assert (not CPU.Is_Open (Pool), "a closed pool reported itself open");

      CPU.Mat_Vec (Pool, Weight, Vector, Target, Status);
      Assert (Status.Code = E.Backend_Closed,
              "a closed pool accepted work: " & E.Error_Code'Image (Status.Code));

      --  Closing twice must be harmless.
      CPU.Close (Pool);
      Assert (not CPU.Is_Open (Pool), "a second close changed the state");

      T.Free (Vector);
      T.Free (Target);
      B.Free (Storage);
   end Closed_Pool_Rejects;

   --  A pool is reusable: many jobs run through the same workers, and no task
   --  is created per job.
   procedure Pool_Is_Reused (T2 : in out AUnit.Test_Cases.Test_Case'Class) is
      pragma Unreferenced (T2);
      Storage : B.Byte_Array_Access;
      Weight  : T.View;
      Vector  : T.Real_Array_Access;
      Serial  : T.Real_Array_Access;
      Target  : T.Real_Array_Access;
      Status  : E.Error_Info;
      Pool    : aliased CPU.Pool (4);
   begin
      Make_Weight (Storage, Weight);
      T.Allocate (Columns, Vector);
      T.Allocate (Rows, Serial);
      T.Allocate (Rows, Target);
      Vector.all := Fixtures.Sequence (Columns, 17, 1.0);

      CPU.Dispatch (null, Weight, Vector, Serial, Status);
      Assert (E.Is_Ok (Status), "serial product failed");

      for Round in 1 .. 50 loop
         Target.all := [others => 0.0];
         CPU.Mat_Vec (Pool, Weight, Vector, Target, Status);
         Assert (E.Is_Ok (Status),
                 "round" & Integer'Image (Round) & " failed");
         for Row in 0 .. Rows - 1 loop
            Assert (Target.all (Row) = Serial.all (Row),
                    "round" & Integer'Image (Round) & " differed");
         end loop;
      end loop;

      CPU.Close (Pool);
      T.Free (Vector);
      T.Free (Serial);
      T.Free (Target);
      B.Free (Storage);
   end Pool_Is_Reused;

   --  A pool that is created and then never used must still terminate. It
   --  does not, if its workers are left waiting for the call that binds them:
   --  the frame that declared the pool would wait for them forever. This test
   --  hangs rather than fails when that regresses, which is the only way the
   --  condition can be observed.
   procedure Unused_Pool_Terminates
     (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
   begin
      for Team in CPU.Worker_Count range 1 .. 4 loop
         declare
            Idle : CPU.Pool (Team);
         begin
            --  Deliberately no work and no Open: this is the shape a command
            --  that fails while loading its model leaves behind.
            Assert (CPU.Worker_Total (Idle) = Team, "wrong worker count");
         end;
      end loop;

      --  A pool that is closed without ever running work must also terminate.
      declare
         Idle : CPU.Pool (3);
      begin
         CPU.Close (Idle);
         Assert (not CPU.Is_Open (Idle), "a closed pool reported itself open");
      end;
   end Unused_Pool_Terminates;

   --  Capabilities report what the backend actually implements.
   procedure Capabilities_Reported (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
      Single : constant Model_Runner.Backend.Capabilities := CPU.Describe (1);
      Many   : constant Model_Runner.Backend.Capabilities := CPU.Describe (4);
   begin
      Assert (Model_Runner.Backend.Backend_Name (Single.Kind) = "cpu",
              "wrong backend name");
      Assert (Single.Deterministic and then Many.Deterministic,
              "the backend must always be deterministic");
      Assert (not Single.Supports_Parallel,
              "one worker was reported as parallel");
      Assert (Many.Supports_Parallel, "many workers were reported as serial");
      Assert (Many.Max_Workers = CPU.Max_Workers, "wrong worker maximum");

      --  Only the formats with a decoder are advertised.
      Assert (Model_Runner.Backend.Supports (Single, G.Type_F32), "F32");
      Assert (Model_Runner.Backend.Supports (Single, G.Type_Q4_K), "Q4_K");
      Assert (Model_Runner.Backend.Supports (Single, G.Type_Q6_K), "Q6_K");
      Assert (not Model_Runner.Backend.Supports (Single, G.Type_Q2_K),
              "Q2_K is advertised but not implemented");
      Assert (not Model_Runner.Backend.Supports (Single, G.Type_BF16),
              "BF16 is advertised but not implemented");
   end Capabilities_Reported;

   ----------
   -- Name --
   ----------

   overriding function Name (T : Case_Type) return AUnit.Message_String is
      pragma Unreferenced (T);
   begin
      return AUnit.Format ("cpu backend");
   end Name;

   --------------------
   -- Register_Tests --
   --------------------

   ------------------------------------
   -- Cores_Are_Not_Above_Processors --
   ------------------------------------

   --  The default worker count follows the core count, so what that function
   --  may return is worth pinning even on a host whose answer this test
   --  cannot know.
   --
   --  It has one interesting failure: a host that describes its topology in a
   --  way the reading does not understand, which must produce the processor
   --  count rather than zero, a negative, or a number above it. Any of those
   --  would reach the pool as a worker count and either run serially without
   --  saying so or ask for more workers than the backend accepts.

   procedure Cores_Are_Not_Above_Processors
     (T2 : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T2);
      Processors : constant Positive := Model_Runner.Platform.Processor_Count;
      Cores      : constant Positive := Model_Runner.Platform.Core_Count;
   begin
      Assert (Cores <= Processors,
              "core count" & Positive'Image (Cores)
              & " is above the processor count" & Positive'Image (Processors));

      --  Repeated because it reads the host each time rather than caching,
      --  and a reading that changed between calls would make the default
      --  depend on when it was asked.
      Assert (Model_Runner.Platform.Core_Count = Cores,
              "the core count changed between two readings");
   end Cores_Are_Not_Above_Processors;

   overriding procedure Register_Tests (T : in out Case_Type) is
      use AUnit.Test_Cases.Registration;
   begin
      Register_Routine
        (T, Partition_Covers_Rows'Access,
         "the partition covers every row exactly once for every worker count");
      Register_Routine
        (T, Parallel_Matches_Serial'Access,
         "a parallel product equals the serial one exactly");
      Register_Routine
        (T, More_Workers_Than_Rows'Access,
         "more workers than rows still produces a complete result");
      Register_Routine
        (T, Closed_Pool_Rejects'Access,
         "a closed pool rejects work and closing twice is harmless");
      Register_Routine
        (T, Pool_Is_Reused'Access,
         "one pool serves many jobs without creating tasks per job");
      Register_Routine
        (T, Unused_Pool_Terminates'Access,
         "a pool that is never used still terminates");
      Register_Routine
        (T, Capabilities_Reported'Access,
         "capabilities report only what the backend implements");

      Register_Routine
        (T, Cores_Are_Not_Above_Processors'Access,
         "the core count is at least one and never above the processor "
         & "count, whatever the host reports");   end Register_Tests;

end Tests.Backend_Cases;
