+/* Offline reference fixture producer; never linked into model_runner.
+ * Uses the pinned, independently built GGML CPU library recorded in the
+ * adjacent provenance JSON. Input is the existing independent Q8 fixture.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <dlfcn.h>
+
+int main(int argc, char **argv) {
+    if (argc != 4) return 2;
+    void *lib = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+    if (!lib) { fputs(dlerror(), stderr); return 3; }
+    void (*init)(void) = (void (*)(void))dlsym(lib, "ggml_cpu_init");
+    void (*dot)(int,float *,size_t,const void *,size_t,const void *,size_t,int) =
+        (void (*)(int,float *,size_t,const void *,size_t,const void *,size_t,int))
+        dlsym(lib, "ggml_vec_dot_q8_0_q8_0");
+    if (!init || !dot) return 4;
+    init();
+    unsigned char data[1088];
+    FILE *input = fopen(argv[2], "rb");
+    if (!input || fread(data, 1, sizeof data, input) != sizeof data) return 5;
+    if (fgetc(input) != EOF || fclose(input)) return 6;
+    FILE *output = fopen(argv[3], "wb");
+    if (!output) return 7;
+    for (int row = 0; row < 2; ++row) {
+        for (int vector = 0; vector < 2; ++vector) {
+            float result;
+            dot(512, &result, 0, data + row*544, 0, data + vector*544, 0, 1);
+            if (fwrite(&result, sizeof result, 1, output) != 1) return 8;
+            printf("row%d vector%d %a\n", row, vector, (double)result);
+        }
+    }
+    if (fclose(output)) return 9;
+    dlclose(lib);
+    return 0;
+}
