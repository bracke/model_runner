--  One ownership declaration for units shared by the independently
--  consumable projects.  Consumers use these same lists both to select the
--  units they own and to exclude units owned by an imported project, so a
--  newly added framework unit cannot silently acquire two project owners.
abstract project Model_Runner_Sources is
   Core_Sources :=
     ("model_runner.ads",
      "model_runner-errors.ads",
      "model_runner-errors.adb",
      "model_runner-heap_buffers.ads",
      "model_runner-heap_buffers.adb",
      "model_runner-text.ads",
      "model_runner-text.adb");

   --  Exact source closure owned by the reusable inference project.  Keeping
   --  this positive list prevents a project with no main from compiling every
   --  CLI, agent, Code Health, and task-framework unit merely because those
   --  units share src/library.  Subunit bodies are included explicitly.
   Inference_Sources :=
     ("model_runner-arithmetic.adb",
      "model_runner-arithmetic.ads",
