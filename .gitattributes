#  Generated files are written byte for byte by the tooling and compared
#  against what the code would produce. Git converting their line endings on
#  checkout would make a Windows working tree disagree with the generator
#  about a file neither had edited, so these are pinned.
docs/error-codes.md text eol=lf
docs/spec_driven_development_framework_v3_revised.md text eol=lf

#  The message catalog is read by the program itself rather than by a text
#  editor, and its values are compared exactly.
resources/messages/catalog.txt text eol=lf

#  The synthetic model is a container of packed binary fields, and its bytes
#  are what the parser reads. Git guesses binary from the first NUL and would
#  guess right here, but a guess is a poor thing to rest a fixture on: a
#  converted byte inside a tensor would fail every test at once and none of
#  them would say why.
tests/fixtures/*.gguf binary

#  The recording is read line by line and its values compared exactly.
tests/fixtures/*.expect text eol=lf

#  The chat templates and their renderings are compared byte for byte, and a
#  template's line breaks are part of what it renders: converted on a Windows
#  checkout, the model's own template rendered a carriage return the carried
#  format does not. The prompts and the vision crossing are read the same way.
tests/fixtures/*.jinja text eol=lf
tests/fixtures/*.render text eol=lf
tests/fixtures/*.txt text eol=lf
tests/fixtures/*.vision-crossing text eol=lf
tests/fixtures/*.jpg binary
